       IDENTIFICATION DIVISION.
       PROGRAM-ID. RESPAPI.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY JSONPARM.
       COPY HTTPPARM.
       01  WS-STATE                PIC S9(9) COMP-5 VALUE 0.
           88 WS-IDLE              VALUE 0.
           88 WS-AWAITING-RESULT   VALUE 1.
       01  WS-CALL-START           PIC S9(9) COMP-5 VALUE 0.
       01  WS-CALL-LENGTH          PIC S9(9) COMP-5 VALUE 0.
       01  WS-HISTORY-LENGTH       PIC S9(9) COMP-5 VALUE 0.
       01  WS-REQUEST-LENGTH       PIC S9(9) COMP-5 VALUE 0.
       01  WS-RESPONSE-LENGTH      PIC S9(9) COMP-5 VALUE 0.
       01  WS-OUTPUT-START         PIC S9(9) COMP-5 VALUE 0.
       01  WS-APPEND-LENGTH        PIC S9(9) COMP-5 VALUE 0.
       01  WS-CURSOR               PIC S9(9) COMP-5.
       01  WS-ARRAY-CURSOR         PIC S9(9) COMP-5.
       01  WS-CONTENT-CURSOR       PIC S9(9) COMP-5.
       01  WS-VALIDATE-CURSOR      PIC S9(9) COMP-5.
       01  WS-ITEM-START           PIC S9(9) COMP-5.
       01  WS-ITEM-LENGTH          PIC S9(9) COMP-5.
       01  WS-PARENT-START         PIC S9(9) COMP-5.
       01  WS-PARENT-LENGTH        PIC S9(9) COMP-5.
       01  WS-ARRAY-END            PIC S9(9) COMP-5.
       01  WS-OLD-HISTORY          PIC S9(9) COMP-5.
       01  WS-LITERAL-LENGTH       PIC S9(9) COMP-5.
       01  WS-TOOL-COUNT           PIC S9(9) COMP-5.
       01  WS-PHASE-FINAL          PIC X.
       01  WS-PHASE-PRESENT        PIC X.
       01  WS-HAS-FINAL-PHASE      PIC X.
       01  WS-FINAL-OVERFLOW       PIC X.
       01  WS-FINAL-COUNT          PIC S9(9) COMP-5.
       01  WS-FAIL                 PIC X.
       01  WS-TEXT-KIND            PIC X.
           88 WS-SUMMARY-TEXT      VALUE X'53'.
           88 WS-REASONING-TEXT    VALUE X'52'.
       01  WS-OBJECT-ONLY          PIC X.
       01  WS-DECODE               PIC X(1048832).
       01  WS-DECODE-LENGTH        PIC S9(9) COMP-5.
       01  WS-DECODE-CAPACITY      PIC S9(9) COMP-5.
       01  WS-COMMAND              PIC X(65535).
       01  WS-COMMAND-LENGTH       PIC S9(9) COMP-5.
       01  WS-FINAL                PIC X(1048576).
       01  WS-FINAL-LENGTH         PIC S9(9) COMP-5.
       01  WS-LITERAL              PIC X(1024).
       01  WS-HISTORY              PIC X(16777216).
       01  WS-REQUEST              PIC X(16777216).
       01  WS-RESPONSE             PIC X(8388608).
       01  WS-ITEM-INDEX           PIC S9(9) COMP-5.
       01  WS-CALL-RESP-START      PIC S9(9) COMP-5.
       01  WS-CALL-RESP-LENGTH     PIC S9(9) COMP-5.

       LINKAGE SECTION.
       COPY RESPPARM.
       01  MODEL-AREA.
           05 MODEL-BYTE PIC X OCCURS 256 TIMES.
       01  URL-AREA.
           05 URL-BYTE PIC X OCCURS 2048 TIMES.
       01  KEY-AREA.
           05 KEY-BYTE PIC X OCCURS 8192 TIMES.
       01  TASK-AREA.
           05 TASK-BYTE PIC X OCCURS 65535 TIMES.
       01  SHELL-AREA.
           05 SHELL-BYTE PIC X OCCURS 1048576 TIMES.
       01  ACTION-AREA.
           05 ACTION-BYTE PIC X OCCURS 1048576 TIMES.

       PROCEDURE DIVISION USING RESP-PARM.
       MAIN.
           PERFORM RESET-RESULTS
           EVALUATE RP-OPERATION
               WHEN RESP-START
                   PERFORM VALIDATE-START
                   IF WS-FAIL = FLAG-ON GOBACK END-IF
                   PERFORM START-REQUEST
               WHEN RESP-CONTINUE
                   PERFORM VALIDATE-CONTINUE
                   IF WS-FAIL = FLAG-ON GOBACK END-IF
                   PERFORM CONTINUE-REQUEST
               WHEN RESP-DESTROY
                   PERFORM VALIDATE-DESTROY
                   IF WS-FAIL = FLAG-ON GOBACK END-IF
                   PERFORM DESTROY-STATE
               WHEN OTHER
                   PERFORM FAIL-INTERNAL
           END-EVALUATE
           GOBACK.

       RESET-RESULTS.
           MOVE STATUS-OK TO RP-STATUS
           MOVE ACTION-NONE TO RP-ACTION
           MOVE 0 TO RP-ACTION-LENGTH RP-HTTP-STATUS
           MOVE CATEGORY-NONE TO RP-ERROR-CATEGORY
           MOVE FLAG-OFF TO WS-FAIL.

       VALIDATE-COMMON.
           IF RP-MODEL-PTR = NULL
             OR RP-MODEL-LENGTH < 1
             OR RP-MODEL-LENGTH > LIMIT-MODEL
             OR RP-URL-PTR = NULL
             OR RP-URL-LENGTH < 1
             OR RP-URL-LENGTH > LIMIT-URL
             OR RP-KEY-PTR = NULL
             OR RP-KEY-LENGTH < 0
             OR RP-KEY-LENGTH > LIMIT-KEY
             OR RP-ACTION-PTR = NULL
             OR RP-ACTION-CAPACITY < 0
             OR RP-ACTION-CAPACITY > LIMIT-FINAL
               PERFORM FAIL-INTERNAL
           END-IF.

       VALIDATE-START.
           PERFORM VALIDATE-COMMON
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           IF RP-TASK-PTR = NULL
             OR RP-TASK-LENGTH < 0
             OR RP-TASK-LENGTH > LIMIT-TASK
             OR RP-SHELL-OUTPUT-PTR NOT = NULL
             OR RP-SHELL-OUTPUT-LENGTH NOT = 0
               PERFORM FAIL-INTERNAL
           END-IF.

       VALIDATE-CONTINUE.
           PERFORM VALIDATE-COMMON
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           IF RP-TASK-PTR NOT = NULL
             OR RP-TASK-LENGTH NOT = 0
             OR RP-SHELL-OUTPUT-LENGTH < 0
             OR RP-SHELL-OUTPUT-LENGTH > LIMIT-SHELL-OUTPUT
             OR (RP-SHELL-OUTPUT-LENGTH > 0
                 AND RP-SHELL-OUTPUT-PTR = NULL)
             OR (RP-SHELL-TRUNCATED NOT = FLAG-OFF
                 AND RP-SHELL-TRUNCATED NOT = FLAG-ON)
             OR (RP-SHELL-ENCODING-LOSS NOT = FLAG-OFF
                 AND RP-SHELL-ENCODING-LOSS NOT = FLAG-ON)
               PERFORM FAIL-INTERNAL
               EXIT PARAGRAPH
           END-IF
           EVALUATE RP-SHELL-STATUS
               WHEN SHELL-EXIT
                   IF RP-SHELL-EXIT < 0 OR RP-SHELL-EXIT > 255
                     OR RP-SHELL-SIGNAL NOT = 0
                       PERFORM FAIL-INTERNAL
                   END-IF
               WHEN SHELL-SIGNAL
                   IF RP-SHELL-EXIT NOT = 0
                     OR RP-SHELL-SIGNAL < 1
                     OR RP-SHELL-SIGNAL > 127
                       PERFORM FAIL-INTERNAL
                   END-IF
               WHEN SHELL-COMMAND-ENCODING
                   IF RP-SHELL-EXIT NOT = 0
                     OR RP-SHELL-SIGNAL NOT = 0
                     OR RP-SHELL-TRUNCATED NOT = FLAG-OFF
                     OR RP-SHELL-ENCODING-LOSS NOT = FLAG-OFF
                     OR RP-SHELL-OUTPUT-PTR NOT = NULL
                     OR RP-SHELL-OUTPUT-LENGTH NOT = 0
                       PERFORM FAIL-INTERNAL
                   END-IF
               WHEN OTHER
                   PERFORM FAIL-INTERNAL
           END-EVALUATE.

       VALIDATE-DESTROY.
           IF RP-MODEL-PTR NOT = NULL
             OR RP-MODEL-LENGTH NOT = 0
             OR RP-URL-PTR NOT = NULL
             OR RP-URL-LENGTH NOT = 0
             OR RP-KEY-PTR NOT = NULL
             OR RP-KEY-LENGTH NOT = 0
             OR RP-TASK-PTR NOT = NULL
             OR RP-TASK-LENGTH NOT = 0
             OR RP-SHELL-OUTPUT-PTR NOT = NULL
             OR RP-SHELL-OUTPUT-LENGTH NOT = 0
             OR RP-ACTION-PTR NOT = NULL
             OR RP-ACTION-CAPACITY NOT = 0
               PERFORM FAIL-INTERNAL
           END-IF.

       START-REQUEST.
           IF NOT WS-IDLE
               PERFORM FAIL-INTERNAL
               EXIT PARAGRAPH
           END-IF
           MOVE 0 TO WS-HISTORY-LENGTH WS-CALL-START
                     WS-CALL-LENGTH
           SET ADDRESS OF TASK-AREA TO RP-TASK-PTR
       MOVE X'7B22726F6C65223A2275736572222C22636F6E74656E74223A22'
             TO WS-LITERAL(1:26)
           MOVE 26 TO WS-LITERAL-LENGTH
           PERFORM APPEND-HISTORY-LITERAL
           INITIALIZE JSON-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           SET JP-INPUT-PTR TO RP-TASK-PTR
           MOVE RP-TASK-LENGTH TO JP-INPUT-LENGTH
           MOVE 1 TO JP-CURSOR
           SET JP-OUTPUT-PTR TO ADDRESS OF WS-HISTORY
           SET JP-OUTPUT-PTR UP BY WS-HISTORY-LENGTH
           COMPUTE JP-OUTPUT-CAPACITY =
               LIMIT-HISTORY - WS-HISTORY-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
               PERFORM MAP-JSON-FAILURE
               EXIT PARAGRAPH
           END-IF
           ADD JP-OUTPUT-LENGTH TO WS-HISTORY-LENGTH
       MOVE X'227D' TO WS-LITERAL(1:2)
           MOVE 2 TO WS-LITERAL-LENGTH
           PERFORM APPEND-HISTORY-LITERAL
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           PERFORM SEND-REQUEST.

       CONTINUE-REQUEST.
           IF NOT WS-AWAITING-RESULT
               PERFORM FAIL-INTERNAL
               EXIT PARAGRAPH
           END-IF
           IF WS-CALL-START < 1 OR WS-CALL-LENGTH < 2
               PERFORM FAIL-INTERNAL
               EXIT PARAGRAPH
           END-IF
           IF WS-CALL-START > WS-HISTORY-LENGTH
             OR WS-CALL-LENGTH >
                 WS-HISTORY-LENGTH - WS-CALL-START + 1
               PERFORM FAIL-INTERNAL
               EXIT PARAGRAPH
           END-IF
           MOVE WS-HISTORY-LENGTH TO WS-OLD-HISTORY
           IF WS-HISTORY-LENGTH > 0
       MOVE X'2C' TO WS-LITERAL(1:1)
               MOVE 1 TO WS-LITERAL-LENGTH
               PERFORM APPEND-HISTORY-LITERAL
               IF WS-FAIL = FLAG-ON
                   PERFORM ROLLBACK-HISTORY
                   EXIT PARAGRAPH
               END-IF
           END-IF
       MOVE X'7B2274797065223A22637573746F6D5F746F6F6C5F63616C6C5F'
             TO WS-LITERAL(1:26)
       MOVE X'6F7574707574222C2263616C6C5F6964223A'
             TO WS-LITERAL(27:18)
           MOVE 44 TO WS-LITERAL-LENGTH
           PERFORM APPEND-HISTORY-LITERAL
           IF WS-FAIL = FLAG-ON
               PERFORM ROLLBACK-HISTORY
               EXIT PARAGRAPH
           END-IF
           PERFORM APPEND-CALL-ID
           IF WS-FAIL = FLAG-ON
               PERFORM ROLLBACK-HISTORY
               EXIT PARAGRAPH
           END-IF
       MOVE X'2C226F7574707574223A22' TO WS-LITERAL(1:11)
           MOVE 11 TO WS-LITERAL-LENGTH
           PERFORM APPEND-HISTORY-LITERAL
           IF WS-FAIL = FLAG-ON
               PERFORM ROLLBACK-HISTORY
               EXIT PARAGRAPH
           END-IF
           PERFORM BUILD-TOOL-ENVELOPE
           IF WS-FAIL = FLAG-ON
               PERFORM ROLLBACK-HISTORY
               EXIT PARAGRAPH
           END-IF
       MOVE X'227D' TO WS-LITERAL(1:2)
           MOVE 2 TO WS-LITERAL-LENGTH
           PERFORM APPEND-HISTORY-LITERAL
           IF WS-FAIL = FLAG-ON
               PERFORM ROLLBACK-HISTORY
               EXIT PARAGRAPH
           END-IF
           MOVE WS-HISTORY-LENGTH TO WS-OLD-HISTORY
           SET WS-IDLE TO TRUE
           MOVE 0 TO WS-CALL-START WS-CALL-LENGTH
           PERFORM SEND-REQUEST.

       APPEND-CALL-ID.
           IF WS-HISTORY-LENGTH >
               LIMIT-HISTORY - WS-CALL-LENGTH
               PERFORM FAIL-CAPACITY
               EXIT PARAGRAPH
           END-IF
           MOVE WS-HISTORY(WS-CALL-START:WS-CALL-LENGTH)
             TO WS-HISTORY(WS-HISTORY-LENGTH + 1:WS-CALL-LENGTH)
           ADD WS-CALL-LENGTH TO WS-HISTORY-LENGTH.

       BUILD-TOOL-ENVELOPE.
           MOVE SPACES TO WS-DECODE
           MOVE 0 TO WS-DECODE-LENGTH
           EVALUATE RP-SHELL-STATUS
               WHEN SHELL-EXIT
       MOVE X'7374617475733D657869740A657869745F636F64653D'
                     TO WS-DECODE(1:22)
                   MOVE 22 TO WS-DECODE-LENGTH
                   MOVE RP-SHELL-EXIT TO WS-CURSOR
                   PERFORM APPEND-DECIMAL
               WHEN SHELL-SIGNAL
       MOVE X'7374617475733D7369676E616C0A657869745F636F64653D6E6F'
             TO WS-DECODE(1:26)
       MOVE X'6E650A7369676E616C3D' TO WS-DECODE(27:10)
                   MOVE 36 TO WS-DECODE-LENGTH
                   MOVE RP-SHELL-SIGNAL TO WS-CURSOR
                   PERFORM APPEND-DECIMAL
               WHEN SHELL-COMMAND-ENCODING
       MOVE X'7374617475733D636F6D6D616E642D656E636F64696E672D6572'
             TO WS-DECODE(1:26)
       MOVE X'726F720A657869745F636F64653D6E6F6E650A7369676E616C3D'
             TO WS-DECODE(27:26)
       MOVE X'6E6F6E65' TO WS-DECODE(53:4)
                   MOVE 56 TO WS-DECODE-LENGTH
               WHEN OTHER
                   PERFORM FAIL-INTERNAL
                   EXIT PARAGRAPH
           END-EVALUATE
           IF RP-SHELL-STATUS = SHELL-EXIT
       MOVE X'0A7369676E616C3D6E6F6E65'
                 TO WS-DECODE(WS-DECODE-LENGTH + 1:12)
               ADD 12 TO WS-DECODE-LENGTH
           ELSE
               IF RP-SHELL-STATUS = SHELL-SIGNAL
                   CONTINUE
               END-IF
           END-IF
       MOVE X'0A7472756E63617465643D' TO WS-LITERAL(1:11)
           PERFORM APPEND-ENVELOPE-LITERAL
           IF RP-SHELL-TRUNCATED = FLAG-ON
       MOVE X'74727565' TO WS-LITERAL(1:4)
               MOVE 4 TO WS-LITERAL-LENGTH
           ELSE
       MOVE X'66616C7365' TO WS-LITERAL(1:5)
               MOVE 5 TO WS-LITERAL-LENGTH
           END-IF
           PERFORM APPEND-ENVELOPE-LITERAL
       MOVE X'0A656E636F64696E675F6C6F73733D'
             TO WS-LITERAL(1:15)
           MOVE 15 TO WS-LITERAL-LENGTH
           PERFORM APPEND-ENVELOPE-LITERAL
           IF RP-SHELL-ENCODING-LOSS = FLAG-ON
       MOVE X'74727565' TO WS-LITERAL(1:4)
               MOVE 4 TO WS-LITERAL-LENGTH
           ELSE
       MOVE X'66616C7365' TO WS-LITERAL(1:5)
               MOVE 5 TO WS-LITERAL-LENGTH
           END-IF
           PERFORM APPEND-ENVELOPE-LITERAL
       MOVE X'0A6F75747075743A0A' TO WS-LITERAL(1:9)
           MOVE 9 TO WS-LITERAL-LENGTH
           PERFORM APPEND-ENVELOPE-LITERAL
           IF RP-SHELL-OUTPUT-LENGTH > 0
               SET ADDRESS OF SHELL-AREA TO RP-SHELL-OUTPUT-PTR
               IF WS-DECODE-LENGTH >
                   LIMIT-TOOL-RESULT - RP-SHELL-OUTPUT-LENGTH
                   PERFORM FAIL-CAPACITY
                   EXIT PARAGRAPH
               END-IF
               MOVE SHELL-AREA(1:RP-SHELL-OUTPUT-LENGTH)
                 TO WS-DECODE(WS-DECODE-LENGTH + 1:
                              RP-SHELL-OUTPUT-LENGTH)
               ADD RP-SHELL-OUTPUT-LENGTH TO WS-DECODE-LENGTH
           END-IF
           INITIALIZE JSON-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           SET JP-INPUT-PTR TO ADDRESS OF WS-DECODE
           MOVE WS-DECODE-LENGTH TO JP-INPUT-LENGTH
           MOVE 1 TO JP-CURSOR
           SET JP-OUTPUT-PTR TO ADDRESS OF WS-HISTORY
           SET JP-OUTPUT-PTR UP BY WS-HISTORY-LENGTH
           COMPUTE JP-OUTPUT-CAPACITY =
               LIMIT-HISTORY - WS-HISTORY-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
               PERFORM MAP-JSON-FAILURE
           ELSE
               ADD JP-OUTPUT-LENGTH TO WS-HISTORY-LENGTH
           END-IF.

       APPEND-DECIMAL.
           IF WS-CURSOR < 0
               PERFORM FAIL-INTERNAL
               EXIT PARAGRAPH
           END-IF
           IF WS-CURSOR >= 100
               COMPUTE WS-ITEM-INDEX = WS-CURSOR / 100
               PERFORM APPEND-DIGIT
               COMPUTE WS-CURSOR = FUNCTION MOD(WS-CURSOR, 100)
           END-IF
           IF WS-CURSOR >= 10
               COMPUTE WS-ITEM-INDEX = WS-CURSOR / 10
               PERFORM APPEND-DIGIT
               COMPUTE WS-CURSOR = FUNCTION MOD(WS-CURSOR, 10)
           END-IF
           MOVE WS-CURSOR TO WS-ITEM-INDEX
           PERFORM APPEND-DIGIT.

       APPEND-DIGIT.
           IF WS-DECODE-LENGTH >= LIMIT-TOOL-RESULT
               PERFORM FAIL-CAPACITY
           ELSE
               ADD 1 TO WS-DECODE-LENGTH
               COMPUTE WS-ITEM-INDEX = WS-ITEM-INDEX + 49
               MOVE FUNCTION CHAR(WS-ITEM-INDEX)
                 TO WS-DECODE(WS-DECODE-LENGTH:1)
           END-IF.

       APPEND-ENVELOPE-LITERAL.
           IF WS-DECODE-LENGTH >
               LIMIT-TOOL-RESULT - WS-LITERAL-LENGTH
               PERFORM FAIL-CAPACITY
           ELSE
               MOVE WS-LITERAL(1:WS-LITERAL-LENGTH)
                 TO WS-DECODE(WS-DECODE-LENGTH + 1:
                              WS-LITERAL-LENGTH)
               ADD WS-LITERAL-LENGTH TO WS-DECODE-LENGTH
           END-IF.

       SEND-REQUEST.
           PERFORM BUILD-REQUEST
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           INITIALIZE HTTP-PARM
           MOVE HTTP-POST TO HP-OPERATION
           SET HP-URL-PTR TO RP-URL-PTR
           MOVE RP-URL-LENGTH TO HP-URL-LENGTH
           SET HP-KEY-PTR TO RP-KEY-PTR
           MOVE RP-KEY-LENGTH TO HP-KEY-LENGTH
           SET HP-BODY-PTR TO ADDRESS OF WS-REQUEST
           MOVE WS-REQUEST-LENGTH TO HP-BODY-LENGTH
           SET HP-RESPONSE-PTR TO ADDRESS OF WS-RESPONSE
           MOVE LIMIT-RESPONSE TO HP-RESPONSE-CAPACITY
           CALL "HTTP11" USING HTTP-PARM
           SET HP-KEY-PTR TO NULL
           MOVE 0 TO HP-KEY-LENGTH
           IF HP-STATUS NOT = STATUS-OK
               PERFORM MAP-HTTP-FAILURE
               EXIT PARAGRAPH
           END-IF
           MOVE HP-RESPONSE-LENGTH TO WS-RESPONSE-LENGTH
           PERFORM EVALUATE-RESPONSE.

       BUILD-REQUEST.
           MOVE 0 TO WS-REQUEST-LENGTH
       MOVE X'7B226D6F64656C223A22' TO WS-LITERAL(1:10)
           MOVE 10 TO WS-LITERAL-LENGTH
           PERFORM APPEND-REQUEST-LITERAL
           PERFORM APPEND-ESCAPED-MODEL
       MOVE X'222C22696E737472756374696F6E73223A22'
             TO WS-LITERAL(1:18)
           MOVE 18 TO WS-LITERAL-LENGTH
           PERFORM APPEND-REQUEST-LITERAL
           PERFORM APPEND-INSTRUCTIONS
       MOVE X'222C2273746F7265223A66616C73652C22706172616C6C656C5F'
             TO WS-LITERAL(1:26)
       MOVE X'746F6F6C5F63616C6C73223A66616C73652C22696E636C756465'
             TO WS-LITERAL(27:26)
       MOVE X'223A5B22726561736F6E696E672E656E637279707465645F636F6E'
             TO WS-LITERAL(53:27)
       MOVE X'74656E74225D2C22746F6F6C73223A5B7B2274797065223A226375'
             TO WS-LITERAL(80:27)
       MOVE X'73746F6D222C226E616D65223A227368656C6C222C226465736372'
             TO WS-LITERAL(107:27)
       MOVE X'697074696F6E223A22' TO WS-LITERAL(134:9)
           MOVE 142 TO WS-LITERAL-LENGTH
           PERFORM APPEND-REQUEST-LITERAL
           PERFORM APPEND-DESCRIPTION
       MOVE X'227D5D2C22696E707574223A5B' TO WS-LITERAL(1:13)
           MOVE 13 TO WS-LITERAL-LENGTH
           PERFORM APPEND-REQUEST-LITERAL
           PERFORM APPEND-HISTORY-TO-REQUEST
       MOVE X'5D7D' TO WS-LITERAL(1:2)
           MOVE 2 TO WS-LITERAL-LENGTH
           PERFORM APPEND-REQUEST-LITERAL.

       APPEND-ESCAPED-MODEL.
           INITIALIZE JSON-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           SET JP-INPUT-PTR TO RP-MODEL-PTR
           MOVE RP-MODEL-LENGTH TO JP-INPUT-LENGTH
           MOVE 1 TO JP-CURSOR
           SET JP-OUTPUT-PTR TO ADDRESS OF WS-REQUEST
           SET JP-OUTPUT-PTR UP BY WS-REQUEST-LENGTH
           COMPUTE JP-OUTPUT-CAPACITY =
               LIMIT-REQUEST - WS-REQUEST-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
               PERFORM MAP-JSON-FAILURE
           ELSE
               ADD JP-OUTPUT-LENGTH TO WS-REQUEST-LENGTH
           END-IF.

       APPEND-INSTRUCTIONS.
      * Do not ask for permission before using the shell.
       MOVE X'596F7520617265206120636F64696E67206167656E7420776F72'
             TO WS-LITERAL(1:26)
       MOVE X'6B696E67206F6E2074686520757365722773207461736B20696E20'
             TO WS-LITERAL(27:27)
       MOVE X'7468652063757272656E74206469726563746F72792E2055736520'
             TO WS-LITERAL(54:27)
       MOVE X'746865207368656C6C20746F6F6C20746F20696E73706563742061'
             TO WS-LITERAL(81:27)
       MOVE X'6E64206D6F646966792066696C657320616E642072756E20636865'
             TO WS-LITERAL(108:27)
       MOVE X'636B732E20436F6E74696E756520756E74696C2074686520746173'
             TO WS-LITERAL(135:27)
       MOVE X'6B20697320636F6D706C657465206F7220796F752063616E6E6F74'
             TO WS-LITERAL(162:27)
       MOVE X'206D616B6520667572746865722070726F67726573732E20446F20'
             TO WS-LITERAL(189:27)
       MOVE X'6E6F742061736B20666F72207065726D697373696F6E206265666F'
             TO WS-LITERAL(216:27)
       MOVE X'7265207573696E6720746865207368656C6C2E205768656E206669'
             TO WS-LITERAL(243:27)
       MOVE X'6E69736865642C2072657475726E206120636F6E63697365207375'
             TO WS-LITERAL(270:27)
       MOVE X'6D6D61727920616E642074686520636865636B732072756E2E'
             TO WS-LITERAL(297:25)
           MOVE 321 TO WS-LITERAL-LENGTH
           PERFORM APPEND-REQUEST-LITERAL.

       APPEND-DESCRIPTION.
      * The process is unsandboxed and has the COBOLLM process user's
      * permissions.
       MOVE X'52756E2061202F62696E2F73682073637269707420696E20746865'
             TO WS-LITERAL(1:27)
       MOVE X'2063757272656E7420776F726B696E67206469726563746F72792E'
             TO WS-LITERAL(28:27)
       MOVE X'205468652070726F6365737320697320756E73616E64626F786564'
             TO WS-LITERAL(55:27)
       MOVE X'20616E64206861732074686520434F424F4C4C4D2070726F636573'
             TO WS-LITERAL(82:27)
       MOVE X'7320757365722773207065726D697373696F6E732E205374616E64'
             TO WS-LITERAL(109:27)
       MOVE X'617264206572726F72206973206D657267656420696E746F207374'
             TO WS-LITERAL(136:27)
       MOVE X'616E64617264206F75747075742E20456163682063616C6C207374'
             TO WS-LITERAL(163:27)
       MOVE X'617274732061206672657368207368656C6C2E'
             TO WS-LITERAL(190:19)
           MOVE 208 TO WS-LITERAL-LENGTH
           PERFORM APPEND-REQUEST-LITERAL.

       APPEND-HISTORY-TO-REQUEST.
           IF WS-REQUEST-LENGTH >
               LIMIT-HISTORY - WS-HISTORY-LENGTH
               PERFORM FAIL-CAPACITY
           ELSE
               MOVE WS-HISTORY(1:WS-HISTORY-LENGTH)
                 TO WS-REQUEST(WS-REQUEST-LENGTH + 1:
                               WS-HISTORY-LENGTH)
               ADD WS-HISTORY-LENGTH TO WS-REQUEST-LENGTH
           END-IF.

       APPEND-REQUEST-LITERAL.
           IF WS-REQUEST-LENGTH >
               LIMIT-HISTORY - WS-LITERAL-LENGTH
               PERFORM FAIL-CAPACITY
           ELSE
               MOVE WS-LITERAL(1:WS-LITERAL-LENGTH)
                 TO WS-REQUEST(WS-REQUEST-LENGTH + 1:
                               WS-LITERAL-LENGTH)
               ADD WS-LITERAL-LENGTH TO WS-REQUEST-LENGTH
           END-IF.

       APPEND-HISTORY-LITERAL.
           IF WS-HISTORY-LENGTH >
               LIMIT-HISTORY - WS-LITERAL-LENGTH
               PERFORM FAIL-CAPACITY
           ELSE
               MOVE WS-LITERAL(1:WS-LITERAL-LENGTH)
                 TO WS-HISTORY(WS-HISTORY-LENGTH + 1:
                               WS-LITERAL-LENGTH)
               ADD WS-LITERAL-LENGTH TO WS-HISTORY-LENGTH
           END-IF.

       EVALUATE-RESPONSE.
           MOVE FLAG-OFF TO WS-FAIL
           INITIALIZE JSON-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           SET JP-INPUT-PTR TO ADDRESS OF WS-RESPONSE
           MOVE WS-RESPONSE-LENGTH TO JP-INPUT-LENGTH
           MOVE 1 TO JP-CURSOR
           CALL "JSONSCAN" USING JSON-PARM
           COMPUTE WS-ITEM-LENGTH = WS-RESPONSE-LENGTH + 1
           MOVE 1 TO WS-ITEM-START
           PERFORM UNTIL WS-ITEM-START > WS-RESPONSE-LENGTH
             OR (WS-RESPONSE(WS-ITEM-START:1) NOT = X'20'
             AND WS-RESPONSE(WS-ITEM-START:1) NOT = X'09'
             AND WS-RESPONSE(WS-ITEM-START:1) NOT = X'0A'
             AND WS-RESPONSE(WS-ITEM-START:1) NOT = X'0D')
               ADD 1 TO WS-ITEM-START
           END-PERFORM
           IF JP-STATUS NOT = STATUS-OK
               IF JP-STATUS = STATUS-JSON
                   PERFORM FAIL-JSON
               ELSE
                   PERFORM FAIL-PROTOCOL
               END-IF
               EXIT PARAGRAPH
           END-IF
           IF JP-NEXT-CURSOR NOT = WS-ITEM-LENGTH
             OR WS-RESPONSE-LENGTH < 2
             OR WS-ITEM-START > WS-RESPONSE-LENGTH
             OR WS-RESPONSE(WS-ITEM-START:1) NOT = X'7B'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
       MOVE X'737461747573' TO WS-LITERAL(1:6)
           MOVE 6 TO WS-LITERAL-LENGTH
           PERFORM FIND-RESPONSE-MEMBER
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-FOUND
           IF WS-DECODE-LENGTH NOT = 9
             OR WS-DECODE(1:9) NOT = X'636F6D706C65746564'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
       MOVE X'6572726F72' TO WS-LITERAL(1:5)
           MOVE 5 TO WS-LITERAL-LENGTH
           PERFORM FIND-RESPONSE-MEMBER
           IF JP-STATUS NOT = STATUS-OK
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           IF JP-FOUND = FLAG-ON
               IF JP-SPAN-LENGTH NOT = 4
                 OR WS-RESPONSE(JP-SPAN-START:4)
                    NOT = X'6E756C6C'
                   PERFORM FAIL-PROTOCOL
                   EXIT PARAGRAPH
               END-IF
           END-IF
       MOVE X'6F7574707574' TO WS-LITERAL(1:6)
           MOVE 6 TO WS-LITERAL-LENGTH
           PERFORM FIND-RESPONSE-MEMBER
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           IF WS-RESPONSE(JP-SPAN-START:1) NOT = X'5B'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           MOVE JP-SPAN-START TO WS-OUTPUT-START WS-ARRAY-CURSOR
           MOVE 0 TO WS-APPEND-LENGTH WS-TOOL-COUNT
                     WS-COMMAND-LENGTH WS-FINAL-LENGTH
                     WS-FINAL-COUNT
           MOVE FLAG-OFF TO WS-HAS-FINAL-PHASE WS-FINAL-OVERFLOW
           PERFORM UNTIL WS-FAIL = FLAG-ON
               INITIALIZE JSON-PARM
               MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
               SET JP-INPUT-PTR TO ADDRESS OF WS-RESPONSE
               MOVE WS-RESPONSE-LENGTH TO JP-INPUT-LENGTH
               MOVE WS-ARRAY-CURSOR TO JP-CURSOR
               CALL "JSONSCAN" USING JSON-PARM
               IF JP-STATUS NOT = STATUS-OK
                   PERFORM FAIL-PROTOCOL
                   EXIT PERFORM
               END-IF
               MOVE JP-NEXT-CURSOR TO WS-ARRAY-CURSOR
               IF JP-END = FLAG-ON EXIT PERFORM END-IF
               IF WS-HISTORY-LENGTH > 0 OR WS-APPEND-LENGTH > 0
                   IF WS-APPEND-LENGTH >= LIMIT-HISTORY
                       PERFORM FAIL-CAPACITY
                       EXIT PERFORM
                   END-IF
                   ADD 1 TO WS-APPEND-LENGTH
               END-IF
               IF WS-APPEND-LENGTH >
                   LIMIT-HISTORY - JP-SPAN-LENGTH
                   PERFORM FAIL-CAPACITY
                   EXIT PERFORM
               END-IF
               ADD JP-SPAN-LENGTH TO WS-APPEND-LENGTH
               IF WS-HISTORY-LENGTH >
                   LIMIT-HISTORY - WS-APPEND-LENGTH
                   PERFORM FAIL-CAPACITY
                   EXIT PERFORM
               END-IF
               MOVE JP-SPAN-START TO WS-ITEM-START
               MOVE JP-SPAN-LENGTH TO WS-ITEM-LENGTH
               PERFORM VALIDATE-ITEM
           END-PERFORM
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           IF WS-TOOL-COUNT > 1
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           IF WS-FINAL-OVERFLOW = FLAG-ON
             AND WS-TOOL-COUNT = 0
               PERFORM FAIL-CAPACITY
               EXIT PARAGRAPH
           END-IF
           IF WS-TOOL-COUNT = 1
               IF RP-ACTION-PTR = NULL
                 OR RP-ACTION-CAPACITY < WS-COMMAND-LENGTH
                   PERFORM FAIL-CAPACITY
                   EXIT PARAGRAPH
               END-IF
           ELSE
               IF WS-FINAL-COUNT = 0
                   PERFORM FAIL-PROTOCOL
                   EXIT PARAGRAPH
               END-IF
               MOVE WS-FINAL-LENGTH TO WS-DECODE-LENGTH
               MOVE WS-FINAL TO WS-DECODE
               IF RP-ACTION-PTR = NULL
                 OR RP-ACTION-CAPACITY < WS-DECODE-LENGTH
                   PERFORM FAIL-CAPACITY
                   EXIT PARAGRAPH
               END-IF
           END-IF
           PERFORM COMMIT-ITEMS
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           IF WS-TOOL-COUNT = 1
               SET WS-AWAITING-RESULT TO TRUE
               SET ADDRESS OF ACTION-AREA TO RP-ACTION-PTR
               MOVE WS-COMMAND(1:WS-COMMAND-LENGTH)
                 TO ACTION-AREA(1:WS-COMMAND-LENGTH)
               MOVE WS-COMMAND-LENGTH TO RP-ACTION-LENGTH
               MOVE ACTION-SHELL TO RP-ACTION
           ELSE
               SET ADDRESS OF ACTION-AREA TO RP-ACTION-PTR
               MOVE WS-DECODE(1:WS-DECODE-LENGTH)
                 TO ACTION-AREA(1:WS-DECODE-LENGTH)
               MOVE WS-DECODE-LENGTH TO RP-ACTION-LENGTH
               MOVE ACTION-FINAL TO RP-ACTION
               SET WS-IDLE TO TRUE
               MOVE 0 TO WS-CALL-START WS-CALL-LENGTH
           END-IF.

       VALIDATE-ITEM.
       MOVE X'74797065' TO WS-LITERAL(1:4)
           MOVE 4 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-FOUND
           EVALUATE TRUE
               WHEN WS-DECODE-LENGTH = 16
                AND WS-DECODE(1:16) =
                    X'637573746F6D5F746F6F6C5F63616C6C'
                   PERFORM VALIDATE-TOOL
               WHEN WS-DECODE-LENGTH = 7
                AND WS-DECODE(1:7) = X'6D657373616765'
                   PERFORM VALIDATE-MESSAGE
               WHEN WS-DECODE-LENGTH = 9
                AND WS-DECODE(1:9) = X'726561736F6E696E67'
                   PERFORM VALIDATE-REASONING
               WHEN OTHER
                   PERFORM FAIL-PROTOCOL
           END-EVALUATE.

       VALIDATE-REASONING.
           MOVE X'6964' TO WS-LITERAL(1:2)
           MOVE 2 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM VALIDATE-FOUND-STRING
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           MOVE X'73756D6D617279' TO WS-LITERAL(1:7)
           MOVE 7 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           IF WS-RESPONSE(JP-SPAN-START:1) NOT = X'5B'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           SET WS-SUMMARY-TEXT TO TRUE
           MOVE FLAG-OFF TO WS-OBJECT-ONLY
           PERFORM VALIDATE-TEXT-ARRAY
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           MOVE X'636F6E74656E74' TO WS-LITERAL(1:7)
           MOVE 7 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND = FLAG-ON
               IF WS-RESPONSE(JP-SPAN-START:1) NOT = X'5B'
                   PERFORM FAIL-PROTOCOL
                   EXIT PARAGRAPH
               END-IF
               SET WS-REASONING-TEXT TO TRUE
               MOVE FLAG-OFF TO WS-OBJECT-ONLY
               PERFORM VALIDATE-TEXT-ARRAY
               IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           END-IF
           MOVE X'656E637279707465645F636F6E74656E74'
             TO WS-LITERAL(1:17)
           MOVE 17 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND = FLAG-ON
               PERFORM VALIDATE-FOUND-STRING
               IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           END-IF
           MOVE X'737461747573' TO WS-LITERAL(1:6)
           MOVE 6 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND = FLAG-ON
               PERFORM DECODE-FOUND
               IF JP-STATUS NOT = STATUS-OK
                 OR WS-DECODE-LENGTH NOT = 9
                 OR WS-DECODE(1:9) NOT = X'636F6D706C65746564'
                   PERFORM FAIL-PROTOCOL
               END-IF
           END-IF.

       VALIDATE-TOOL.
           ADD 1 TO WS-TOOL-COUNT
           MOVE X'6964' TO WS-LITERAL(1:2)
           MOVE 2 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND = FLAG-ON
               PERFORM VALIDATE-FOUND-STRING
               IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           END-IF
           MOVE X'737461747573' TO WS-LITERAL(1:6)
           MOVE 6 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND = FLAG-ON
               PERFORM DECODE-FOUND
               IF JP-STATUS NOT = STATUS-OK
                 OR WS-DECODE-LENGTH NOT = 9
                 OR WS-DECODE(1:9) NOT = X'636F6D706C65746564'
                   PERFORM FAIL-PROTOCOL
                   EXIT PARAGRAPH
               END-IF
           END-IF
           MOVE X'6173796E63' TO WS-LITERAL(1:5)
           MOVE 5 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND = FLAG-ON
               IF JP-SPAN-LENGTH NOT = 5
                 OR WS-RESPONSE(JP-SPAN-START:5)
                    NOT = X'66616C7365'
                   PERFORM FAIL-PROTOCOL
                   EXIT PARAGRAPH
               END-IF
           END-IF
           MOVE X'6E616D65' TO WS-LITERAL(1:4)
           MOVE 4 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-FOUND
           IF WS-DECODE-LENGTH NOT = 5
             OR WS-DECODE(1:5) NOT = X'7368656C6C'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
       MOVE X'63616C6C5F6964' TO WS-LITERAL(1:7)
           MOVE 7 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           MOVE JP-SPAN-START TO WS-CALL-RESP-START
           MOVE JP-SPAN-LENGTH TO WS-CALL-RESP-LENGTH
           IF JP-SPAN-LENGTH < 2 OR
              JP-SPAN-LENGTH > LIMIT-CALL-ID OR
              WS-RESPONSE(JP-SPAN-START:1) NOT = X'22' OR
              WS-RESPONSE(JP-SPAN-START + JP-SPAN-LENGTH - 1:1)
                  NOT = X'22'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
       MOVE X'696E707574' TO WS-LITERAL(1:5)
           MOVE 5 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-COMMAND
           IF JP-STATUS NOT = STATUS-OK
               IF JP-STATUS = STATUS-CAPACITY
                   PERFORM FAIL-CAPACITY
               ELSE
                   PERFORM FAIL-PROTOCOL
               END-IF
               EXIT PARAGRAPH
           END-IF
           MOVE WS-DECODE-LENGTH TO WS-COMMAND-LENGTH
           MOVE WS-DECODE(1:WS-DECODE-LENGTH)
             TO WS-COMMAND(1:WS-DECODE-LENGTH).

       VALIDATE-MESSAGE.
           MOVE X'6964' TO WS-LITERAL(1:2)
           MOVE 2 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM VALIDATE-FOUND-STRING
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           MOVE X'726F6C65' TO WS-LITERAL(1:4)
           MOVE 4 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-FOUND
           IF JP-STATUS NOT = STATUS-OK
             OR WS-DECODE-LENGTH NOT = 9
             OR WS-DECODE(1:9) NOT = X'617373697374616E74'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           MOVE X'737461747573' TO WS-LITERAL(1:6)
           MOVE 6 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-FOUND
           IF JP-STATUS NOT = STATUS-OK
             OR WS-DECODE-LENGTH NOT = 9
             OR WS-DECODE(1:9) NOT = X'636F6D706C65746564'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           MOVE X'7068617365' TO WS-LITERAL(1:5)
           MOVE 5 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           MOVE FLAG-OFF TO WS-PHASE-FINAL WS-PHASE-PRESENT
           IF JP-FOUND = FLAG-ON
               MOVE FLAG-ON TO WS-PHASE-PRESENT
               PERFORM DECODE-FOUND
               IF WS-DECODE-LENGTH = 12
                 AND WS-DECODE(1:12) = X'66696E616C5F616E73776572'
                   MOVE FLAG-ON TO WS-PHASE-FINAL
                   IF WS-HAS-FINAL-PHASE = FLAG-OFF
                       MOVE 0 TO WS-FINAL-LENGTH WS-FINAL-COUNT
                       MOVE FLAG-OFF TO WS-FINAL-OVERFLOW
                   END-IF
                   MOVE FLAG-ON TO WS-HAS-FINAL-PHASE
               ELSE
                   IF WS-DECODE-LENGTH NOT = 10
                     OR WS-DECODE(1:10) NOT = X'636F6D6D656E74617279'
                       PERFORM FAIL-PROTOCOL
                       EXIT PARAGRAPH
                   END-IF
               END-IF
           END-IF
       MOVE X'636F6E74656E74' TO WS-LITERAL(1:7)
           MOVE 7 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           IF WS-RESPONSE(JP-SPAN-START:1) NOT = X'5B'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           MOVE JP-SPAN-START TO WS-CONTENT-CURSOR
           PERFORM UNTIL WS-FAIL = FLAG-ON
               INITIALIZE JSON-PARM
               MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
               SET JP-INPUT-PTR TO ADDRESS OF WS-RESPONSE
               MOVE WS-RESPONSE-LENGTH TO JP-INPUT-LENGTH
               MOVE WS-CONTENT-CURSOR TO JP-CURSOR
               CALL "JSONSCAN" USING JSON-PARM
               IF JP-STATUS NOT = STATUS-OK
                   PERFORM FAIL-PROTOCOL
                   EXIT PERFORM
               END-IF
               MOVE JP-NEXT-CURSOR TO WS-CONTENT-CURSOR
               IF JP-END = FLAG-ON EXIT PERFORM END-IF
               MOVE JP-SPAN-START TO WS-ITEM-START
               MOVE JP-SPAN-LENGTH TO WS-ITEM-LENGTH
               PERFORM VALIDATE-CONTENT-PART
           END-PERFORM.

       VALIDATE-CONTENT-PART.
           MOVE X'74797065' TO WS-LITERAL(1:4)
           MOVE 4 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-FOUND
           IF JP-STATUS NOT = STATUS-OK
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           IF WS-DECODE-LENGTH = 7
             AND WS-DECODE(1:7) = X'7265667573616C'
               MOVE X'7265667573616C' TO WS-LITERAL(1:7)
               MOVE 7 TO WS-LITERAL-LENGTH
               PERFORM FIND-ITEM-MEMBER
               IF JP-FOUND NOT = FLAG-ON
                   PERFORM FAIL-PROTOCOL
                   EXIT PARAGRAPH
               END-IF
               PERFORM VALIDATE-FOUND-STRING
               EXIT PARAGRAPH
           END-IF
           IF WS-DECODE-LENGTH NOT = 11
             OR WS-DECODE(1:11) NOT = X'6F75747075745F74657874'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           MOVE X'616E6E6F746174696F6E73' TO WS-LITERAL(1:11)
           MOVE 11 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
             OR WS-RESPONSE(JP-SPAN-START:1) NOT = X'5B'
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           MOVE FLAG-ON TO WS-OBJECT-ONLY
           PERFORM VALIDATE-TEXT-ARRAY
           IF WS-FAIL = FLAG-ON EXIT PARAGRAPH END-IF
           MOVE X'6C6F6770726F6273' TO WS-LITERAL(1:8)
           MOVE 8 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND = FLAG-ON
               IF WS-RESPONSE(JP-SPAN-START:1) NOT = X'5B'
                   PERFORM FAIL-PROTOCOL
                   EXIT PARAGRAPH
               END-IF
           END-IF
           MOVE X'74657874' TO WS-LITERAL(1:4)
           MOVE 4 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           IF WS-PHASE-FINAL = FLAG-ON
             OR (WS-PHASE-PRESENT = FLAG-OFF
             AND WS-HAS-FINAL-PHASE = FLAG-OFF)
               COMPUTE WS-DECODE-CAPACITY =
                   LIMIT-FINAL - WS-FINAL-LENGTH
               PERFORM DECODE-FOUND-WITH-CAPACITY
               IF JP-STATUS NOT = STATUS-OK
                   IF JP-STATUS = STATUS-CAPACITY
                       MOVE FLAG-ON TO WS-FINAL-OVERFLOW
                   ELSE
                       PERFORM FAIL-PROTOCOL
                   END-IF
               ELSE
                   MOVE WS-DECODE(1:WS-DECODE-LENGTH)
                     TO WS-FINAL(WS-FINAL-LENGTH + 1:WS-DECODE-LENGTH)
                   ADD WS-DECODE-LENGTH TO WS-FINAL-LENGTH
                   ADD 1 TO WS-FINAL-COUNT
               END-IF
           ELSE
               PERFORM VALIDATE-FOUND-STRING
           END-IF.

       VALIDATE-TEXT-ARRAY.
           MOVE WS-ITEM-START TO WS-PARENT-START
           MOVE WS-ITEM-LENGTH TO WS-PARENT-LENGTH
           MOVE JP-SPAN-START TO WS-VALIDATE-CURSOR
           COMPUTE WS-ARRAY-END = JP-SPAN-START + JP-SPAN-LENGTH
           PERFORM UNTIL WS-FAIL = FLAG-ON
               INITIALIZE JSON-PARM
               MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
               SET JP-INPUT-PTR TO ADDRESS OF WS-RESPONSE
               MOVE WS-RESPONSE-LENGTH TO JP-INPUT-LENGTH
               MOVE WS-VALIDATE-CURSOR TO JP-CURSOR
               CALL "JSONSCAN" USING JSON-PARM
               IF JP-STATUS NOT = STATUS-OK
                   PERFORM FAIL-PROTOCOL
                   EXIT PERFORM
               END-IF
               MOVE JP-NEXT-CURSOR TO WS-VALIDATE-CURSOR
               IF JP-END = FLAG-ON
                   IF JP-NEXT-CURSOR NOT = WS-ARRAY-END
                       PERFORM FAIL-PROTOCOL
                   END-IF
                   EXIT PERFORM
               END-IF
               IF WS-RESPONSE(JP-SPAN-START:1) NOT = X'7B'
                   PERFORM FAIL-PROTOCOL
                   EXIT PERFORM
               END-IF
               IF WS-OBJECT-ONLY = FLAG-OFF
                   MOVE JP-SPAN-START TO WS-ITEM-START
                   MOVE JP-SPAN-LENGTH TO WS-ITEM-LENGTH
                   PERFORM VALIDATE-TEXT-ELEMENT
               END-IF
           END-PERFORM
           MOVE WS-PARENT-START TO WS-ITEM-START
           MOVE WS-PARENT-LENGTH TO WS-ITEM-LENGTH.

       VALIDATE-TEXT-ELEMENT.
           MOVE X'74797065' TO WS-LITERAL(1:4)
           MOVE 4 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM DECODE-FOUND
           IF JP-STATUS NOT = STATUS-OK
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           EVALUATE TRUE
               WHEN WS-SUMMARY-TEXT
                   IF WS-DECODE-LENGTH NOT = 12
                     OR WS-DECODE(1:12) NOT =
                        X'73756D6D6172795F74657874'
                       PERFORM FAIL-PROTOCOL
                       EXIT PARAGRAPH
                   END-IF
               WHEN WS-REASONING-TEXT
                   IF WS-DECODE-LENGTH NOT = 14
                     OR WS-DECODE(1:14) NOT =
                        X'726561736F6E696E675F74657874'
                       PERFORM FAIL-PROTOCOL
                       EXIT PARAGRAPH
                   END-IF
               WHEN OTHER
                   PERFORM FAIL-INTERNAL
                   EXIT PARAGRAPH
           END-EVALUATE
           MOVE X'74657874' TO WS-LITERAL(1:4)
           MOVE 4 TO WS-LITERAL-LENGTH
           PERFORM FIND-ITEM-MEMBER
           IF JP-FOUND NOT = FLAG-ON
               PERFORM FAIL-PROTOCOL
               EXIT PARAGRAPH
           END-IF
           PERFORM VALIDATE-FOUND-STRING.

       FIND-RESPONSE-MEMBER.
           MOVE 1 TO WS-ITEM-START
           MOVE WS-RESPONSE-LENGTH TO WS-ITEM-LENGTH
           PERFORM FIND-ITEM-MEMBER.

       FIND-ITEM-MEMBER.
           INITIALIZE JSON-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           SET JP-INPUT-PTR TO ADDRESS OF WS-RESPONSE
           MOVE WS-RESPONSE-LENGTH TO JP-INPUT-LENGTH
           MOVE WS-ITEM-START TO JP-CURSOR
           SET JP-NAME-PTR TO ADDRESS OF WS-LITERAL
           MOVE WS-LITERAL-LENGTH TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
               PERFORM FAIL-PROTOCOL
           END-IF.

       DECODE-FOUND.
           MOVE LIMIT-FINAL TO WS-DECODE-CAPACITY
           PERFORM DECODE-FOUND-WITH-CAPACITY.

       DECODE-COMMAND.
           MOVE LIMIT-COMMAND TO WS-DECODE-CAPACITY
           PERFORM DECODE-FOUND-WITH-CAPACITY.

       DECODE-FOUND-WITH-CAPACITY.
           MOVE JP-SPAN-START TO WS-CURSOR
           MOVE JP-SPAN-LENGTH TO WS-ITEM-LENGTH
           INITIALIZE JSON-PARM
           MOVE JSON-DECODE TO JP-OPERATION
           SET JP-INPUT-PTR TO ADDRESS OF WS-RESPONSE
           MOVE WS-RESPONSE-LENGTH TO JP-INPUT-LENGTH
           MOVE WS-CURSOR TO JP-CURSOR
           SET JP-OUTPUT-PTR TO ADDRESS OF WS-DECODE
           MOVE WS-DECODE-CAPACITY TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           MOVE JP-OUTPUT-LENGTH TO WS-DECODE-LENGTH.

       VALIDATE-FOUND-STRING.
           IF JP-SPAN-LENGTH < 2
             OR WS-RESPONSE(JP-SPAN-START:1) NOT = X'22'
             OR WS-RESPONSE(
                 JP-SPAN-START + JP-SPAN-LENGTH - 1:1) NOT = X'22'
               PERFORM FAIL-PROTOCOL
           END-IF.

       COMMIT-ITEMS.
           MOVE WS-HISTORY-LENGTH TO WS-OLD-HISTORY
           MOVE WS-OUTPUT-START TO WS-ARRAY-CURSOR
           PERFORM UNTIL WS-FAIL = FLAG-ON
               INITIALIZE JSON-PARM
               MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
               SET JP-INPUT-PTR TO ADDRESS OF WS-RESPONSE
               MOVE WS-RESPONSE-LENGTH TO JP-INPUT-LENGTH
               MOVE WS-ARRAY-CURSOR TO JP-CURSOR
               CALL "JSONSCAN" USING JSON-PARM
               IF JP-STATUS NOT = STATUS-OK
                   PERFORM FAIL-INTERNAL
                   EXIT PERFORM
               END-IF
               MOVE JP-NEXT-CURSOR TO WS-ARRAY-CURSOR
               IF JP-END = FLAG-ON EXIT PERFORM END-IF
               IF WS-HISTORY-LENGTH > 0
       MOVE X'2C' TO WS-LITERAL(1:1)
                   MOVE 1 TO WS-LITERAL-LENGTH
                   PERFORM APPEND-HISTORY-LITERAL
               END-IF
               IF WS-TOOL-COUNT = 1
                 AND WS-CALL-RESP-START >=
                     JP-SPAN-START
                 AND WS-CALL-RESP-START <
                     JP-SPAN-START + JP-SPAN-LENGTH
                   MOVE WS-HISTORY-LENGTH TO WS-CALL-START
                   ADD 1 TO WS-CALL-START
                   ADD WS-CALL-RESP-START TO WS-CALL-START
                   SUBTRACT JP-SPAN-START FROM WS-CALL-START
                   MOVE WS-CALL-RESP-LENGTH TO WS-CALL-LENGTH
               END-IF
               MOVE WS-RESPONSE(JP-SPAN-START:JP-SPAN-LENGTH)
                 TO WS-HISTORY(WS-HISTORY-LENGTH + 1:
                               JP-SPAN-LENGTH)
               ADD JP-SPAN-LENGTH TO WS-HISTORY-LENGTH
           END-PERFORM
           IF WS-FAIL = FLAG-ON
               PERFORM ROLLBACK-HISTORY
           END-IF.

       ROLLBACK-HISTORY.
           IF WS-HISTORY-LENGTH > WS-OLD-HISTORY
               MOVE LOW-VALUES TO WS-HISTORY(
                   WS-OLD-HISTORY + 1:
                   WS-HISTORY-LENGTH - WS-OLD-HISTORY)
           END-IF
           MOVE WS-OLD-HISTORY TO WS-HISTORY-LENGTH.

       MAP-HTTP-FAILURE.
           MOVE HP-STATUS TO RP-STATUS
           EVALUATE HP-STATUS
               WHEN STATUS-HTTP-CODE
                   MOVE HP-HTTP-STATUS TO RP-HTTP-STATUS
                   MOVE CATEGORY-PROTOCOL TO RP-ERROR-CATEGORY
               WHEN STATUS-HTTP
               WHEN STATUS-RESPONSES
               WHEN STATUS-JSON
                   MOVE CATEGORY-PROTOCOL TO RP-ERROR-CATEGORY
               WHEN STATUS-NETWORK
                   MOVE CATEGORY-NETWORK TO RP-ERROR-CATEGORY
               WHEN STATUS-CAPACITY
                   MOVE CATEGORY-CAPACITY TO RP-ERROR-CATEGORY
               WHEN OTHER
                   MOVE CATEGORY-INTERNAL TO RP-ERROR-CATEGORY
           END-EVALUATE
           MOVE FLAG-ON TO WS-FAIL.

       MAP-JSON-FAILURE.
           IF JP-STATUS = STATUS-CAPACITY
               PERFORM FAIL-CAPACITY
           ELSE
               PERFORM FAIL-PROTOCOL
           END-IF.

       FAIL-PROTOCOL.
           MOVE STATUS-RESPONSES TO RP-STATUS
           MOVE CATEGORY-PROTOCOL TO RP-ERROR-CATEGORY
           MOVE ACTION-NONE TO RP-ACTION
           MOVE 0 TO RP-ACTION-LENGTH WS-CALL-START WS-CALL-LENGTH
           SET WS-IDLE TO TRUE
           MOVE FLAG-ON TO WS-FAIL.

       FAIL-JSON.
           MOVE STATUS-JSON TO RP-STATUS
           MOVE CATEGORY-PROTOCOL TO RP-ERROR-CATEGORY
           MOVE ACTION-NONE TO RP-ACTION
           MOVE 0 TO RP-ACTION-LENGTH WS-CALL-START WS-CALL-LENGTH
           SET WS-IDLE TO TRUE
           MOVE FLAG-ON TO WS-FAIL.

       FAIL-CAPACITY.
           MOVE STATUS-CAPACITY TO RP-STATUS
           MOVE CATEGORY-CAPACITY TO RP-ERROR-CATEGORY
           MOVE ACTION-NONE TO RP-ACTION
           MOVE 0 TO RP-ACTION-LENGTH WS-CALL-START WS-CALL-LENGTH
           SET WS-IDLE TO TRUE
           MOVE FLAG-ON TO WS-FAIL.

       FAIL-INTERNAL.
           MOVE STATUS-INTERNAL TO RP-STATUS
           MOVE CATEGORY-INTERNAL TO RP-ERROR-CATEGORY
           MOVE ACTION-NONE TO RP-ACTION
           MOVE 0 TO RP-ACTION-LENGTH WS-CALL-START WS-CALL-LENGTH
           SET WS-IDLE TO TRUE
           MOVE FLAG-ON TO WS-FAIL.

       DESTROY-STATE.
           MOVE ALL X'00' TO WS-HISTORY WS-REQUEST WS-RESPONSE
           MOVE 0 TO WS-HISTORY-LENGTH WS-REQUEST-LENGTH
                     WS-RESPONSE-LENGTH WS-CALL-START WS-CALL-LENGTH
           SET WS-IDLE TO TRUE.

       END PROGRAM RESPAPI.
