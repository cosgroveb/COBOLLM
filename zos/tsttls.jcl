//COBLMTLS JOB
//* Set site JOB card and every SET value before submission.
//         SET HLQ=YOURHLQ
//         SET TCPHLQ=TCPIP
//         SET CEEHLQ=CEE
//         SET GATE=/u/site/cobollm/zos/verify-attls.sh
//         SET POSENV=YOURHLQ.COBOLLM.TLS.POSENV
//         SET MISENV=YOURHLQ.COBOLLM.TLS.MISENV
//         SET PROVENV=YOURHLQ.COBOLLM.TLS.PROVENV
//         SET CAPENV=YOURHLQ.COBOLLM.TLS.CAPENV
//* POSENV and MISENV contain one endpoint host and expected result.
//* PROVENV names source/stage/install/parser/effective evidence,
//* active configuration, stack, destination, and expected values.
//* CAPENV names controlled-peer capture from every failed TLS gate.
//COB      PROC MEMBER=,LIB=COBOL,OUT=TLSOBJ
//COMPILE  EXEC PGM=IGYCRCTL,REGION=0M,PARMDD=OPTIONS
//OPTIONS  DD *
CODEPAGE(1047),NOSEQ,LP(32),RENT,DATA(31),RMODE(ANY),
NOTHREAD,NODLL,NODYNAM,PGMNAME(LONGMIXED),OBJECT
/*
//STEPLIB  DD DISP=SHR,DSN=&CEEHLQ..SCEERUN
//SYSIN    DD DISP=SHR,DSN=&HLQ..COBOLLM.&LIB(&MEMBER)
//SYSLIB   DD DISP=SHR,DSN=&HLQ..COBOLLM.COPY
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.ZCOPY
//         DD DISP=SHR,DSN=&TCPHLQ..SEZANMAC
//SYSLIN   DD DISP=SHR,DSN=&HLQ..COBOLLM.&OUT(&MEMBER)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(10,5))
//         PEND
//COMPTLS  EXEC COB,MEMBER=TSTZTLS,LIB=TESTCOB
//COMPNET  EXEC COB,MEMBER=NETIO
//COMPTEXT EXEC COB,MEMBER=NATUTF8
//COMPSHL  EXEC COB,MEMBER=SHELL
//BINDTLS  EXEC PGM=IEWL,REGION=0M,
// PARM='REUS(NONE),MAP,XREF,LIST'
//SYSLIN   DD DISP=SHR,DSN=&HLQ..COBOLLM.TLSOBJ(TSTZTLS)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TLSOBJ(NETIO)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TLSOBJ(NATUTF8)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TLSOBJ(SHELL)
//         DD DISP=SHR,DSN=&TCPHLQ..SEZATCP(EZASOKET)
//         DD DISP=SHR,DSN=&TCPHLQ..SEZATCP(EZACIC09)
//SYSLIB   DD DISP=SHR,DSN=&CEEHLQ..SCEELKED
//         DD DISP=SHR,DSN=&TCPHLQ..SEZATCP
//SYSLMOD  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD(TSTZTLS)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(10,5))
//* Real runs prove normal SIGPIPE restoration through a fresh shell.
//* Failure injection remains deterministic in TEST.JCL FSIGNAL cases.
//* Require active source, stack, names, and exact effective values.
//PROVEN   EXEC PGM=BPXBATCH,COND=(0,NE),
// PARM='SH &GATE provenance'
//STDENV   DD DISP=SHR,DSN=&PROVENV
//STDOUT   DD SYSOUT=*
//STDERR   DD SYSOUT=*
//* Open a new connection through the verified positive policy.
//POSITIVE EXEC PGM=TSTZTLS,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//CEEOPTS  DD *
POSIX(ON),
ENVAR("_BPXK_AUTOCVT=OFF","_CEE_ENVFILE=DD:ENVIRON")
/*
//ENVIRON  DD DISP=SHR,DSN=&POSENV
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//* External policy/reference-ID or certificate mismatch.
//MISMATCH EXEC PGM=TSTZTLS,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//CEEOPTS  DD *
POSIX(ON),
ENVAR("_BPXK_AUTOCVT=OFF","_CEE_ENVFILE=DD:ENVIRON")
/*
//ENVIRON  DD DISP=SHR,DSN=&MISENV
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//* The controlled peer capture must contain no application bytes.
//NOLEAK   EXEC PGM=BPXBATCH,COND=(0,NE),
// PARM='SH &GATE no-leak'
//STDENV   DD DISP=SHR,DSN=&CAPENV
//STDOUT   DD SYSOUT=*
//STDERR   DD SYSOUT=*
//
