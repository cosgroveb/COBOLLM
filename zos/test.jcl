//COBLMTST JOB
//* Set site JOB card, HLQ, TCPHLQ, and CEEHLQ before submission.
//         SET HLQ=BCOSGROVE
//         SET TCPHLQ=TCPIP
//         SET CEEHLQ=CEE
//* TESTCOB members: TSTCNTR,TSTJSON,TSTHTTP,TSTRESP,TSTZTXT,
//* TSTSHELL,TSTZAGT,TSTZLCH,TSTZNET,TSTZOUT,TSTZBYTE,FHTTP,
//* FNET,FRESP,FSHELL,FOUTPUT,FCOBOL,FEZAS,FSIGNAL,FNATUTF8,TSTNATIV.
//COB      PROC MEMBER=,LIB=TESTCOB,OUT=TESTOBJ
//COMPILE  EXEC PGM=IGYCRCTL,REGION=0M,PARMDD=OPTIONS
//OPTIONS  DD *
CODEPAGE(1047),NOSEQ,LP(32),RENT,DATA(31),RMODE(ANY),
NOTHREAD,NODLL,NODYNAM,PGMNAME(LONGMIXED),OBJECT
/*
//STEPLIB  DD DISP=SHR,DSN=&CEEHLQ..SCEERUN
//SYSIN    DD DISP=SHR,DSN=&HLQ..COBOLLM.&LIB(&MEMBER)
//SYSLIB   DD DISP=SHR,DSN=&HLQ..COBOLLM.COPY
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.ZCOPY
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TCOPY
//         DD DISP=SHR,DSN=&TCPHLQ..SEZANMAC
//SYSLIN   DD DISP=SHR,DSN=&HLQ..COBOLLM.&OUT(&MEMBER)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(10,5))
//         PEND
//LINK     PROC MEMBER=
//BIND     EXEC PGM=IEWL,REGION=0M,
// PARM='REUS(NONE),MAP,XREF,LIST'
//SYSLIB   DD DISP=SHR,DSN=&CEEHLQ..SCEELKED
//         DD DISP=SHR,DSN=&TCPHLQ..SEZATCP
//SYSLMOD  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD(&MEMBER)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(10,5))
//         PEND
//* Compile production objects used by target tests.
//P01      EXEC COB,MEMBER=ZOSLNCHR,LIB=COBOL,OUT=OBJ
//P02      EXEC COB,MEMBER=COBOLLM,LIB=COBOL,OUT=OBJ
//P03      EXEC COB,MEMBER=RESPAPI,LIB=COBOL,OUT=OBJ
//P04      EXEC COB,MEMBER=JSONSCAN,LIB=COBOL,OUT=OBJ
//P05      EXEC COB,MEMBER=HTTP11,LIB=COBOL,OUT=OBJ
//P06      EXEC COB,MEMBER=NETIO,LIB=COBOL,OUT=OBJ
//P07      EXEC COB,MEMBER=SHELL,LIB=COBOL,OUT=OBJ
//P08      EXEC COB,MEMBER=NATUTF8,LIB=COBOL,OUT=OBJ
//P09      EXEC COB,MEMBER=OUTPUT,LIB=COBOL,OUT=OBJ
//* Compile test drivers and boundary fakes.
//T01      EXEC COB,MEMBER=TSTCNTR
//T02      EXEC COB,MEMBER=TSTJSON
//T03      EXEC COB,MEMBER=TSTHTTP
//T04      EXEC COB,MEMBER=TSTRESP
//T05      EXEC COB,MEMBER=TSTZTXT
//T06      EXEC COB,MEMBER=TSTSHELL
//T07      EXEC COB,MEMBER=TSTZAGT
//T08      EXEC COB,MEMBER=TSTZLCH
//T09      EXEC COB,MEMBER=TSTZNET
//T10      EXEC COB,MEMBER=TSTZOUT
//T11      EXEC COB,MEMBER=TSTZBYTE
//F01      EXEC COB,MEMBER=FHTTP
//F02      EXEC COB,MEMBER=FNET
//F03      EXEC COB,MEMBER=FRESP
//F04      EXEC COB,MEMBER=FSHELL
//F05      EXEC COB,MEMBER=FOUTPUT
//F06      EXEC COB,MEMBER=FCOBOL
//F07      EXEC COB,MEMBER=FEZAS
//F08      EXEC COB,MEMBER=FSIGNAL
//F09      EXEC COB,MEMBER=TSTNATIV,LIB=COBOL,OUT=OBJ
//F10      EXEC COB,MEMBER=FNATUTF8
//* Link contract test.
//LCNTR    EXEC LINK,MEMBER=TSTCNTR
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTCNTR)
//* Link JSON test.
//LJSON    EXEC LINK,MEMBER=TSTJSON
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTJSON)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(JSONSCAN)
//* Link HTTP test with fake NETIO.
//LHTTP    EXEC LINK,MEMBER=TSTHTTP
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTHTTP)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(HTTP11)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FNET)
//* Link Responses test with fake HTTP11.
//LRESP    EXEC LINK,MEMBER=TSTRESP
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTRESP)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(RESPAPI)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(JSONSCAN)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FHTTP)
//* Link IBM-1047 z/OS conversion test.
//LTEXT    EXEC LINK,MEMBER=TSTZTXT
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTZTXT)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(NATUTF8)
//* Link real z/OS shell and output test.
//LSHELL   EXEC LINK,MEMBER=TSTSHELL
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTSHELL)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(TSTNATIV)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(SHELL)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(OUTPUT)
//* Link target-native IBM-1047 byte assertions.
//LZBYTE   EXEC LINK,MEMBER=TSTZBYTE
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTZBYTE)
//* Link synthetic USS argv test.
//LZLCH    EXEC LINK,MEMBER=TSTZLCH
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTZLCH)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(ZOSLNCHR)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FCOBOL)
//* Link orchestration test with platform adapter and boundary fakes.
//LAGENT   EXEC LINK,MEMBER=TSTZAGT
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTZAGT)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(COBOLLM)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(HTTP11)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FNATUTF8)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(TSTNATIV)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FRESP)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FSHELL)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FOUTPUT)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FNET)
//* Link deterministic EZASOKET lifecycle test.
//LZNET    EXEC LINK,MEMBER=TSTZNET
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTZNET)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(NETIO)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(NATUTF8)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FEZAS)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(FSIGNAL)
//         DD DISP=SHR,DSN=&TCPHLQ..SEZATCP(EZACIC09)
//* Link real OUTPUT to an external pipe with no write/read fake.
//LZOUT    EXEC LINK,MEMBER=TSTZOUT
//BIND.SYSLIN DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTOBJ(TSTZOUT)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(TSTNATIV)
//         DD DISP=SHR,DSN=&HLQ..COBOLLM.OBJ(OUTPUT)
//* Run every linked target component test.
//RCNTR    EXEC PGM=TSTCNTR,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RJSON    EXEC PGM=TSTJSON,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RHTTP    EXEC PGM=TSTHTTP,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RRESP    EXEC PGM=TSTRESP,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RTEXT    EXEC PGM=TSTZTXT,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RSHELL   EXEC PGM=TSTSHELL,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RZLCH    EXEC PGM=TSTZLCH,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RAGENT   EXEC PGM=TSTZAGT,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RZNET    EXEC PGM=TSTZNET,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RZOUT    EXEC PGM=TSTZOUT,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//RZBYTE   EXEC PGM=TSTZBYTE,COND=(0,NE),REGION=0M
//STEPLIB  DD DISP=SHR,DSN=&HLQ..COBOLLM.TESTLOAD
//SYSOUT   DD SYSOUT=*
//
