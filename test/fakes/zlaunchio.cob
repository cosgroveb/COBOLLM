       IDENTIFICATION DIVISION.
       PROGRAM-ID. "fopen".

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY ZLCHCTRL.
       01 FO-RESULT PIC S9(9) COMP-5.

       LINKAGE SECTION.
       01 FO-NAME PIC X(8).
       01 FO-MODE PIC X(3).

       PROCEDURE DIVISION USING BY REFERENCE FO-NAME FO-MODE.
           ADD 1 TO ZF-OPEN-COUNT
           MOVE FLAG-OFF TO ZF-OPEN-ARGS-VALID
           IF FO-NAME = X"C4C47AE3C1E2D200" AND
              FO-MODE = X"998200"
               MOVE FLAG-ON TO ZF-OPEN-ARGS-VALID
           END-IF
           IF ZF-OPEN-FAIL = FLAG-ON
               MOVE ZERO TO FO-RESULT
           ELSE
               MOVE 1 TO FO-RESULT
           END-IF
           GOBACK RETURNING FO-RESULT.

       END PROGRAM "fopen".

       IDENTIFICATION DIVISION.
       PROGRAM-ID. "fread".

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY ZLCHCTRL.
       01 FR-RESULT PIC 9(9) COMP-5.
       01 FR-REMAINING PIC S9(9) COMP-5.
       01 FR-TAKE PIC S9(9) COMP-5.

       LINKAGE SECTION.
       01 FR-BUFFER-PTR USAGE POINTER.
       01 FR-SIZE PIC 9(9) COMP-5.
       01 FR-MEMBERS PIC 9(9) COMP-5.
       01 FR-STREAM USAGE POINTER.
       01 FR-BUFFER PIC X(65536) BASED.

       PROCEDURE DIVISION USING BY VALUE FR-BUFFER-PTR FR-SIZE
           FR-MEMBERS FR-STREAM.
           ADD 1 TO ZF-READ-COUNT
           MOVE ZERO TO FR-RESULT
           IF FR-BUFFER-PTR NOT = NULL AND FR-STREAM NOT = NULL AND
              FR-SIZE = 1 AND ZF-READ-ERROR NOT = FLAG-ON AND
              ZF-ZERO-PROGRESS NOT = FLAG-ON AND
              ZF-READ-CURSOR < ZF-INPUT-LENGTH
               COMPUTE FR-REMAINING =
                   ZF-INPUT-LENGTH - ZF-READ-CURSOR
               MOVE FR-REMAINING TO FR-TAKE
               IF FR-TAKE > FR-MEMBERS
                   MOVE FR-MEMBERS TO FR-TAKE
               END-IF
               IF ZF-CHUNK-SIZE > ZERO AND
                  FR-TAKE > ZF-CHUNK-SIZE
                   MOVE ZF-CHUNK-SIZE TO FR-TAKE
               END-IF
               SET ADDRESS OF FR-BUFFER TO FR-BUFFER-PTR
               MOVE ZF-INPUT(ZF-READ-CURSOR + 1:FR-TAKE) TO
                   FR-BUFFER(1:FR-TAKE)
               ADD FR-TAKE TO ZF-READ-CURSOR
               MOVE FR-TAKE TO FR-RESULT
           END-IF
           GOBACK RETURNING FR-RESULT.

       END PROGRAM "fread".

       IDENTIFICATION DIVISION.
       PROGRAM-ID. "ferror".

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY ZLCHCTRL.
       01 FE-RESULT PIC S9(9) COMP-5.

       LINKAGE SECTION.
       01 FE-STREAM USAGE POINTER.

       PROCEDURE DIVISION USING BY VALUE FE-STREAM.
           ADD 1 TO ZF-FERROR-COUNT
           IF ZF-READ-ERROR = FLAG-ON
               MOVE 1 TO FE-RESULT
           ELSE
               MOVE ZERO TO FE-RESULT
           END-IF
           GOBACK RETURNING FE-RESULT.

       END PROGRAM "ferror".

       IDENTIFICATION DIVISION.
       PROGRAM-ID. "feof".

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY ZLCHCTRL.
       01 FF-RESULT PIC S9(9) COMP-5.

       LINKAGE SECTION.
       01 FF-STREAM USAGE POINTER.

       PROCEDURE DIVISION USING BY VALUE FF-STREAM.
           ADD 1 TO ZF-FEOF-COUNT
           IF ZF-ZERO-PROGRESS = FLAG-ON OR
              ZF-READ-CURSOR < ZF-INPUT-LENGTH
               MOVE ZERO TO FF-RESULT
           ELSE
               MOVE 1 TO FF-RESULT
           END-IF
           GOBACK RETURNING FF-RESULT.

       END PROGRAM "feof".

       IDENTIFICATION DIVISION.
       PROGRAM-ID. "fclose".

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY ZLCHCTRL.
       01 FC-RESULT PIC S9(9) COMP-5.

       LINKAGE SECTION.
       01 FC-STREAM USAGE POINTER.

       PROCEDURE DIVISION USING BY VALUE FC-STREAM.
           ADD 1 TO ZF-CLOSE-COUNT
           MOVE ZF-CLOSE-RESULT TO FC-RESULT
           GOBACK RETURNING FC-RESULT.

       END PROGRAM "fclose".
