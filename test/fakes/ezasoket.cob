       IDENTIFICATION DIVISION.
       PROGRAM-ID. EZASOKET.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY EZAFCTRL.
       01 WS-RESULT.
           05 WS-RESULT-FLAGS PIC 9(8) BINARY.
           05 WS-RESULT-FAMILY PIC 9(8) BINARY.
           05 WS-RESULT-SOCKTYPE PIC 9(8) BINARY.
           05 WS-RESULT-PROTOCOL PIC 9(8) BINARY.
           05 WS-RESULT-ADDRLEN PIC 9(8) BINARY.
           05 WS-RESULT-CANON USAGE POINTER.
           05 WS-RESULT-ADDR USAGE POINTER.
           05 WS-RESULT-NEXT USAGE POINTER.
       01 WS-SOCKET-ADDRESS.
           05 WS-SA-FAMILY PIC 9(4) BINARY.
           05 WS-SA-PORT PIC 9(4) BINARY.
           05 WS-SA-DATA PIC X(24).
       01 WS-TTLS-RAW PIC X(56).
       01 WS-TTLS-DATA REDEFINES WS-TTLS-RAW.
           COPY EZBZTLSB.

       LINKAGE SECTION.
       01 LK-FUNCTION PIC X(16).
       01 LK-ARG-1 PIC X(1048576).
       01 LK-ARG-2 PIC X(1048576).
       01 LK-ARG-3 PIC X(1048576).
       01 LK-ARG-4 PIC X(1048576).
       01 LK-ARG-5 PIC X(1048576).
       01 LK-ARG-6 PIC X(1048576).
       01 LK-ARG-7 PIC X(1048576).
       01 LK-ARG-8 PIC X(1048576).
       01 LK-ARG-9 PIC X(1048576).
       01 LK-FULLWORD PIC S9(8) BINARY BASED.
       01 LK-UNSIGNED PIC 9(8) BINARY BASED.
       01 LK-HALFWORD PIC S9(4) BINARY BASED.
       01 LK-POINTER USAGE POINTER BASED.

       PROCEDURE DIVISION USING LK-FUNCTION LK-ARG-1 LK-ARG-2
           LK-ARG-3 LK-ARG-4 LK-ARG-5 LK-ARG-6 LK-ARG-7
           LK-ARG-8 LK-ARG-9.
           ADD 1 TO EF-CALL-COUNT
           EVALUATE LK-FUNCTION
               WHEN "INITAPI" PERFORM FAKE-INITAPI
               WHEN "GETADDRINFO" PERFORM FAKE-GETADDRINFO
               WHEN "FREEADDRINFO" PERFORM FAKE-FREEADDRINFO
               WHEN "SOCKET" PERFORM FAKE-SOCKET
               WHEN "CONNECT" PERFORM FAKE-CONNECT
               WHEN "IOCTL" PERFORM FAKE-IOCTL
               WHEN "WRITE" PERFORM FAKE-WRITE
               WHEN "READ" PERFORM FAKE-READ
               WHEN "CLOSE" PERFORM FAKE-CLOSE
               WHEN "TERMAPI" PERFORM FAKE-TERMAPI
               WHEN OTHER CONTINUE
           END-EVALUATE
           GOBACK.

       FAKE-INITAPI.
           MOVE "I" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-6
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-7
           IF EF-MODE = 1
               MOVE -1 TO LK-FULLWORD
           ELSE
               MOVE ZERO TO LK-FULLWORD
           END-IF.

       FAKE-GETADDRINFO.
           MOVE "G" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH
           SET ADDRESS OF LK-UNSIGNED TO ADDRESS OF LK-ARG-2
           MOVE LK-UNSIGNED TO EF-NODE-LENGTH
           MOVE LK-ARG-1(1:EF-NODE-LENGTH) TO
               EF-NODE(1:EF-NODE-LENGTH)
           SET ADDRESS OF LK-UNSIGNED TO ADDRESS OF LK-ARG-4
           MOVE LK-UNSIGNED TO EF-SERVICE-LENGTH
           MOVE LK-ARG-3(1:EF-SERVICE-LENGTH) TO
               EF-SERVICE(1:EF-SERVICE-LENGTH)
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-8
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-9
           IF EF-MODE = 2
               MOVE -1 TO LK-FULLWORD
           ELSE
               MOVE LOW-VALUES TO WS-RESULT WS-SOCKET-ADDRESS
               MOVE 2 TO WS-RESULT-FAMILY WS-SA-FAMILY
               MOVE 1 TO WS-RESULT-SOCKTYPE
               MOVE 6 TO WS-RESULT-PROTOCOL
               MOVE 16 TO WS-RESULT-ADDRLEN
               SET WS-RESULT-ADDR TO ADDRESS OF WS-SOCKET-ADDRESS
               SET ADDRESS OF LK-POINTER TO ADDRESS OF LK-ARG-6
               SET LK-POINTER TO ADDRESS OF WS-RESULT
               MOVE ZERO TO LK-FULLWORD
           END-IF.

       FAKE-FREEADDRINFO.
           MOVE "F" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH EF-FREE-COUNT
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-2
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-3
           IF EF-FREE-FAILURES > ZERO
               SUBTRACT 1 FROM EF-FREE-FAILURES
               MOVE -1 TO LK-FULLWORD
           ELSE
               MOVE ZERO TO LK-FULLWORD
           END-IF.

       FAKE-SOCKET.
           MOVE "S" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-4
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-5
           MOVE 42 TO LK-FULLWORD.

       FAKE-CONNECT.
           MOVE "C" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH EF-CONNECT-COUNT
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-3
           IF EF-MODE = 7 AND EF-CONNECT-COUNT = 1
               MOVE 120 TO LK-FULLWORD
           ELSE
               MOVE ZERO TO LK-FULLWORD
           END-IF
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-4
           IF EF-MODE = 4 OR
              (EF-MODE = 7 AND EF-CONNECT-COUNT = 1)
               MOVE -1 TO LK-FULLWORD
           ELSE
               MOVE ZERO TO LK-FULLWORD
           END-IF.

       FAKE-IOCTL.
           MOVE "Q" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH
           MOVE LK-ARG-3(1:56) TO EF-QUERY-INPUT
           MOVE LOW-VALUES TO WS-TTLS-RAW
           SET TTLSI-BUFFERPTR TO NULL
           MOVE TTLS-VERSION1 TO TTLSI-VER
           MOVE TTLS-QUERY-ONLY TO TTLSI-REQ-TYPE
           MOVE FLAG-OFF TO EF-QUERY-VALID
           MOVE FLAG-ON TO EF-IOCTL-VALID
           SET ADDRESS OF LK-HALFWORD TO ADDRESS OF LK-ARG-1
           IF LK-HALFWORD NOT = 42
               MOVE FLAG-OFF TO EF-IOCTL-VALID
           END-IF
           SET ADDRESS OF LK-UNSIGNED TO ADDRESS OF LK-ARG-2
           IF LK-UNSIGNED NOT = SIOCTTLSCTL
               MOVE FLAG-OFF TO EF-IOCTL-VALID
           END-IF
           IF ADDRESS OF LK-ARG-3 = ADDRESS OF LK-ARG-4 AND
              LK-ARG-3(1:56) = WS-TTLS-RAW
               MOVE FLAG-ON TO EF-QUERY-VALID
           END-IF
           MOVE TTLS-POL-ENABLED TO TTLSI-STAT-POLICY
           MOVE TTLS-CONN-SECURE TO TTLSI-STAT-CONN
           MOVE TTLS-SEC-CLIENT TO TTLSI-SEC-TYPE
           EVALUATE EF-MODE
               WHEN 3
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "0000" TO TTLSI-NEG-CIPHER4
               WHEN 5
                   MOVE TTLS-PROT-TLSV1-2 TO TTLSI-SSL-PROT
                   MOVE "C02F" TO TTLSI-NEG-CIPHER4
               WHEN 8
                   MOVE 3 TO TTLSI-STAT-POLICY
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "1301" TO TTLSI-NEG-CIPHER4
               WHEN 9
                   MOVE 2 TO TTLSI-STAT-CONN
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "1301" TO TTLSI-NEG-CIPHER4
               WHEN 10
                   MOVE 2 TO TTLSI-SEC-TYPE
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "1301" TO TTLSI-NEG-CIPHER4
               WHEN 11
                   MOVE ZERO TO TTLSI-SSL-PROT
                   MOVE "1301" TO TTLSI-NEG-CIPHER4
               WHEN 12
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "0001" TO TTLSI-NEG-CIPHER4
               WHEN 13
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "0002" TO TTLSI-NEG-CIPHER4
               WHEN 14
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "003B" TO TTLSI-NEG-CIPHER4
               WHEN 15
                   MOVE TTLS-POL-APPLCNTRL TO TTLSI-STAT-POLICY
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "1301" TO TTLSI-NEG-CIPHER4
               WHEN 16
                   MOVE TTLS-PROT-TLSV1-2 TO TTLSI-SSL-PROT
                   MOVE "1301" TO TTLSI-NEG-CIPHER4
               WHEN 17
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "C02F" TO TTLSI-NEG-CIPHER4
               WHEN OTHER
                   MOVE TTLS-PROT-TLSV1-3 TO TTLSI-SSL-PROT
                   MOVE "1301" TO TTLSI-NEG-CIPHER4
           END-EVALUATE
           MOVE WS-TTLS-RAW TO LK-ARG-3(1:56)
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-5
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-6
           IF EF-MODE = 6
               MOVE -1 TO LK-FULLWORD
           ELSE
               MOVE ZERO TO LK-FULLWORD
           END-IF.

       FAKE-WRITE.
           MOVE "W" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH EF-WRITE-COUNT
           SET ADDRESS OF LK-UNSIGNED TO ADDRESS OF LK-ARG-2
           ADD LK-UNSIGNED TO EF-WRITTEN
           IF LK-UNSIGNED <= 16
               MOVE LK-ARG-3(1:LK-UNSIGNED) TO
                   EF-WRITE-BYTES(1:LK-UNSIGNED)
           ELSE
               MOVE LK-ARG-3(1:16) TO EF-WRITE-BYTES
           END-IF
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-4
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-5
           MOVE LK-UNSIGNED TO LK-FULLWORD.

       FAKE-READ.
           MOVE "R" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH EF-READ-COUNT
           MOVE X"58595A" TO LK-ARG-3(1:3)
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-4
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-5
           MOVE 3 TO LK-FULLWORD.

       FAKE-CLOSE.
           MOVE "X" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH EF-CLOSE-COUNT
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-2
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-3
           IF EF-CLOSE-FAILURES > ZERO
               SUBTRACT 1 FROM EF-CLOSE-FAILURES
               MOVE -1 TO LK-FULLWORD
           ELSE
               MOVE ZERO TO LK-FULLWORD
           END-IF.

       FAKE-TERMAPI.
           MOVE "T" TO EF-TRACE(EF-TRACE-LENGTH + 1:1)
           ADD 1 TO EF-TRACE-LENGTH EF-TERM-COUNT
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-1
           MOVE ZERO TO LK-FULLWORD
           SET ADDRESS OF LK-FULLWORD TO ADDRESS OF LK-ARG-2
           IF EF-TERM-FAILURES > ZERO
               SUBTRACT 1 FROM EF-TERM-FAILURES
               MOVE -1 TO LK-FULLWORD
           ELSE
               MOVE ZERO TO LK-FULLWORD
           END-IF.

       END PROGRAM EZASOKET.
