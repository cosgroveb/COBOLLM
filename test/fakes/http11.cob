       01  RESPONSE-AREA.
           05 RESPONSE-BYTE PIC X OCCURS 8388608 TIMES.
       01  BODY-AREA.
           05 BODY-BYTE PIC X OCCURS 16777216 TIMES.

       PROCEDURE DIVISION USING HTTP-PARM.
       MAIN.
           MOVE STATUS-OK TO HP-STATUS
           MOVE 0 TO HP-RESPONSE-LENGTH HP-HTTP-STATUS
           MOVE FLAG-OFF TO HP-PLAINTEXT
           IF HP-OPERATION NOT = HTTP-POST
             OR HP-BODY-PTR = NULL OR HP-BODY-LENGTH < 1
             OR HP-RESPONSE-PTR = NULL
               MOVE STATUS-HTTP TO HP-STATUS
               GOBACK
           END-IF
           SET ADDRESS OF BODY-AREA TO HP-BODY-PTR
           IF FH-BOUNDARY-MODE > 0
               ADD 1 TO FH-BOUNDARY-STEP
           END-IF
           IF FH-BOUNDARY-MODE = 0 OR FH-BOUNDARY-STEP = 1
               INITIALIZE JSON-PARM
               MOVE JSON-SKIP-VALUE TO JP-OPERATION
               SET JP-INPUT-PTR TO HP-BODY-PTR
               MOVE HP-BODY-LENGTH TO JP-INPUT-LENGTH
               MOVE 1 TO JP-CURSOR
               CALL "JSONSCAN" USING JSON-PARM
               COMPUTE BODY-END = HP-BODY-LENGTH + 1
               IF JP-STATUS NOT = STATUS-OK
                 OR JP-NEXT-CURSOR NOT = BODY-END
                   MOVE STATUS-HTTP TO HP-STATUS
                   GOBACK
               END-IF
           END-IF
           PERFORM VALIDATE-REQUEST
           IF HP-STATUS NOT = STATUS-OK
               GOBACK
           END-IF
           IF FH-BOUNDARY-MODE > 0
               PERFORM BUILD-BOUNDARY-RESPONSE
               IF HP-STATUS NOT = STATUS-OK GOBACK END-IF
               IF HP-RESPONSE-CAPACITY < OTHER-LENGTH
                   MOVE STATUS-CAPACITY TO HP-STATUS
               ELSE
                   SET ADDRESS OF RESPONSE-AREA TO HP-RESPONSE-PTR
                   MOVE RESPONSE-OTHER(1:OTHER-LENGTH)
                     TO RESPONSE-AREA(1:OTHER-LENGTH)
                   MOVE OTHER-LENGTH TO HP-RESPONSE-LENGTH
                   MOVE 200 TO HP-HTTP-STATUS
               END-IF
               GOBACK
           END-IF
           IF FH-SCHEMA-ENABLED = FLAG-ON
               IF FH-SCHEMA-LENGTH < 1 OR FH-SCHEMA-LENGTH > 1024
                   MOVE STATUS-HTTP TO HP-STATUS
                   GOBACK
               END-IF
               IF FH-EXPECT-CONTINUE NOT = FLAG-ON AND
                  FH-FULL-RESPONSE NOT = FLAG-ON
                   MOVE FH-SCHEMA-LENGTH TO SAVED-SCHEMA-LENGTH
                   MOVE FH-SCHEMA-ITEM(1:FH-SCHEMA-LENGTH)
                     TO SAVED-SCHEMA-ITEM(1:FH-SCHEMA-LENGTH)
               END-IF
               IF FH-FULL-RESPONSE = FLAG-ON
                   MOVE FH-SCHEMA-LENGTH TO OTHER-LENGTH
                   MOVE FH-SCHEMA-ITEM(1:FH-SCHEMA-LENGTH)
                     TO RESPONSE-OTHER(1:FH-SCHEMA-LENGTH)
               ELSE
               COMPUTE OTHER-LENGTH = FH-SCHEMA-LENGTH + 34
       MOVE X'7B22737461747573223A22636F6D706C65746564222C226F7574'
                 TO RESPONSE-OTHER(1:26)
               MOVE X'707574223A5B' TO RESPONSE-OTHER(27:6)
               MOVE FH-SCHEMA-ITEM(1:FH-SCHEMA-LENGTH)
                 TO RESPONSE-OTHER(33:FH-SCHEMA-LENGTH)
               COMPUTE CHECK-INDEX = FH-SCHEMA-LENGTH + 33
               IF FH-ADD-FINAL = FLAG-ON
                   MOVE X'2C' TO RESPONSE-OTHER(CHECK-INDEX:1)
                   ADD 1 TO CHECK-INDEX OTHER-LENGTH
                   PERFORM BUILD-SECOND
                   MOVE RESPONSE-TWO(33:157)
                     TO RESPONSE-OTHER(CHECK-INDEX:157)
                   ADD 157 TO CHECK-INDEX OTHER-LENGTH
               END-IF
               MOVE X'5D7D' TO RESPONSE-OTHER(CHECK-INDEX:2)
               END-IF
           ELSE
           ADD 1 TO CALL-COUNT
           EVALUATE CALL-COUNT
               WHEN 1
                   PERFORM BUILD-FIRST
                   MOVE 124 TO OTHER-LENGTH
                   MOVE RESPONSE-ONE TO RESPONSE-OTHER(1:124)
               WHEN 2
                   PERFORM BUILD-SECOND
                   MOVE 191 TO OTHER-LENGTH
                   MOVE RESPONSE-TWO TO RESPONSE-OTHER(1:191)
               WHEN 3 PERFORM BUILD-SCHEMA
               WHEN 4 PERFORM BUILD-BAD-ID
               WHEN 5 PERFORM BUILD-BAD-SUMMARY
               WHEN 6 PERFORM BUILD-BAD-ANNOTATIONS
               WHEN 7 PERFORM BUILD-BAD-LOGPROBS
               WHEN 8 PERFORM BUILD-BAD-CONTENT
               WHEN 9 PERFORM BUILD-BAD-ENCRYPTED
               WHEN 10 PERFORM BUILD-EMPTY-FINAL
               WHEN 11 PERFORM BUILD-PHASE
               WHEN 12 PERFORM BUILD-BAD-STATUS
               WHEN 13 PERFORM BUILD-BAD-ASYNC
               WHEN 14 PERFORM BUILD-BAD-TOOL
               WHEN 15 PERFORM BUILD-TWO-TOOLS
               WHEN 16 PERFORM BUILD-API-ERROR
               WHEN 17 PERFORM BUILD-BAD-TOP-STATUS
               WHEN 18
                   MOVE STATUS-HTTP-CODE TO HP-STATUS
                   MOVE 429 TO HP-HTTP-STATUS
                   GOBACK
               WHEN 19
                   MOVE STATUS-HTTP TO HP-STATUS
                   GOBACK
               WHEN 20
                   MOVE STATUS-RESPONSES TO HP-STATUS
                   GOBACK
               WHEN 21
                   MOVE STATUS-JSON TO HP-STATUS
                   GOBACK
               WHEN 22
                   MOVE STATUS-NETWORK TO HP-STATUS
                   GOBACK
               WHEN 23
                   MOVE STATUS-CAPACITY TO HP-STATUS
                   GOBACK
               WHEN 24
                   MOVE STATUS-INTERNAL TO HP-STATUS
                   GOBACK
               WHEN 25 PERFORM BUILD-LARGE-REPLAY
               WHEN 26
                   PERFORM BUILD-FIRST
                   MOVE 124 TO OTHER-LENGTH
                   MOVE RESPONSE-ONE TO RESPONSE-OTHER(1:124)
               WHEN 27
                   MOVE STATUS-NETWORK TO HP-STATUS
                   GOBACK
               WHEN 28
                   PERFORM BUILD-SECOND
                   MOVE 191 TO OTHER-LENGTH
                   MOVE RESPONSE-TWO TO RESPONSE-OTHER(1:191)
               WHEN 29
                   MOVE X'7B' TO RESPONSE-OTHER(1:1)
                   MOVE 1 TO OTHER-LENGTH
               WHEN 30 PERFORM BUILD-COMMAND-EXACT
               WHEN 31 PERFORM BUILD-COMMAND-OVERFLOW
               WHEN 32 PERFORM BUILD-FINAL-EXACT
               WHEN 33 PERFORM BUILD-FINAL-OVERFLOW
               WHEN 34 PERFORM BUILD-LARGE-COMMENTARY
               WHEN 35
                   PERFORM BUILD-SECOND
                   MOVE 191 TO OTHER-LENGTH
                   MOVE RESPONSE-TWO TO RESPONSE-OTHER(1:191)
               WHEN 36 PERFORM BUILD-PWD-FIRST
               WHEN 37 PERFORM BUILD-BAD-STATUS
               WHEN 38 PERFORM BUILD-PWD-FIRST
               WHEN 39
                   PERFORM BUILD-SECOND
                   MOVE 191 TO OTHER-LENGTH
                   MOVE RESPONSE-TWO TO RESPONSE-OTHER(1:191)
               WHEN 40 PERFORM BUILD-REFUSAL-FIRST
               WHEN 41
                   PERFORM BUILD-SECOND
                   MOVE 191 TO OTHER-LENGTH
                   MOVE RESPONSE-TWO TO RESPONSE-OTHER(1:191)
               WHEN 42 PERFORM BUILD-CALL-ID-LIMIT
               WHEN 43
                   PERFORM BUILD-SECOND
                   MOVE 191 TO OTHER-LENGTH
                   MOVE RESPONSE-TWO TO RESPONSE-OTHER(1:191)
               WHEN OTHER
                   MOVE STATUS-HTTP TO HP-STATUS
                   GOBACK
           END-EVALUATE
           END-IF
           IF HP-RESPONSE-CAPACITY < OTHER-LENGTH
               MOVE STATUS-CAPACITY TO HP-STATUS
           ELSE
               SET ADDRESS OF RESPONSE-AREA TO HP-RESPONSE-PTR
               MOVE RESPONSE-OTHER(1:OTHER-LENGTH)
                 TO RESPONSE-AREA(1:OTHER-LENGTH)
               MOVE OTHER-LENGTH TO HP-RESPONSE-LENGTH
               MOVE 200 TO HP-HTTP-STATUS
           END-IF
           GOBACK.

       VALIDATE-REQUEST.
           PERFORM BUILD-EXPECTED
           IF BODY-AREA(1:36) NOT = C-REQUEST-OPEN
             OR BODY-AREA(37:321) NOT = C-INSTRUCTIONS
             OR BODY-AREA(358:142) NOT = C-REQUEST-MIDDLE
             OR BODY-AREA(500:208) NOT = C-DESCRIPTION
             OR BODY-AREA(708:13) NOT = C-REQUEST-INPUT
               MOVE STATUS-HTTP TO HP-STATUS
               EXIT PARAGRAPH
           END-IF
           IF FH-BOUNDARY-MODE > 0
               PERFORM VALIDATE-BOUNDARY-REQUEST
           ELSE IF FH-SCHEMA-ENABLED = FLAG-ON
               IF FH-EXPECT-CONTINUE = FLAG-ON
                   PERFORM BUILD-EXTERNAL-CONTINUE
                   IF HP-BODY-LENGTH NOT = OTHER-LENGTH OR
                      BODY-AREA(1:OTHER-LENGTH) NOT =
                          RESPONSE-OTHER(1:OTHER-LENGTH)
                       MOVE STATUS-HTTP TO HP-STATUS
                   END-IF
               ELSE
                   IF HP-BODY-LENGTH NOT = 759
                     OR BODY-AREA(721:37) NOT = C-USER-ITEM
                     OR BODY-AREA(758:2) NOT = X'5D7D'
                       MOVE STATUS-HTTP TO HP-STATUS
                   END-IF
               END-IF
           ELSE IF CALL-COUNT = 1
               IF HP-BODY-LENGTH NOT = 1049561
                 OR BODY-AREA(721:37) NOT = C-USER-ITEM
                 OR BODY-AREA(758:1) NOT = X'2C'
                 OR BODY-AREA(759:77) NOT = C-TOOL-ITEM
                 OR BODY-AREA(836:1) NOT = X'2C'
                 OR BODY-AREA(837:145) NOT = C-RESULT-OPEN
                 OR BODY-AREA(1049558:2) NOT = X'227D'
                 OR BODY-AREA(1049560:2) NOT = X'5D7D'
                   MOVE STATUS-HTTP TO HP-STATUS
                   EXIT PARAGRAPH
               END-IF
               PERFORM VARYING CHECK-INDEX FROM 982 BY 1
                   UNTIL CHECK-INDEX > 1049557
                   IF BODY-AREA(CHECK-INDEX:1) NOT = X'78'
                       MOVE STATUS-HTTP TO HP-STATUS
                       EXIT PERFORM
                   END-IF
               END-PERFORM
           ELSE IF CALL-COUNT = 26
               IF HP-BODY-LENGTH NOT = 985
                 OR BODY-AREA(721:37) NOT = C-USER-ITEM
                 OR BODY-AREA(758:1) NOT = X'2C'
                 OR BODY-AREA(759:77) NOT = C-TOOL-ITEM
                 OR BODY-AREA(836:1) NOT = X'2C'
                 OR BODY-AREA(837:145) NOT = C-RESULT-OPEN
                 OR BODY-AREA(982:2) NOT = X'227D'
                 OR BODY-AREA(984:2) NOT = X'5D7D'
                   MOVE STATUS-HTTP TO HP-STATUS
               END-IF
           ELSE IF CALL-COUNT = 34
               PERFORM BUILD-QUOTED-EXPECTED
               IF HP-BODY-LENGTH NOT = 770 OR
                  BODY-AREA(1:770) NOT = RESPONSE-OTHER(1:770)
                   MOVE STATUS-HTTP TO HP-STATUS
               END-IF
           ELSE IF CALL-COUNT = 35 OR CALL-COUNT = 37
               PERFORM BUILD-PWD-EXPECTED-FIRST
               IF HP-BODY-LENGTH NOT = 757 OR
                  BODY-AREA(1:757) NOT = RESPONSE-OTHER(1:757)
                   MOVE STATUS-HTTP TO HP-STATUS
               END-IF
           ELSE IF CALL-COUNT = 36 OR CALL-COUNT = 38
               PERFORM BUILD-PWD-EXPECTED-CONTINUE
               IF HP-BODY-LENGTH NOT = 1037 OR
                  BODY-AREA(1:1037) NOT = RESPONSE-OTHER(1:1037)
                   MOVE STATUS-HTTP TO HP-STATUS
               END-IF
           ELSE IF CALL-COUNT = 40
               PERFORM BUILD-REFUSAL-CONTINUE
               IF HP-BODY-LENGTH NOT = 1136 OR
                  BODY-AREA(1:1136) NOT = RESPONSE-OTHER(1:1136)
                   MOVE STATUS-HTTP TO HP-STATUS
               END-IF
           ELSE
               IF HP-BODY-LENGTH NOT = 759
                 OR BODY-AREA(721:37) NOT = C-USER-ITEM
                 OR BODY-AREA(758:2) NOT = X'5D7D'
                   MOVE STATUS-HTTP TO HP-STATUS
               END-IF
           END-IF.

       VALIDATE-BOUNDARY-REQUEST.
           MOVE HP-BODY-LENGTH TO FH-BOUNDARY-ACTUAL
           EVALUATE FH-BOUNDARY-STEP
               WHEN 1
                   MOVE 759 TO BOUNDARY-EXPECTED
               WHEN 2
                   IF FH-BOUNDARY-MODE <= 3
                       MOVE 8389413 TO BOUNDARY-EXPECTED
                   ELSE
                       MOVE 8388913 TO BOUNDARY-EXPECTED
                   END-IF
               WHEN 3
                   EVALUATE FH-BOUNDARY-MODE
                       WHEN 4
                           COMPUTE BOUNDARY-EXPECTED =
                               LIMIT-HISTORY - 1
                       WHEN 5
                           MOVE LIMIT-HISTORY TO BOUNDARY-EXPECTED
                       WHEN OTHER
                           MOVE STATUS-HTTP TO HP-STATUS
                           EXIT PARAGRAPH
                   END-EVALUATE
               WHEN OTHER
                   MOVE STATUS-HTTP TO HP-STATUS
                   EXIT PARAGRAPH
           END-EVALUATE
           IF HP-BODY-LENGTH NOT = BOUNDARY-EXPECTED
             OR BODY-AREA(HP-BODY-LENGTH - 1:2) NOT = X'5D7D'
               MOVE STATUS-HTTP TO HP-STATUS
               EXIT PARAGRAPH
           END-IF
           IF FH-BOUNDARY-STEP = 1
             AND BODY-AREA(721:37) NOT = C-USER-ITEM
               MOVE STATUS-HTTP TO HP-STATUS
           END-IF.

       BUILD-BOUNDARY-RESPONSE.
           IF FH-BOUNDARY-MODE = 7
               PERFORM BUILD-LEGACY-FINAL
               EXIT PARAGRAPH
           END-IF
           IF FH-BOUNDARY-MODE = 8 OR FH-BOUNDARY-MODE = 9
               PERFORM BUILD-OVERSIZED-FINAL-TOOL
               EXIT PARAGRAPH
           END-IF
           IF FH-BOUNDARY-STEP = 3
               MOVE STATUS-NETWORK TO HP-STATUS
               EXIT PARAGRAPH
           END-IF
           IF FH-BOUNDARY-STEP = 1
               IF FH-BOUNDARY-MODE <= 3
                   MOVE 8388500 TO BOUNDARY-ITEM-LENGTH
               ELSE
                   MOVE 8388000 TO BOUNDARY-ITEM-LENGTH
               END-IF
           ELSE
               EVALUATE FH-BOUNDARY-MODE
                   WHEN 1 MOVE 8388523 TO BOUNDARY-ITEM-LENGTH
                   WHEN 2 MOVE 8388524 TO BOUNDARY-ITEM-LENGTH
                   WHEN 3 MOVE 8388525 TO BOUNDARY-ITEM-LENGTH
                   WHEN 4 MOVE 8388148 TO BOUNDARY-ITEM-LENGTH
                   WHEN 5 MOVE 8388149 TO BOUNDARY-ITEM-LENGTH
                   WHEN 6 MOVE 8388150 TO BOUNDARY-ITEM-LENGTH
                   WHEN OTHER
                       MOVE STATUS-HTTP TO HP-STATUS
                       EXIT PARAGRAPH
               END-EVALUATE
           END-IF
           COMPUTE OTHER-LENGTH = BOUNDARY-ITEM-LENGTH + 34
           COMPUTE BOUNDARY-PAD-LENGTH =
               BOUNDARY-ITEM-LENGTH - 79
           MOVE ALL X'61' TO RESPONSE-OTHER(110:BOUNDARY-PAD-LENGTH)
       MOVE X'7B22737461747573223A22636F6D706C65746564222C226F7574'
             TO RESPONSE-OTHER(1:26)
           MOVE X'707574223A5B' TO RESPONSE-OTHER(27:6)
       MOVE X'7B2274797065223A22637573746F6D5F746F6F6C5F63616C6C22'
