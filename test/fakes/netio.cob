       IDENTIFICATION DIVISION.
       PROGRAM-ID. NETIO.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       01  FAKE-RESET              PIC S9(9) COMP-5 VALUE 90.
       01  FAKE-CONFIGURE          PIC S9(9) COMP-5 VALUE 91.
       01  FAKE-QUERY              PIC S9(9) COMP-5 VALUE 92.
       01  WS-ACTIVE               PIC X VALUE X'00'.
       01  WS-AFTER-CLOSE          PIC X VALUE X'00'.
       01  WS-LIFECYCLE-OK         PIC X VALUE X'01'.
       01  WS-RESPONSE             PIC X(8388608).
       01  WS-RESPONSE-LENGTH      PIC S9(9) COMP-5 VALUE 0.
       01  WS-RESPONSE-POS         PIC S9(9) COMP-5 VALUE 0.
       01  WS-REQUEST              PIC X(16789504).
       01  WS-REQUEST-LENGTH       PIC S9(9) COMP-5 VALUE 0.
       01  WS-HOST                 PIC X(253).
       01  WS-HOST-LENGTH          PIC S9(9) COMP-5 VALUE 0.
       01  WS-VERIFY-HOST          PIC X(253).
       01  WS-VERIFY-LENGTH        PIC S9(9) COMP-5 VALUE 0.
       01  WS-OPEN-SCHEME          PIC S9(9) COMP-5 VALUE 0.
       01  WS-OPEN-PORT            PIC S9(9) COMP-5 VALUE 0.
       01  WS-READ-CHUNK           PIC S9(9) COMP-5 VALUE 65536.
       01  WS-WRITE-CHUNK          PIC S9(9) COMP-5 VALUE 65536.
       01  WS-FAIL-OP              PIC S9(9) COMP-5 VALUE 0.
       01  WS-FAIL-CALL            PIC S9(9) COMP-5 VALUE 1.
       01  WS-ZERO-WRITE-CALL      PIC S9(9) COMP-5 VALUE 0.
       01  WS-OPEN-COUNT           PIC S9(9) COMP-5 VALUE 0.
       01  WS-WRITE-COUNT          PIC S9(9) COMP-5 VALUE 0.
       01  WS-READ-COUNT           PIC S9(9) COMP-5 VALUE 0.
       01  WS-CLOSE-COUNT          PIC S9(9) COMP-5 VALUE 0.
       01  WS-COUNT                PIC S9(9) COMP-5.

       LINKAGE SECTION.
       COPY NETPARM.
       01  LK-BUFFER               PIC X(16789504).
       01  LK-CONNECT-HOST         PIC X(253).
       01  LK-VERIFY-HOST          PIC X(253).

       PROCEDURE DIVISION USING NET-PARM.
           MOVE STATUS-INTERNAL TO NP-STATUS
           IF NP-OPERATION = FAKE-RESET
               PERFORM RESET-FAKE
               MOVE STATUS-OK TO NP-STATUS
               GOBACK
           END-IF
           IF NP-OPERATION = FAKE-CONFIGURE
               PERFORM CONFIGURE-FAKE
               GOBACK
           END-IF
           IF NP-OPERATION = FAKE-QUERY
               PERFORM QUERY-FAKE
               GOBACK
           END-IF
           MOVE ZERO TO NP-TRANSFERRED
           MOVE FLAG-OFF TO NP-EOF
           IF WS-AFTER-CLOSE = FLAG-ON AND
              NP-OPERATION NOT = NET-CLOSE
               MOVE FLAG-OFF TO WS-LIFECYCLE-OK
           END-IF
           EVALUATE NP-OPERATION
               WHEN NET-OPEN
                   PERFORM OPEN-FAKE
               WHEN NET-WRITE
                   PERFORM WRITE-FAKE
               WHEN NET-READ
                   PERFORM READ-FAKE
               WHEN NET-CLOSE
                   PERFORM CLOSE-FAKE
               WHEN OTHER
                   CONTINUE
           END-EVALUATE
           GOBACK.

       RESET-FAKE.
           MOVE LOW-VALUES TO WS-RESPONSE WS-REQUEST
           MOVE SPACES TO WS-HOST WS-VERIFY-HOST
           MOVE ZERO TO WS-RESPONSE-LENGTH WS-RESPONSE-POS
           MOVE ZERO TO WS-REQUEST-LENGTH WS-HOST-LENGTH
           MOVE ZERO TO WS-VERIFY-LENGTH WS-OPEN-SCHEME
           MOVE ZERO TO WS-OPEN-PORT WS-FAIL-OP
           MOVE ZERO TO WS-ZERO-WRITE-CALL WS-OPEN-COUNT
           MOVE ZERO TO WS-WRITE-COUNT WS-READ-COUNT
           MOVE ZERO TO WS-CLOSE-COUNT
           MOVE 65536 TO WS-READ-CHUNK WS-WRITE-CHUNK
           MOVE 1 TO WS-FAIL-CALL
           MOVE FLAG-OFF TO WS-ACTIVE WS-AFTER-CLOSE
           MOVE FLAG-ON TO WS-LIFECYCLE-OK.

       CONFIGURE-FAKE.
           IF NP-BUFFER-PTR = NULL OR NP-REQUEST-LENGTH < ZERO OR
              NP-REQUEST-LENGTH > 8388608 OR
              NP-BUFFER-CAPACITY < 1 OR
              NP-BUFFER-CAPACITY > 65536 OR
              NP-TRANSFERRED < 1 OR NP-TRANSFERRED > 65536
               EXIT PARAGRAPH
           END-IF
           PERFORM RESET-FAKE
           SET ADDRESS OF LK-BUFFER TO NP-BUFFER-PTR
           MOVE NP-REQUEST-LENGTH TO WS-RESPONSE-LENGTH
           IF WS-RESPONSE-LENGTH > ZERO
               MOVE LK-BUFFER(1:WS-RESPONSE-LENGTH) TO
                   WS-RESPONSE(1:WS-RESPONSE-LENGTH)
           END-IF
           MOVE NP-BUFFER-CAPACITY TO WS-READ-CHUNK
           MOVE NP-TRANSFERRED TO WS-WRITE-CHUNK
           MOVE NP-SCHEME TO WS-FAIL-OP
           IF NP-PORT > ZERO
               MOVE NP-PORT TO WS-FAIL-CALL
           END-IF
           MOVE NP-CONNECT-HOST-LENGTH TO WS-ZERO-WRITE-CALL
           MOVE STATUS-OK TO NP-STATUS.

       QUERY-FAKE.
           IF NP-BUFFER-PTR = NULL OR NP-BUFFER-CAPACITY < ZERO OR
              NP-CONNECT-HOST-PTR = NULL OR
              NP-CONNECT-HOST-LENGTH < ZERO OR
              NP-VERIFY-HOST-PTR = NULL OR
              NP-VERIFY-HOST-LENGTH < ZERO
               EXIT PARAGRAPH
           END-IF
           IF NP-BUFFER-CAPACITY < WS-REQUEST-LENGTH OR
              NP-CONNECT-HOST-LENGTH < WS-HOST-LENGTH OR
              NP-VERIFY-HOST-LENGTH < WS-VERIFY-LENGTH
               MOVE STATUS-CAPACITY TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           SET ADDRESS OF LK-BUFFER TO NP-BUFFER-PTR
           SET ADDRESS OF LK-CONNECT-HOST TO NP-CONNECT-HOST-PTR
           SET ADDRESS OF LK-VERIFY-HOST TO NP-VERIFY-HOST-PTR
           IF WS-REQUEST-LENGTH > ZERO
               MOVE WS-REQUEST(1:WS-REQUEST-LENGTH) TO
                   LK-BUFFER(1:WS-REQUEST-LENGTH)
           END-IF
           IF WS-HOST-LENGTH > ZERO
               MOVE WS-HOST(1:WS-HOST-LENGTH) TO
                   LK-CONNECT-HOST(1:WS-HOST-LENGTH)
           END-IF
           IF WS-VERIFY-LENGTH > ZERO
               MOVE WS-VERIFY-HOST(1:WS-VERIFY-LENGTH) TO
                   LK-VERIFY-HOST(1:WS-VERIFY-LENGTH)
           END-IF
           MOVE WS-REQUEST-LENGTH TO NP-REQUEST-LENGTH
           MOVE WS-HOST-LENGTH TO NP-CONNECT-HOST-LENGTH
           MOVE WS-VERIFY-LENGTH TO NP-VERIFY-HOST-LENGTH
           MOVE WS-OPEN-SCHEME TO NP-SCHEME
           MOVE WS-OPEN-PORT TO NP-PORT
           MOVE WS-CLOSE-COUNT TO NP-TRANSFERRED
           IF WS-LIFECYCLE-OK = FLAG-ON AND WS-OPEN-COUNT = 1 AND
              WS-CLOSE-COUNT = 1 AND WS-ACTIVE = FLAG-OFF
               MOVE FLAG-ON TO NP-EOF
           ELSE
               MOVE FLAG-OFF TO NP-EOF
           END-IF
           MOVE STATUS-OK TO NP-STATUS.

       OPEN-FAKE.
           ADD 1 TO WS-OPEN-COUNT
           IF WS-ACTIVE = FLAG-ON OR NP-CONNECT-HOST-PTR = NULL OR
              NP-VERIFY-HOST-PTR = NULL OR
              NP-CONNECT-HOST-LENGTH < 1 OR
              NP-CONNECT-HOST-LENGTH > 253 OR
              NP-VERIFY-HOST-LENGTH < 1 OR
              NP-VERIFY-HOST-LENGTH > 253 OR NP-PORT < 1 OR
              NP-PORT > 65535 OR
              (NP-SCHEME NOT = NET-PLAINTEXT AND
               NP-SCHEME NOT = NET-TLS)
               MOVE FLAG-OFF TO WS-LIFECYCLE-OK
               EXIT PARAGRAPH
           END-IF
           IF WS-FAIL-OP = NET-OPEN AND
              WS-OPEN-COUNT = WS-FAIL-CALL
               MOVE STATUS-NETWORK TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           SET ADDRESS OF LK-CONNECT-HOST TO NP-CONNECT-HOST-PTR
           SET ADDRESS OF LK-VERIFY-HOST TO NP-VERIFY-HOST-PTR
           MOVE NP-CONNECT-HOST-LENGTH TO WS-HOST-LENGTH
           MOVE LK-CONNECT-HOST(1:WS-HOST-LENGTH) TO
               WS-HOST(1:WS-HOST-LENGTH)
           MOVE NP-VERIFY-HOST-LENGTH TO WS-VERIFY-LENGTH
           MOVE LK-VERIFY-HOST(1:WS-VERIFY-LENGTH) TO
               WS-VERIFY-HOST(1:WS-VERIFY-LENGTH)
           MOVE NP-SCHEME TO WS-OPEN-SCHEME
           MOVE NP-PORT TO WS-OPEN-PORT
           MOVE FLAG-ON TO WS-ACTIVE
           MOVE STATUS-OK TO NP-STATUS.

       WRITE-FAKE.
           ADD 1 TO WS-WRITE-COUNT
           IF WS-ACTIVE = FLAG-OFF OR NP-BUFFER-PTR = NULL OR
              NP-REQUEST-LENGTH < ZERO OR NP-BUFFER-CAPACITY <
              NP-REQUEST-LENGTH OR
              NP-REQUEST-LENGTH > LIMIT-NET-CHUNK OR
              NP-BUFFER-CAPACITY > LIMIT-NET-CHUNK
               MOVE FLAG-OFF TO WS-LIFECYCLE-OK
               EXIT PARAGRAPH
           END-IF
           IF WS-FAIL-OP = NET-WRITE AND
              WS-WRITE-COUNT = WS-FAIL-CALL
               MOVE STATUS-NETWORK TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           IF WS-WRITE-COUNT = WS-ZERO-WRITE-CALL
               MOVE STATUS-OK TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           MOVE NP-REQUEST-LENGTH TO WS-COUNT
           IF WS-COUNT > WS-WRITE-CHUNK
               MOVE WS-WRITE-CHUNK TO WS-COUNT
           END-IF
           IF WS-REQUEST-LENGTH > 16789504 - WS-COUNT
               MOVE STATUS-CAPACITY TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           SET ADDRESS OF LK-BUFFER TO NP-BUFFER-PTR
           IF WS-COUNT > ZERO
               MOVE LK-BUFFER(1:WS-COUNT) TO
                   WS-REQUEST(WS-REQUEST-LENGTH + 1:WS-COUNT)
           END-IF
           ADD WS-COUNT TO WS-REQUEST-LENGTH
           MOVE WS-COUNT TO NP-TRANSFERRED
           MOVE STATUS-OK TO NP-STATUS.

       READ-FAKE.
           ADD 1 TO WS-READ-COUNT
           IF WS-ACTIVE = FLAG-OFF OR NP-BUFFER-PTR = NULL OR
              NP-BUFFER-CAPACITY < ZERO
               MOVE FLAG-OFF TO WS-LIFECYCLE-OK
               EXIT PARAGRAPH
           END-IF
           IF WS-FAIL-OP = NET-READ AND
              WS-READ-COUNT = WS-FAIL-CALL
               MOVE STATUS-NETWORK TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           IF WS-RESPONSE-POS >= WS-RESPONSE-LENGTH
               MOVE FLAG-ON TO NP-EOF
               MOVE STATUS-OK TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           COMPUTE WS-COUNT = WS-RESPONSE-LENGTH - WS-RESPONSE-POS
           IF WS-COUNT > WS-READ-CHUNK
               MOVE WS-READ-CHUNK TO WS-COUNT
           END-IF
           IF WS-COUNT > NP-BUFFER-CAPACITY
               MOVE NP-BUFFER-CAPACITY TO WS-COUNT
           END-IF
           IF WS-COUNT = ZERO
               MOVE STATUS-OK TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           SET ADDRESS OF LK-BUFFER TO NP-BUFFER-PTR
           MOVE WS-RESPONSE(WS-RESPONSE-POS + 1:WS-COUNT) TO
               LK-BUFFER(1:WS-COUNT)
           ADD WS-COUNT TO WS-RESPONSE-POS
           MOVE WS-COUNT TO NP-TRANSFERRED
           IF WS-RESPONSE-POS = WS-RESPONSE-LENGTH
               MOVE FLAG-ON TO NP-EOF
           END-IF
           MOVE STATUS-OK TO NP-STATUS.

       CLOSE-FAKE.
           ADD 1 TO WS-CLOSE-COUNT
           IF WS-ACTIVE = FLAG-OFF
               MOVE FLAG-OFF TO WS-LIFECYCLE-OK
               EXIT PARAGRAPH
           END-IF
           MOVE FLAG-OFF TO WS-ACTIVE
           MOVE FLAG-ON TO WS-AFTER-CLOSE
           IF WS-FAIL-OP = NET-CLOSE AND
              WS-CLOSE-COUNT = WS-FAIL-CALL
               MOVE STATUS-NETWORK TO NP-STATUS
               EXIT PARAGRAPH
           END-IF
           MOVE STATUS-OK TO NP-STATUS.

       END PROGRAM NETIO.
