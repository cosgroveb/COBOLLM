       IDENTIFICATION DIVISION.
       PROGRAM-ID. NATUTF8.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.

       LINKAGE SECTION.
       COPY TXTPARM.
       01  TP-IN                   PIC X(16777216) BASED.
       01  TP-OUT                  PIC X(16777216) BASED.

       PROCEDURE DIVISION USING TEXT-PARM.
           MOVE STATUS-INTERNAL TO TP-STATUS
           MOVE ZERO TO TP-OUTPUT-LENGTH
           MOVE FLAG-OFF TO TP-REPLACED TP-TRUNCATED
           IF TP-INPUT-PTR = NULL OR TP-OUTPUT-PTR = NULL OR
              TP-INPUT-LENGTH < ZERO OR TP-OUTPUT-CAPACITY < ZERO
               GOBACK
           END-IF
           SET ADDRESS OF TP-IN TO TP-INPUT-PTR
           SET ADDRESS OF TP-OUT TO TP-OUTPUT-PTR
           EVALUATE TP-OPERATION
               WHEN TEXT-NATIVE-STRICT
               WHEN TEXT-NATIVE-REPLACE
                   PERFORM NATIVE-TO-UTF8
               WHEN TEXT-UTF8-STRICT
               WHEN TEXT-UTF8-REPLACE
                   PERFORM UTF8-TO-NATIVE
           END-EVALUATE
           GOBACK.

       NATIVE-TO-UTF8.
           EVALUATE TRUE
               WHEN TP-INPUT-LENGTH = 11 AND
                    TP-IN(1:11) = "test-secret"
                   PERFORM RETURN-TEST-SECRET
               WHEN TP-INPUT-LENGTH = 8 AND
                    TP-IN(1:8) = "gpt-test"
                   PERFORM RETURN-GPT-TEST
               WHEN TP-INPUT-LENGTH = 15 AND
                    TP-IN(1:15) = "https://example"
                   PERFORM RETURN-URL
               WHEN TP-INPUT-LENGTH = 5 AND TP-IN(1:5) = "do it"
                   PERFORM RETURN-TASK
               WHEN TP-INPUT-LENGTH = 12 AND
                    TP-IN(1:12) = "shell output"
                   PERFORM RETURN-SHELL-OUTPUT
               WHEN TP-INPUT-LENGTH = 65534 AND TP-IN(1:1) = "t"
                   PERFORM RETURN-LONG-TASK
               WHEN TP-INPUT-LENGTH = 255 AND TP-IN(1:1) = "m"
                   PERFORM RETURN-LONG-MODEL
               WHEN TP-INPUT-LENGTH = 8191 AND TP-IN(1:1) = "k"
                   PERFORM RETURN-LONG-KEY
               WHEN TP-INPUT-LENGTH = 2047 AND
                    TP-IN(1:16) = "https://example/"
                   PERFORM RETURN-LONG-URL
               WHEN TP-OPERATION = TEXT-NATIVE-REPLACE AND
                    TP-INPUT-LENGTH = 1 AND TP-IN(1:1) = X"C0"
                   PERFORM RETURN-LOSS
           END-EVALUATE.

       UTF8-TO-NATIVE.
           EVALUATE TRUE
               WHEN TP-INPUT-LENGTH = 9 AND TP-IN(1:9) =
                    X"7072696E7466206F6B"
                   PERFORM RETURN-NATIVE-COMMAND
               WHEN TP-INPUT-LENGTH = 10 AND TP-IN(1:10) =
                    X"6167656E7420646F6E65"
                   PERFORM RETURN-NATIVE-FINAL
               WHEN TP-INPUT-LENGTH = 6 AND TP-IN(1:6) =
                    X"41F09F988042" AND
                    TP-OPERATION = TEXT-UTF8-REPLACE
                   PERFORM RETURN-NATIVE-REPLACED
               WHEN TP-INPUT-LENGTH = 3 AND TP-IN(1:3) = X"EFBFBD"
                    AND TP-OPERATION = TEXT-UTF8-REPLACE
                   PERFORM RETURN-NATIVE-QUESTION
               WHEN TP-INPUT-LENGTH = 4 AND TP-IN(1:4) = X"F09F9880"
                    AND TP-OPERATION = TEXT-UTF8-STRICT
                   MOVE STATUS-TEXT-INVALID TO TP-STATUS
           END-EVALUATE.

       RETURN-TEST-SECRET.
           IF TP-OUTPUT-CAPACITY < 11 EXIT PARAGRAPH END-IF
           MOVE X"746573742D736563726574" TO TP-OUT(1:11)
           MOVE 11 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-GPT-TEST.
           IF TP-OUTPUT-CAPACITY < 8 EXIT PARAGRAPH END-IF
           MOVE X"6770742D74657374" TO TP-OUT(1:8)
           MOVE 8 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-URL.
           IF TP-OUTPUT-CAPACITY < 15 EXIT PARAGRAPH END-IF
           MOVE X"68747470733A2F2F6578616D706C65" TO TP-OUT(1:15)
           MOVE 15 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-TASK.
           IF TP-OUTPUT-CAPACITY < 5 EXIT PARAGRAPH END-IF
           MOVE X"646F206974" TO TP-OUT(1:5)
           MOVE 5 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-SHELL-OUTPUT.
           IF TP-OUTPUT-CAPACITY < 12 EXIT PARAGRAPH END-IF
           MOVE X"7368656C6C206F7574707574" TO TP-OUT(1:12)
           MOVE 12 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-LONG-TASK.
           IF TP-OUTPUT-CAPACITY < 65534 EXIT PARAGRAPH END-IF
           MOVE ALL X"74" TO TP-OUT(1:65534)
           MOVE 65534 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-LONG-MODEL.
           IF TP-OUTPUT-CAPACITY < 255 EXIT PARAGRAPH END-IF
           MOVE ALL X"6D" TO TP-OUT(1:255)
           MOVE 255 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-LONG-KEY.
           IF TP-OUTPUT-CAPACITY < 8191 EXIT PARAGRAPH END-IF
           MOVE ALL X"6B" TO TP-OUT(1:8191)
           MOVE 8191 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-LONG-URL.
           IF TP-OUTPUT-CAPACITY < 2047 EXIT PARAGRAPH END-IF
           MOVE X"68747470733A2F2F6578616D706C652F" TO TP-OUT(1:16)
           MOVE ALL X"61" TO TP-OUT(17:2031)
           MOVE 2047 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-LOSS.
           IF TP-OUTPUT-CAPACITY < 3 EXIT PARAGRAPH END-IF
           MOVE X"EFBFBD" TO TP-OUT(1:3)
           MOVE 3 TO TP-OUTPUT-LENGTH
           MOVE FLAG-ON TO TP-REPLACED
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-NATIVE-COMMAND.
           IF TP-OUTPUT-CAPACITY < 9 EXIT PARAGRAPH END-IF
           MOVE "printf ok" TO TP-OUT(1:9)
           MOVE 9 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-NATIVE-FINAL.
           IF TP-OUTPUT-CAPACITY < 10 EXIT PARAGRAPH END-IF
           MOVE "agent done" TO TP-OUT(1:10)
           MOVE 10 TO TP-OUTPUT-LENGTH
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-NATIVE-REPLACED.
           IF TP-OUTPUT-CAPACITY < 3 EXIT PARAGRAPH END-IF
           MOVE X"C16FC2" TO TP-OUT(1:3)
           MOVE 3 TO TP-OUTPUT-LENGTH
           MOVE FLAG-ON TO TP-REPLACED
           MOVE STATUS-OK TO TP-STATUS.

       RETURN-NATIVE-QUESTION.
           IF TP-OUTPUT-CAPACITY < 1 EXIT PARAGRAPH END-IF
           MOVE X"6F" TO TP-OUT(1:1)
           MOVE 1 TO TP-OUTPUT-LENGTH
           MOVE FLAG-ON TO TP-REPLACED
           MOVE STATUS-OK TO TP-STATUS.

       END PROGRAM NATUTF8.
