       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTSHELL.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY SHLPARM.
       COPY OUTPARM.
       01 WS-COMMAND              PIC X(65536).
       01 WS-OUTPUT               PIC X(1048576).
       01 WS-SAVED-OUTPUT         PIC X(4096).
       01 WS-SAVED-LENGTH         PIC S9(9) COMP-5 VALUE ZERO.
       01 WS-COMMAND-LENGTH       PIC S9(9) COMP-5 VALUE ZERO.
       01 WS-OUTPUT-PROBE         PIC X(10) VALUE
           X"4F5554505554204F4B0A".
       01 WS-NATIVE-RESULT        PIC S9(9) COMP-5.
       01 WS-FAILURES             PIC S9(9) COMP-5 VALUE ZERO.
       01 WS-SAVED-COMMAND-PTR    USAGE POINTER.
       01 WS-SAVED-OUTPUT-PTR     USAGE POINTER.
       01 WS-SAVED-COMMAND-LEN    PIC S9(9) COMP-5.
       01 WS-SAVED-CAPACITY       PIC S9(9) COMP-5.
       01 WS-SAVED-FD             PIC S9(9) COMP-5.
       01 WS-READ-FD              PIC S9(9) COMP-5 VALUE -1.
       01 WS-WRITE-FD             PIC S9(9) COMP-5 VALUE -1.
       01 WS-STDERR-FD            PIC S9(9) COMP-5 VALUE 2.
       01 WS-CAPTURE              PIC X(32).
       01 WS-READ-LENGTH          PIC S9(9) COMP-5 VALUE 10.
       01 WS-SAVED-BUFFER-LEN     PIC S9(9) COMP-5.
       01 WS-BOUNDARY-CASE        PIC S9(9) COMP-5.
       01 WS-EXPECTED-OUTPUT-LEN  PIC S9(9) COMP-5.
       01 WS-EXPECTED-TRUNCATED   PIC X.
       01 WS-KEY-NAME.
           05 FILLER PIC X(14) VALUE "OPENAI_API_KEY".
           05 FILLER PIC X VALUE LOW-VALUE.
       01 WS-SENTINEL-NAME.
           05 FILLER PIC X(16) VALUE "COBOLLM_SENTINEL".
           05 FILLER PIC X VALUE LOW-VALUE.
       01 WS-KEY-VALUE.
           05 FILLER PIC X(6) VALUE "secret".
           05 FILLER PIC X VALUE LOW-VALUE.
       01 WS-SENTINEL-VALUE.
           05 FILLER PIC X(4) VALUE "keep".
           05 FILLER PIC X VALUE LOW-VALUE.
       01 WS-OVERWRITE            PIC S9(9) COMP-5 VALUE 1.

       PROCEDURE DIVISION.
           MOVE "printf out; printf err >&2; exit 7" TO WS-COMMAND
           MOVE 35 TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-EXIT OR
              SP-EXIT-CODE NOT = 7 OR
              SP-OUTPUT-LENGTH NOT = 6 OR
              WS-OUTPUT(1:6) NOT = "outerr"
               ADD 1 TO WS-FAILURES
           END-IF

           MOVE SPACES TO WS-COMMAND
           MOVE ZERO TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-EXIT OR
              SP-EXIT-CODE NOT = ZERO OR
              SP-OUTPUT-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF

           MOVE SPACES TO WS-COMMAND
           MOVE ":" TO WS-COMMAND(1:1)
           MOVE 65535 TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-EXIT OR
              SP-EXIT-CODE NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF

           MOVE 65536 TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-INTERNAL OR
              SP-OUTPUT-LENGTH NOT = ZERO OR
              SP-TRUNCATED NOT = FLAG-OFF
               ADD 1 TO WS-FAILURES
           END-IF

           PERFORM TEST-OUTPUT-BOUNDARIES

           MOVE SPACES TO WS-COMMAND
           MOVE "kill -TERM $$" TO WS-COMMAND
           MOVE 13 TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-SIGNAL OR
              SP-SIGNAL NOT = 15
               ADD 1 TO WS-FAILURES
           END-IF

           MOVE SPACES TO WS-COMMAND
           MOVE "pwd" TO WS-COMMAND
           MOVE 3 TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           MOVE SP-OUTPUT-LENGTH TO WS-SAVED-LENGTH
           MOVE WS-OUTPUT(1:WS-SAVED-LENGTH) TO
               WS-SAVED-OUTPUT(1:WS-SAVED-LENGTH)
           MOVE SPACES TO WS-COMMAND
           MOVE "cd /; COBOLLM_EPHEMERAL=lost; export " TO WS-COMMAND
           MOVE "COBOLLM_EPHEMERAL" TO WS-COMMAND(38:18)
           MOVE 55 TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           MOVE SPACES TO WS-COMMAND
           MOVE 'pwd; test -z "${COBOLLM_EPHEMERAL+x}"'
             TO WS-COMMAND
           MOVE 37 TO WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-EXIT OR
              SP-EXIT-CODE NOT = ZERO OR
              SP-OUTPUT-LENGTH NOT = WS-SAVED-LENGTH OR
              WS-OUTPUT(1:WS-SAVED-LENGTH) NOT =
                  WS-SAVED-OUTPUT(1:WS-SAVED-LENGTH)
               ADD 1 TO WS-FAILURES
           END-IF

           PERFORM TEST-SHELL-CONTRACTS
           PERFORM TEST-CHILD-ENVIRONMENT
           PERFORM TEST-OUTPUT-CONTRACTS
           PERFORM TEST-REAL-OUTPUT

           IF WS-FAILURES = ZERO
               DISPLAY "PASS SHELL"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL SHELL"
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       TEST-OUTPUT-BOUNDARIES.
           PERFORM VARYING WS-BOUNDARY-CASE FROM 1 BY 1
               UNTIL WS-BOUNDARY-CASE > 3
               MOVE SPACES TO WS-COMMAND
               MOVE FLAG-OFF TO WS-EXPECTED-TRUNCATED
               EVALUATE WS-BOUNDARY-CASE
                   WHEN 1
                       MOVE "yes x | head -c 1048575" TO WS-COMMAND
                       MOVE 1048575 TO WS-EXPECTED-OUTPUT-LEN
                   WHEN 2
                       MOVE "yes x | head -c 1048576" TO WS-COMMAND
                       MOVE 1048576 TO WS-EXPECTED-OUTPUT-LEN
                   WHEN 3
                       MOVE "yes x | head -c 1048577" TO WS-COMMAND
                       MOVE 1048576 TO WS-EXPECTED-OUTPUT-LEN
                       MOVE FLAG-ON TO WS-EXPECTED-TRUNCATED
               END-EVALUATE
               MOVE 23 TO WS-COMMAND-LENGTH
               PERFORM RUN-COMMAND
               IF SP-STATUS NOT = STATUS-OK OR
                  SP-RESULT-KIND NOT = SHELL-EXIT OR
                  SP-EXIT-CODE NOT = ZERO OR
                  SP-OUTPUT-LENGTH NOT = WS-EXPECTED-OUTPUT-LEN OR
                  SP-TRUNCATED NOT = WS-EXPECTED-TRUNCATED
                   ADD 1 TO WS-FAILURES
               END-IF
           END-PERFORM.

       TEST-SHELL-CONTRACTS.
           PERFORM SET-VALID-SHELL
           SET SP-COMMAND-PTR TO NULL
           PERFORM EXPECT-SHELL-CONTRACT
           PERFORM SET-VALID-SHELL
           SET SP-OUTPUT-PTR TO NULL
           PERFORM EXPECT-SHELL-CONTRACT
           PERFORM SET-VALID-SHELL
           MOVE -1 TO SP-COMMAND-LENGTH
           PERFORM EXPECT-SHELL-CONTRACT
           PERFORM SET-VALID-SHELL
           MOVE 65536 TO SP-COMMAND-LENGTH
           PERFORM EXPECT-SHELL-CONTRACT
           PERFORM SET-VALID-SHELL
           MOVE -1 TO SP-OUTPUT-CAPACITY
           PERFORM EXPECT-SHELL-CONTRACT
           PERFORM SET-VALID-SHELL
           MOVE 1048577 TO SP-OUTPUT-CAPACITY
           PERFORM EXPECT-SHELL-CONTRACT
           PERFORM SET-VALID-SHELL
           MOVE ZERO TO SP-OUTPUT-CAPACITY
           CALL "SHELL" USING SHELL-PARM
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-EXIT OR
              SP-EXIT-CODE NOT = ZERO OR
              SP-SIGNAL NOT = ZERO OR
              SP-OUTPUT-LENGTH NOT = ZERO OR
              SP-TRUNCATED NOT = FLAG-ON
               ADD 1 TO WS-FAILURES
           END-IF.

       SET-VALID-SHELL.
           MOVE "printf x" TO WS-COMMAND(1:8)
           INITIALIZE SHELL-PARM
           SET SP-COMMAND-PTR TO ADDRESS OF WS-COMMAND
           MOVE 8 TO SP-COMMAND-LENGTH
           SET SP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           MOVE 16 TO SP-OUTPUT-CAPACITY.

       EXPECT-SHELL-CONTRACT.
           SET WS-SAVED-COMMAND-PTR TO SP-COMMAND-PTR
           MOVE SP-COMMAND-LENGTH TO WS-SAVED-COMMAND-LEN
           SET WS-SAVED-OUTPUT-PTR TO SP-OUTPUT-PTR
           MOVE SP-OUTPUT-CAPACITY TO WS-SAVED-CAPACITY
           MOVE 999 TO SP-STATUS SP-OUTPUT-LENGTH SP-RESULT-KIND
               SP-EXIT-CODE SP-SIGNAL
           MOVE X'FF' TO SP-TRUNCATED
           CALL "SHELL" USING SHELL-PARM
           IF SP-STATUS NOT = STATUS-INTERNAL OR
              SP-OUTPUT-LENGTH NOT = ZERO OR
              SP-RESULT-KIND NOT = ZERO OR
              SP-EXIT-CODE NOT = ZERO OR SP-SIGNAL NOT = ZERO OR
              SP-TRUNCATED NOT = FLAG-OFF OR
              SP-COMMAND-PTR NOT = WS-SAVED-COMMAND-PTR OR
              SP-COMMAND-LENGTH NOT = WS-SAVED-COMMAND-LEN OR
              SP-OUTPUT-PTR NOT = WS-SAVED-OUTPUT-PTR OR
              SP-OUTPUT-CAPACITY NOT = WS-SAVED-CAPACITY
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-OUTPUT-CONTRACTS.
           PERFORM SET-VALID-OUTPUT
           MOVE ZERO TO OP-FILE-DESCRIPTOR
           PERFORM EXPECT-OUTPUT-CONTRACT
           PERFORM SET-VALID-OUTPUT
           MOVE 3 TO OP-FILE-DESCRIPTOR
           PERFORM EXPECT-OUTPUT-CONTRACT
           PERFORM SET-VALID-OUTPUT
           SET OP-BUFFER-PTR TO NULL
           PERFORM EXPECT-OUTPUT-CONTRACT
           PERFORM SET-VALID-OUTPUT
           SET OP-BUFFER-PTR TO NULL
           MOVE ZERO TO OP-BUFFER-LENGTH
           MOVE 999 TO OP-STATUS OP-WRITTEN
           CALL "OUTPUT" USING OUTPUT-PARM
           IF OP-STATUS NOT = STATUS-OK OR OP-WRITTEN NOT = ZERO OR
              OP-FILE-DESCRIPTOR NOT = OUTPUT-STDERR OR
              OP-BUFFER-PTR NOT = NULL OR
              OP-BUFFER-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           PERFORM SET-VALID-OUTPUT
           MOVE -1 TO OP-BUFFER-LENGTH
           PERFORM EXPECT-OUTPUT-CONTRACT
           PERFORM SET-VALID-OUTPUT
           MOVE ZERO TO OP-BUFFER-LENGTH
           MOVE 999 TO OP-STATUS OP-WRITTEN
           CALL "OUTPUT" USING OUTPUT-PARM
           IF OP-STATUS NOT = STATUS-OK OR OP-WRITTEN NOT = ZERO OR
              OP-FILE-DESCRIPTOR NOT = OUTPUT-STDERR OR
              OP-BUFFER-PTR NOT = ADDRESS OF WS-OUTPUT-PROBE OR
              OP-BUFFER-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-REAL-OUTPUT.
           MOVE LOW-VALUES TO WS-CAPTURE
           CALL "TSTPIPE" USING BY REFERENCE WS-READ-FD WS-WRITE-FD
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
               EXIT PARAGRAPH
           END-IF
           CALL "TSTDUP" USING BY REFERENCE WS-STDERR-FD
               RETURNING WS-SAVED-FD
           IF WS-SAVED-FD < ZERO
               ADD 1 TO WS-FAILURES
               PERFORM CLOSE-OUTPUT-PIPE
               EXIT PARAGRAPH
           END-IF
           CALL "TSTDUP2" USING BY REFERENCE WS-WRITE-FD WS-STDERR-FD
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT < ZERO
               ADD 1 TO WS-FAILURES
               PERFORM RESTORE-STDERR
               PERFORM CLOSE-OUTPUT-PIPE
               EXIT PARAGRAPH
           END-IF
           CALL "TSTCLOSE" USING BY REFERENCE WS-WRITE-FD
               RETURNING WS-NATIVE-RESULT
           MOVE -1 TO WS-WRITE-FD
           INITIALIZE OUTPUT-PARM
           MOVE OUTPUT-STDERR TO OP-FILE-DESCRIPTOR
           SET OP-BUFFER-PTR TO ADDRESS OF WS-OUTPUT-PROBE
           MOVE 10 TO OP-BUFFER-LENGTH
           CALL "OUTPUT" USING OUTPUT-PARM
           PERFORM RESTORE-STDERR
           IF OP-STATUS NOT = STATUS-OK OR OP-WRITTEN NOT = 10
               ADD 1 TO WS-FAILURES
           END-IF
           CALL "TSTREAD" USING BY REFERENCE WS-READ-FD WS-CAPTURE
               WS-READ-LENGTH RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = 10 OR
              WS-CAPTURE(1:10) NOT = WS-OUTPUT-PROBE
               ADD 1 TO WS-FAILURES
           END-IF
           PERFORM CLOSE-OUTPUT-PIPE

           CALL "TSTDUP" USING BY REFERENCE WS-STDERR-FD
               RETURNING WS-SAVED-FD
           IF WS-SAVED-FD < ZERO
               ADD 1 TO WS-FAILURES
               EXIT PARAGRAPH
           END-IF
           CALL "TSTCLOSE" USING BY REFERENCE WS-STDERR-FD
               RETURNING WS-NATIVE-RESULT
           INITIALIZE OUTPUT-PARM
           MOVE OUTPUT-STDERR TO OP-FILE-DESCRIPTOR
           SET OP-BUFFER-PTR TO ADDRESS OF WS-OUTPUT-PROBE
           MOVE 1 TO OP-BUFFER-LENGTH
           CALL "OUTPUT" USING OUTPUT-PARM
           PERFORM RESTORE-STDERR
           IF OP-STATUS NOT = STATUS-OUTPUT OR OP-WRITTEN NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       RESTORE-STDERR.
           IF WS-SAVED-FD >= ZERO
               CALL "TSTDUP2" USING BY REFERENCE WS-SAVED-FD
                   WS-STDERR-FD RETURNING WS-NATIVE-RESULT
               IF WS-NATIVE-RESULT < ZERO
                   ADD 1 TO WS-FAILURES
               END-IF
               CALL "TSTCLOSE" USING BY REFERENCE WS-SAVED-FD
                   RETURNING WS-NATIVE-RESULT
               MOVE -1 TO WS-SAVED-FD
           END-IF.

       CLOSE-OUTPUT-PIPE.
           IF WS-READ-FD >= ZERO
               CALL "TSTCLOSE" USING BY REFERENCE WS-READ-FD
                   RETURNING WS-NATIVE-RESULT
               MOVE -1 TO WS-READ-FD
           END-IF
           IF WS-WRITE-FD >= ZERO
               CALL "TSTCLOSE" USING BY REFERENCE WS-WRITE-FD
                   RETURNING WS-NATIVE-RESULT
               MOVE -1 TO WS-WRITE-FD
           END-IF.

       TEST-CHILD-ENVIRONMENT.
           CALL "TSTSETENV" USING BY REFERENCE WS-KEY-NAME
               BY REFERENCE WS-KEY-VALUE
               BY REFERENCE WS-OVERWRITE
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           CALL "TSTSETENV" USING BY REFERENCE WS-SENTINEL-NAME
               BY REFERENCE WS-SENTINEL-VALUE
               BY REFERENCE WS-OVERWRITE
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           CALL "TSTUNSETENV" USING BY REFERENCE WS-KEY-NAME
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           CALL "TSTENVCOMMAND" USING BY REFERENCE WS-COMMAND
               WS-COMMAND-LENGTH
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-EXIT OR
              SP-EXIT-CODE NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           CALL "TSTSETENV" USING BY REFERENCE WS-KEY-NAME
               BY REFERENCE WS-KEY-VALUE
               BY REFERENCE WS-OVERWRITE
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           CALL "TSTENVCOMMAND" USING BY REFERENCE WS-COMMAND
               WS-COMMAND-LENGTH
           PERFORM EXPECT-CHILD-ENV-FAILURE
           CALL "TSTUNSETENV" USING BY REFERENCE WS-KEY-NAME
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "bad!" TO WS-SENTINEL-VALUE(1:4)
           CALL "TSTSETENV" USING BY REFERENCE WS-SENTINEL-NAME
               BY REFERENCE WS-SENTINEL-VALUE
               BY REFERENCE WS-OVERWRITE
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           CALL "TSTENVCOMMAND" USING BY REFERENCE WS-COMMAND
               WS-COMMAND-LENGTH
           PERFORM EXPECT-CHILD-ENV-FAILURE
           CALL "TSTUNSETENV" USING BY REFERENCE WS-SENTINEL-NAME
               RETURNING WS-NATIVE-RESULT
           IF WS-NATIVE-RESULT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       EXPECT-CHILD-ENV-FAILURE.
           PERFORM RUN-COMMAND
           IF SP-STATUS NOT = STATUS-OK OR
              SP-RESULT-KIND NOT = SHELL-EXIT OR
              SP-EXIT-CODE = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       SET-VALID-OUTPUT.
           INITIALIZE OUTPUT-PARM
           MOVE OUTPUT-STDERR TO OP-FILE-DESCRIPTOR
           SET OP-BUFFER-PTR TO ADDRESS OF WS-OUTPUT-PROBE
           MOVE 1 TO OP-BUFFER-LENGTH.

       EXPECT-OUTPUT-CONTRACT.
           MOVE OP-FILE-DESCRIPTOR TO WS-SAVED-FD
           SET WS-SAVED-OUTPUT-PTR TO OP-BUFFER-PTR
           MOVE OP-BUFFER-LENGTH TO WS-SAVED-BUFFER-LEN
           MOVE 999 TO OP-STATUS OP-WRITTEN
           CALL "OUTPUT" USING OUTPUT-PARM
           IF OP-STATUS NOT = STATUS-INTERNAL OR
              OP-WRITTEN NOT = ZERO OR
              OP-FILE-DESCRIPTOR NOT = WS-SAVED-FD OR
              OP-BUFFER-PTR NOT = WS-SAVED-OUTPUT-PTR OR
              OP-BUFFER-LENGTH NOT = WS-SAVED-BUFFER-LEN
               ADD 1 TO WS-FAILURES
           END-IF.

       RUN-COMMAND.
           MOVE LOW-VALUES TO WS-OUTPUT
           INITIALIZE SHELL-PARM
           SET SP-COMMAND-PTR TO ADDRESS OF WS-COMMAND
           MOVE WS-COMMAND-LENGTH TO SP-COMMAND-LENGTH
           SET SP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           MOVE 1048576 TO SP-OUTPUT-CAPACITY
           CALL "SHELL" USING SHELL-PARM
           IF SP-COMMAND-PTR NOT = ADDRESS OF WS-COMMAND OR
              SP-OUTPUT-PTR NOT = ADDRESS OF WS-OUTPUT OR
              SP-COMMAND-LENGTH NOT = WS-COMMAND-LENGTH OR
              SP-OUTPUT-CAPACITY NOT = 1048576
               ADD 1 TO WS-FAILURES
           END-IF.

       END PROGRAM TSTSHELL.
