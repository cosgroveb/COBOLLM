       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTJSON.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY JSONPARM.
       01  TEST-INPUT              PIC X(65536).
       01  TEST-VIEW               PIC X(16777216).
       01  TEST-NAME               PIC X(32).
       01  TEST-OUTPUT             PIC X(512).
       01  TEST-ALPHABET.
           05 FILLER PIC X(26) VALUE
               X'303132333435363738394142434445464748494A4B4C4D4E4F50'.
           05 FILLER PIC X(10) VALUE X'5152535455565758595A'.
       01  TEST-CURSOR             PIC S9(9) COMP-5.
       01  TEST-INDEX              PIC S9(9) COMP-5.
       01  TEST-BOUNDARY           PIC S9(9) COMP-5.
       01  TEST-REMAINDER          PIC S9(9) COMP-5.
       01  TEST-DIGIT              PIC S9(9) COMP-5.
       01  TEST-LENGTH             PIC S9(9) COMP-5.
       01  SAVED-INPUT-PTR         USAGE POINTER.
       01  SAVED-OUTPUT-PTR        USAGE POINTER.
       01  SAVED-CAPACITY          PIC S9(9) COMP-5.
       01  FAILURE-COUNT           PIC 9(4) VALUE ZERO.

       PROCEDURE DIVISION.
       MAIN.
           PERFORM TEST-ESCAPE
           PERFORM TEST-DECODE
           PERFORM TEST-SIMPLE-ESCAPES
           PERFORM TEST-CONTROL-ESCAPE
           PERFORM TEST-FIND
           PERFORM TEST-NOT-FOUND
           PERFORM TEST-FIND-WHITESPACE
           PERFORM TEST-DUPLICATE
           PERFORM TEST-DUPLICATE-UNKNOWN
           PERFORM TEST-DUPLICATE-NESTED
           PERFORM TEST-DUPLICATE-UNICODE
           PERFORM TEST-MANY-MEMBERS
           PERFORM TEST-LONG-NAME
           PERFORM TEST-MALFORMED
           PERFORM TEST-EMPTY-ITERATION
           PERFORM TEST-RESET-AND-OPERATIONS
           PERFORM TEST-CAPACITIES-AND-POINTERS
           PERFORM TEST-CALL-CONTRACTS
           PERFORM TEST-FIXED-BUFFER-LIMITS
           PERFORM TEST-DEPTH
           PERFORM TEST-TRAILING-AND-MALFORMED
           PERFORM TEST-UTF8-REJECTIONS
           IF FAILURE-COUNT = ZERO
               DISPLAY "PASS JSONSCAN"
               MOVE ZERO TO RETURN-CODE
           ELSE
               MOVE 1 TO RETURN-CODE
           END-IF
           STOP RUN.

       RESET-PARM.
           INITIALIZE JSON-PARM
           SET JP-INPUT-PTR TO ADDRESS OF TEST-INPUT
           MOVE 1 TO JP-CURSOR.

       TEST-ESCAPE.
           MOVE ALL X'00' TO TEST-INPUT TEST-OUTPUT
           MOVE X'41225C0A42' TO TEST-INPUT(1:5)
           PERFORM RESET-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           MOVE 5 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
           MOVE 512 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
             OR JP-OUTPUT-LENGTH NOT = 8
             OR TEST-OUTPUT(1:8) NOT = X'415C225C5C5C6E42'
               DISPLAY "FAIL JSON ESCAPE"
               PERFORM FAIL-TEST
           END-IF.

       TEST-DECODE.
           MOVE ALL X'00' TO TEST-INPUT TEST-OUTPUT
           MOVE X'225C75323041435C75443833445C754445303022'
             TO TEST-INPUT(1:20)
           PERFORM RESET-PARM
           MOVE JSON-DECODE TO JP-OPERATION
           MOVE 20 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
           MOVE 512 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
             OR JP-OUTPUT-LENGTH NOT = 7
             OR TEST-OUTPUT(1:7) NOT = X'E282ACF09F9880'
               DISPLAY "FAIL JSON DECODE"
               PERFORM FAIL-TEST
           END-IF.

       TEST-SIMPLE-ESCAPES.
           MOVE ALL X'00' TO TEST-INPUT TEST-OUTPUT
           MOVE X'225C225C5C5C2F5C625C665C6E5C725C7422'
             TO TEST-INPUT(1:18)
           PERFORM RESET-PARM
           MOVE JSON-DECODE TO JP-OPERATION
           MOVE 18 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
           MOVE 512 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
             OR JP-OUTPUT-LENGTH NOT = 8
             OR TEST-OUTPUT(1:8) NOT = X'225C2F080C0A0D09'
               DISPLAY "FAIL JSON SIMPLE ESCAPES"
               PERFORM FAIL-TEST
           END-IF.

       TEST-CONTROL-ESCAPE.
           MOVE ALL X'00' TO TEST-INPUT TEST-OUTPUT
           MOVE X'011F' TO TEST-INPUT(1:2)
           PERFORM RESET-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           MOVE 2 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
           MOVE 512 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
             OR JP-OUTPUT-LENGTH NOT = 12
             OR TEST-OUTPUT(1:12) NOT = X'5C75303030315C7530303146'
               DISPLAY "FAIL JSON CONTROL ESCAPE"
               PERFORM FAIL-TEST
           END-IF.

       TEST-FIND.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME
           MOVE X'7B2261223A5B312C7B2262223A747275657D5D7D'
             TO TEST-INPUT(1:20)
           MOVE X'61' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 20 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
             OR JP-FOUND NOT = FLAG-ON
             OR JP-SPAN-LENGTH NOT = 14
               DISPLAY "FAIL JSON FIND"
               PERFORM FAIL-TEST
           END-IF.

       TEST-NOT-FOUND.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME
           MOVE X'7B2261223A317D' TO TEST-INPUT(1:7)
           MOVE X'7A' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 7 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-OFF
             OR JP-SPAN-START NOT = ZERO OR JP-SPAN-LENGTH NOT = ZERO
             OR JP-NEXT-CURSOR NOT = 8
               DISPLAY "FAIL JSON MEMBER NOT FOUND"
               PERFORM FAIL-TEST
           END-IF.

       TEST-FIND-WHITESPACE.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME
           MOVE X'61' TO TEST-NAME(1:1)
           MOVE X'7B2261223A6E756C6C20092C0A227A223A307D'
             TO TEST-INPUT(1:19)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 19 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-ON
             OR JP-SPAN-START NOT = 6 OR JP-SPAN-LENGTH NOT = 4
             OR TEST-INPUT(JP-SPAN-START:JP-SPAN-LENGTH)
                NOT = X'6E756C6C'
             OR JP-NEXT-CURSOR NOT = 20
               DISPLAY "FAIL JSON FIND NULL WHITESPACE"
               PERFORM FAIL-TEST
           END-IF

           MOVE X'7B2261223A747275652020207D' TO TEST-INPUT(1:13)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 13 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-ON
             OR JP-SPAN-START NOT = 6 OR JP-SPAN-LENGTH NOT = 4
             OR TEST-INPUT(JP-SPAN-START:JP-SPAN-LENGTH)
                NOT = X'74727565'
             OR JP-NEXT-CURSOR NOT = 14
               DISPLAY "FAIL JSON FIND BOOLEAN WHITESPACE"
               PERFORM FAIL-TEST
           END-IF

           MOVE X'7B2261223A227822200D2C227A223A307D'
             TO TEST-INPUT(1:17)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 17 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-ON
             OR JP-SPAN-START NOT = 6 OR JP-SPAN-LENGTH NOT = 3
             OR TEST-INPUT(JP-SPAN-START:JP-SPAN-LENGTH)
                NOT = X'227822'
             OR JP-NEXT-CURSOR NOT = 18
               DISPLAY "FAIL JSON FIND STRING WHITESPACE"
               PERFORM FAIL-TEST
           END-IF.

       TEST-DUPLICATE.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME
           MOVE X'7B2261223A312C225C7530303631223A327D'
             TO TEST-INPUT(1:18)
           MOVE X'61' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 18 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
             OR JP-FOUND NOT = FLAG-OFF
               DISPLAY "FAIL JSON DUPLICATE"
               PERFORM FAIL-TEST
           END-IF.

       TEST-DUPLICATE-UNKNOWN.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME
           MOVE X'7B2275223A312C225C7530303735223A327D'
             TO TEST-INPUT(1:18)
           MOVE X'7A' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 18 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
             OR JP-FOUND NOT = FLAG-OFF
               DISPLAY "FAIL JSON DUPLICATE UNKNOWN"
               PERFORM FAIL-TEST
           END-IF.

       TEST-DUPLICATE-NESTED.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME
           MOVE X'7B2278223A7B2275223A312C225C7530303735223A327D2C22'
             TO TEST-INPUT(1:26)
           MOVE X'61223A317D' TO TEST-INPUT(27:5)
           MOVE X'61' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 31 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
             OR JP-FOUND NOT = FLAG-OFF
               DISPLAY "FAIL JSON DUPLICATE NESTED"
               PERFORM FAIL-TEST
           END-IF.

       TEST-DUPLICATE-UNICODE.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME
           MOVE X'7B22C3A9223A312C225C7530304539223A327D'
             TO TEST-INPUT(1:19)
           MOVE X'7A' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 19 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
               DISPLAY "FAIL JSON DUPLICATE UNICODE"
               PERFORM FAIL-TEST
           END-IF.

       TEST-MANY-MEMBERS.
           MOVE ALL X'00' TO TEST-INPUT
           MOVE X'7B' TO TEST-INPUT(1:1)
           MOVE 2 TO TEST-CURSOR
           PERFORM VARYING TEST-INDEX FROM 0 BY 1
               UNTIL TEST-INDEX > 1024
               IF TEST-INDEX > 0
                   MOVE X'2C' TO TEST-INPUT(TEST-CURSOR:1)
                   ADD 1 TO TEST-CURSOR
               END-IF
               MOVE X'22' TO TEST-INPUT(TEST-CURSOR:1)
               ADD 1 TO TEST-CURSOR
               COMPUTE TEST-DIGIT = TEST-INDEX / 1296
               ADD 1 TO TEST-DIGIT
               MOVE TEST-ALPHABET(TEST-DIGIT:1)
                 TO TEST-INPUT(TEST-CURSOR:1)
               ADD 1 TO TEST-CURSOR
               COMPUTE TEST-REMAINDER =
                   FUNCTION MOD(TEST-INDEX, 1296)
               COMPUTE TEST-DIGIT = TEST-REMAINDER / 36
               ADD 1 TO TEST-DIGIT
               MOVE TEST-ALPHABET(TEST-DIGIT:1)
                 TO TEST-INPUT(TEST-CURSOR:1)
               ADD 1 TO TEST-CURSOR
               COMPUTE TEST-DIGIT =
                   FUNCTION MOD(TEST-REMAINDER, 36) + 1
               MOVE TEST-ALPHABET(TEST-DIGIT:1)
                 TO TEST-INPUT(TEST-CURSOR:1)
               ADD 1 TO TEST-CURSOR
               MOVE X'223A30' TO TEST-INPUT(TEST-CURSOR:3)
               ADD 3 TO TEST-CURSOR
           END-PERFORM
           MOVE X'7D' TO TEST-INPUT(TEST-CURSOR:1)
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE TEST-CURSOR TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
               DISPLAY "FAIL JSON MANY MEMBERS"
               PERFORM FAIL-TEST
           END-IF.

       TEST-LONG-NAME.
           MOVE ALL X'00' TO TEST-INPUT
           MOVE X'7B22' TO TEST-INPUT(1:2)
           MOVE ALL X'61' TO TEST-INPUT(3:300)
           MOVE X'223A307D' TO TEST-INPUT(303:4)
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE 306 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
               DISPLAY "FAIL JSON LONG NAME"
               PERFORM FAIL-TEST
           END-IF.

       TEST-MALFORMED.
           MOVE ALL X'00' TO TEST-INPUT
           MOVE X'5B312C5D' TO TEST-INPUT(1:4)
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE 4 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
               DISPLAY "FAIL JSON MALFORMED"
               PERFORM FAIL-TEST
           END-IF.

       TEST-EMPTY-ITERATION.
           MOVE X'5B5D' TO TEST-INPUT(1:2)
           PERFORM RESET-PARM
           MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
           MOVE 2 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-END NOT = FLAG-ON
             OR JP-NEXT-CURSOR NOT = 3 OR JP-SPAN-LENGTH NOT = ZERO
               DISPLAY "FAIL JSON EMPTY ARRAY ITERATION"
               PERFORM FAIL-TEST
           END-IF

           MOVE X'5B7B7D2C5B5D5D' TO TEST-INPUT(1:7)
           PERFORM RESET-PARM
           MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
           MOVE 7 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-END NOT = FLAG-OFF
             OR JP-SPAN-LENGTH NOT = 2
             OR TEST-INPUT(JP-SPAN-START:2) NOT = X'7B7D'
               DISPLAY "FAIL JSON EMPTY OBJECT ITERATION"
               PERFORM FAIL-TEST
           END-IF
           MOVE JP-NEXT-CURSOR TO JP-CURSOR
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-END NOT = FLAG-OFF
             OR JP-SPAN-LENGTH NOT = 2
             OR TEST-INPUT(JP-SPAN-START:2) NOT = X'5B5D'
               DISPLAY "FAIL JSON EMPTY NESTED ARRAY ITERATION"
               PERFORM FAIL-TEST
           END-IF
           MOVE JP-NEXT-CURSOR TO JP-CURSOR
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-END NOT = FLAG-ON
             OR JP-NEXT-CURSOR NOT = 8
               DISPLAY "FAIL JSON EMPTY VALUES ARRAY END"
               PERFORM FAIL-TEST
           END-IF.

       TEST-RESET-AND-OPERATIONS.
           MOVE ALL X'00' TO TEST-INPUT TEST-NAME TEST-OUTPUT
           MOVE X'30' TO TEST-INPUT(1:1)
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE 1 TO JP-INPUT-LENGTH
           MOVE 999 TO JP-STATUS JP-OUTPUT-LENGTH JP-NEXT-CURSOR
               JP-SPAN-START JP-SPAN-LENGTH JP-DEPTH
           MOVE X'FF' TO JP-FOUND JP-END
           SET SAVED-INPUT-PTR TO JP-INPUT-PTR
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-NEXT-CURSOR NOT = 2
             OR JP-SPAN-START NOT = 1 OR JP-SPAN-LENGTH NOT = 1
             OR JP-OUTPUT-LENGTH NOT = 0 OR JP-DEPTH NOT = 0
             OR JP-FOUND NOT = FLAG-OFF OR JP-END NOT = FLAG-OFF
             OR JP-INPUT-PTR NOT = SAVED-INPUT-PTR
               DISPLAY "FAIL JSON RESULT RESET"
               PERFORM FAIL-TEST
           END-IF
           PERFORM RESET-PARM
           MOVE 99 TO JP-OPERATION JP-STATUS JP-OUTPUT-LENGTH
               JP-NEXT-CURSOR JP-SPAN-START JP-SPAN-LENGTH JP-DEPTH
           MOVE 1 TO JP-INPUT-LENGTH
           MOVE X'FF' TO JP-FOUND JP-END
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-INTERNAL
             OR JP-OUTPUT-LENGTH NOT = 0 OR JP-NEXT-CURSOR NOT = 0
             OR JP-SPAN-START NOT = 0 OR JP-SPAN-LENGTH NOT = 0
             OR JP-DEPTH NOT = 0 OR JP-FOUND NOT = FLAG-OFF
             OR JP-END NOT = FLAG-OFF
               DISPLAY "FAIL JSON UNKNOWN OP RESET"
               PERFORM FAIL-TEST
           END-IF
           MOVE X'5B747275652C6E756C6C5D' TO TEST-INPUT(1:11)
           PERFORM RESET-PARM
           MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
           MOVE 11 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-SPAN-START NOT = 2
             OR JP-SPAN-LENGTH NOT = 4 OR JP-NEXT-CURSOR NOT = 6
               DISPLAY "FAIL JSON ARRAY FIRST"
               PERFORM FAIL-TEST
           END-IF
           MOVE JP-NEXT-CURSOR TO JP-CURSOR
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-SPAN-LENGTH NOT = 4
             OR TEST-INPUT(JP-SPAN-START:JP-SPAN-LENGTH)
                 NOT = X'6E756C6C'
               DISPLAY "FAIL JSON ARRAY SECOND"
               PERFORM FAIL-TEST
           END-IF
           MOVE JP-NEXT-CURSOR TO JP-CURSOR
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-END NOT = FLAG-ON
             OR JP-NEXT-CURSOR NOT = 12
               DISPLAY "FAIL JSON ARRAY END"
               PERFORM FAIL-TEST
           END-IF
           MOVE X'7B2261223A22C3A9227D' TO TEST-INPUT(1:10)
           MOVE X'61' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 10 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-FOUND NOT = FLAG-ON
             OR JP-SPAN-LENGTH NOT = 4
             OR TEST-INPUT(JP-SPAN-START:4) NOT = X'22C3A922'
               DISPLAY "FAIL JSON RAW UTF8 SPAN"
               PERFORM FAIL-TEST
           END-IF.

       TEST-CAPACITIES-AND-POINTERS.
           MOVE ALL X'00' TO TEST-INPUT TEST-OUTPUT
           MOVE X'22' TO TEST-INPUT(1:1)
           PERFORM RESET-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           MOVE 1 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
           MOVE 2 TO JP-OUTPUT-CAPACITY
           SET SAVED-OUTPUT-PTR TO JP-OUTPUT-PTR
           MOVE JP-OUTPUT-CAPACITY TO SAVED-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-OUTPUT-LENGTH NOT = 2
             OR TEST-OUTPUT(1:2) NOT = X'5C22'
             OR JP-OUTPUT-PTR NOT = SAVED-OUTPUT-PTR
             OR JP-OUTPUT-CAPACITY NOT = SAVED-CAPACITY
               DISPLAY "FAIL JSON EXACT ESCAPE CAPACITY"
               PERFORM FAIL-TEST
           END-IF
           MOVE 1 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-CAPACITY
             OR JP-OUTPUT-LENGTH NOT = 0
               DISPLAY "FAIL JSON ESCAPE OVERFLOW"
               PERFORM FAIL-TEST
           END-IF
           MOVE X'22E282AC22' TO TEST-INPUT(1:5)
           PERFORM RESET-PARM
           MOVE JSON-DECODE TO JP-OPERATION
           MOVE 5 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
           MOVE 3 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-OUTPUT-LENGTH NOT = 3
             OR TEST-OUTPUT(1:3) NOT = X'E282AC'
               DISPLAY "FAIL JSON EXACT DECODE CAPACITY"
               PERFORM FAIL-TEST
           END-IF
           MOVE 2 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-CAPACITY
             OR JP-OUTPUT-LENGTH NOT = 0
               DISPLAY "FAIL JSON DECODE OVERFLOW"
               PERFORM FAIL-TEST
           END-IF
           PERFORM RESET-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           MOVE 1 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO NULL
           MOVE 1 TO JP-OUTPUT-CAPACITY
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
               DISPLAY "FAIL JSON NULL OUTPUT"
               PERFORM FAIL-TEST
           END-IF
           INITIALIZE JSON-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           SET JP-INPUT-PTR TO NULL
           MOVE 1 TO JP-INPUT-LENGTH JP-CURSOR
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
               DISPLAY "FAIL JSON NULL INPUT"
               PERFORM FAIL-TEST
           END-IF
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE 8388609 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
               DISPLAY "FAIL JSON INPUT LIMIT"
               PERFORM FAIL-TEST
           END-IF.

       TEST-CALL-CONTRACTS.
           MOVE 0 TO TEST-INDEX
           PERFORM VARYING JP-OPERATION FROM JSON-ESCAPE BY 1
               UNTIL JP-OPERATION > JSON-SKIP-VALUE
               PERFORM SET-VALID-CALL
               SET JP-INPUT-PTR TO NULL
               PERFORM EXPECT-CONTRACT-ERROR
               PERFORM SET-VALID-CALL
               MOVE -1 TO JP-INPUT-LENGTH
               PERFORM EXPECT-CONTRACT-ERROR
               PERFORM SET-VALID-CALL
               MOVE 8388609 TO JP-INPUT-LENGTH
               PERFORM EXPECT-CONTRACT-ERROR
           END-PERFORM
           PERFORM VARYING JP-OPERATION FROM JSON-ESCAPE BY 1
               UNTIL JP-OPERATION > JSON-SKIP-VALUE
               PERFORM SET-VALID-CALL
               MOVE 0 TO JP-CURSOR
               PERFORM EXPECT-CONTRACT-ERROR
               PERFORM SET-VALID-CALL
               MOVE 4 TO JP-CURSOR
               PERFORM EXPECT-CONTRACT-ERROR
           END-PERFORM
           MOVE JSON-ESCAPE TO JP-OPERATION
           PERFORM TEST-FORBIDDEN-NAME
           MOVE JSON-DECODE TO JP-OPERATION
           PERFORM TEST-FORBIDDEN-NAME
           MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
           PERFORM TEST-FORBIDDEN-NAME
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           PERFORM TEST-FORBIDDEN-NAME
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           PERFORM SET-VALID-CALL
           SET JP-NAME-PTR TO NULL
           PERFORM EXPECT-CONTRACT-ERROR
           PERFORM SET-VALID-CALL
           MOVE -1 TO JP-NAME-LENGTH
           PERFORM EXPECT-CONTRACT-ERROR
           PERFORM SET-VALID-CALL
           MOVE 8388609 TO JP-NAME-LENGTH
           PERFORM EXPECT-CONTRACT-ERROR
           MOVE JSON-ESCAPE TO JP-OPERATION
           PERFORM TEST-REQUIRED-OUTPUT
           MOVE JSON-DECODE TO JP-OPERATION
           PERFORM TEST-REQUIRED-OUTPUT
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           PERFORM TEST-FORBIDDEN-OUTPUT
           MOVE JSON-NEXT-ELEMENT TO JP-OPERATION
           PERFORM TEST-FORBIDDEN-OUTPUT
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           PERFORM TEST-FORBIDDEN-OUTPUT.

       SET-VALID-CALL.
           MOVE X'223022' TO TEST-INPUT(1:3)
           SET JP-INPUT-PTR TO ADDRESS OF TEST-INPUT
           MOVE 3 TO JP-INPUT-LENGTH
           MOVE 1 TO JP-CURSOR
           SET JP-NAME-PTR JP-OUTPUT-PTR TO NULL
           MOVE 0 TO JP-NAME-LENGTH JP-OUTPUT-CAPACITY
           EVALUATE JP-OPERATION
               WHEN JSON-ESCAPE
               WHEN JSON-DECODE
                   SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
                   MOVE 512 TO JP-OUTPUT-CAPACITY
               WHEN JSON-FIND-MEMBER
                   SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
                   MOVE 1 TO JP-NAME-LENGTH
           END-EVALUATE.

       TEST-FORBIDDEN-NAME.
           PERFORM SET-VALID-CALL
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           PERFORM EXPECT-CONTRACT-ERROR
           PERFORM SET-VALID-CALL
           MOVE 1 TO JP-NAME-LENGTH
           PERFORM EXPECT-CONTRACT-ERROR.

       TEST-REQUIRED-OUTPUT.
           PERFORM SET-VALID-CALL
           SET JP-OUTPUT-PTR TO NULL
           PERFORM EXPECT-CONTRACT-ERROR
           PERFORM SET-VALID-CALL
           MOVE -1 TO JP-OUTPUT-CAPACITY
           PERFORM EXPECT-CONTRACT-ERROR
           PERFORM SET-VALID-CALL
           MOVE 16777217 TO JP-OUTPUT-CAPACITY
           PERFORM EXPECT-CONTRACT-ERROR.

       TEST-FORBIDDEN-OUTPUT.
           PERFORM SET-VALID-CALL
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-OUTPUT
           PERFORM EXPECT-CONTRACT-ERROR
           PERFORM SET-VALID-CALL
           MOVE 1 TO JP-OUTPUT-CAPACITY
           PERFORM EXPECT-CONTRACT-ERROR.

       EXPECT-CONTRACT-ERROR.
           ADD 1 TO TEST-INDEX
           MOVE 999 TO JP-STATUS JP-OUTPUT-LENGTH JP-NEXT-CURSOR
               JP-SPAN-START JP-SPAN-LENGTH JP-DEPTH
           MOVE X'FF' TO JP-FOUND JP-END
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
             OR JP-OUTPUT-LENGTH NOT = 0
             OR JP-NEXT-CURSOR NOT = 0
             OR JP-SPAN-START NOT = 0
             OR JP-SPAN-LENGTH NOT = 0
             OR JP-DEPTH NOT = 0
             OR JP-FOUND NOT = FLAG-OFF
             OR JP-END NOT = FLAG-OFF
               DISPLAY "FAIL JSON CALL CONTRACT " TEST-INDEX
               PERFORM FAIL-TEST
           END-IF.

       TEST-FIXED-BUFFER-LIMITS.
      * A short value proves each input boundary without walking the
      * unused portion of the fixed buffer.
           MOVE X'3058' TO TEST-VIEW(1:2)
           COMPUTE TEST-BOUNDARY = LIMIT-RESPONSE - 1
           MOVE X'5A' TO TEST-VIEW(TEST-BOUNDARY:1)
           MOVE X'5A' TO TEST-VIEW(LIMIT-RESPONSE:1)
           COMPUTE TEST-BOUNDARY = LIMIT-RESPONSE + 1
           MOVE X'5A' TO TEST-VIEW(TEST-BOUNDARY:1)
           MOVE X'5A' TO TEST-VIEW(LIMIT-HISTORY:1)
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           COMPUTE TEST-LENGTH = LIMIT-RESPONSE - 1
           PERFORM TEST-JSON-INPUT-BOUNDARY
           MOVE LIMIT-RESPONSE TO TEST-LENGTH
           PERFORM TEST-JSON-INPUT-BOUNDARY

           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           SET JP-INPUT-PTR TO ADDRESS OF TEST-VIEW
           COMPUTE JP-INPUT-LENGTH = LIMIT-RESPONSE + 1
           MOVE 999 TO JP-STATUS JP-OUTPUT-LENGTH JP-NEXT-CURSOR
               JP-SPAN-START JP-SPAN-LENGTH JP-DEPTH
           MOVE X'FF' TO JP-FOUND JP-END
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
             OR JP-OUTPUT-LENGTH NOT = 0
             OR JP-NEXT-CURSOR NOT = 0
             OR JP-SPAN-START NOT = 0
             OR JP-SPAN-LENGTH NOT = 0
             OR JP-DEPTH NOT = 0
             OR JP-FOUND NOT = FLAG-OFF
             OR JP-END NOT = FLAG-OFF
             OR TEST-VIEW(1:2) NOT = X'3058'
             OR TEST-VIEW(TEST-BOUNDARY:1) NOT = X'5A'
               DISPLAY "FAIL JSON INPUT ABOVE LIMIT"
               PERFORM FAIL-TEST
           END-IF

      * Empty input proves each output capacity without touching the
      * large destination.  An oversized call resets poisoned results.
           PERFORM RESET-PARM
           MOVE JSON-ESCAPE TO JP-OPERATION
           MOVE X'30' TO TEST-INPUT(1:1)
           MOVE 0 TO JP-INPUT-LENGTH
           SET JP-OUTPUT-PTR TO ADDRESS OF TEST-VIEW
           COMPUTE JP-OUTPUT-CAPACITY = LIMIT-HISTORY - 1
           PERFORM TEST-JSON-OUTPUT-BOUNDARY
           MOVE LIMIT-HISTORY TO JP-OUTPUT-CAPACITY
           PERFORM TEST-JSON-OUTPUT-BOUNDARY
           COMPUTE JP-OUTPUT-CAPACITY = LIMIT-HISTORY + 1
           MOVE 999 TO JP-STATUS JP-OUTPUT-LENGTH JP-NEXT-CURSOR
               JP-SPAN-START JP-SPAN-LENGTH JP-DEPTH
           MOVE X'FF' TO JP-FOUND JP-END
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
             OR JP-OUTPUT-LENGTH NOT = 0
             OR JP-NEXT-CURSOR NOT = 0
             OR JP-SPAN-START NOT = 0
             OR JP-SPAN-LENGTH NOT = 0
             OR JP-DEPTH NOT = 0
             OR JP-FOUND NOT = FLAG-OFF
             OR JP-END NOT = FLAG-OFF
             OR TEST-INPUT(1:1) NOT = X'30'
             OR TEST-VIEW(1:2) NOT = X'3058'
             OR TEST-VIEW(LIMIT-HISTORY:1) NOT = X'5A'
               DISPLAY "FAIL JSON OUTPUT ABOVE LIMIT"
               PERFORM FAIL-TEST
           END-IF.

       TEST-JSON-INPUT-BOUNDARY.
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           SET JP-INPUT-PTR TO ADDRESS OF TEST-VIEW
           MOVE TEST-LENGTH TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
             OR JP-NEXT-CURSOR NOT = 2
             OR JP-SPAN-START NOT = 1
             OR JP-SPAN-LENGTH NOT = 1
             OR TEST-VIEW(1:2) NOT = X'3058'
             OR TEST-VIEW(JP-INPUT-LENGTH:1) NOT = X'5A'
               DISPLAY "FAIL JSON INPUT BOUNDARY"
               PERFORM FAIL-TEST
           END-IF.

       TEST-JSON-OUTPUT-BOUNDARY.
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK
             OR JP-OUTPUT-LENGTH NOT = 0
             OR TEST-INPUT(1:1) NOT = X'30'
             OR TEST-VIEW(1:2) NOT = X'3058'
             OR TEST-VIEW(LIMIT-HISTORY:1) NOT = X'5A'
               DISPLAY "FAIL JSON OUTPUT BOUNDARY"
               PERFORM FAIL-TEST
           END-IF.

       TEST-DEPTH.
           MOVE ALL X'00' TO TEST-INPUT
           PERFORM VARYING TEST-INDEX FROM 1 BY 1
               UNTIL TEST-INDEX > 64
               MOVE X'5B' TO TEST-INPUT(TEST-INDEX:1)
               COMPUTE TEST-CURSOR = 130 - TEST-INDEX
               MOVE X'5D' TO TEST-INPUT(TEST-CURSOR:1)
           END-PERFORM
           MOVE X'30' TO TEST-INPUT(65:1)
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE 129 TO JP-INPUT-LENGTH
           MOVE 999 TO JP-DEPTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-DEPTH NOT = 0
             OR JP-NEXT-CURSOR NOT = 130
               DISPLAY "FAIL JSON DEPTH 64"
               PERFORM FAIL-TEST
           END-IF
           MOVE ALL X'00' TO TEST-INPUT
           PERFORM VARYING TEST-INDEX FROM 1 BY 1
               UNTIL TEST-INDEX > 65
               MOVE X'5B' TO TEST-INPUT(TEST-INDEX:1)
               COMPUTE TEST-CURSOR = 132 - TEST-INDEX
               MOVE X'5D' TO TEST-INPUT(TEST-CURSOR:1)
           END-PERFORM
           MOVE X'30' TO TEST-INPUT(66:1)
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE 131 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON OR JP-NEXT-CURSOR NOT = 0
               DISPLAY "FAIL JSON DEPTH 65"
               PERFORM FAIL-TEST
           END-IF.

       TEST-TRAILING-AND-MALFORMED.
           MOVE X'3058' TO TEST-INPUT(1:2)
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE 2 TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-NEXT-CURSOR NOT = 2
               DISPLAY "FAIL JSON TRAILING CURSOR"
               PERFORM FAIL-TEST
           END-IF
           MOVE X'3031' TO TEST-INPUT(1:2)
           MOVE 2 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'312E' TO TEST-INPUT(1:2)
           MOVE 2 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'31652B' TO TEST-INPUT(1:3)
           MOVE 3 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'74727578' TO TEST-INPUT(1:4)
           MOVE 4 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'66616C7378' TO TEST-INPUT(1:5)
           MOVE 5 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'6E756C78' TO TEST-INPUT(1:4)
           MOVE 4 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'225C754443303022' TO TEST-INPUT(1:8)
           MOVE 8 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'225C754438303022' TO TEST-INPUT(1:8)
           MOVE 8 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'7B2261223A317D58' TO TEST-INPUT(1:8)
           MOVE X'61' TO TEST-NAME(1:1)
           PERFORM RESET-PARM
           MOVE JSON-FIND-MEMBER TO JP-OPERATION
           MOVE 8 TO JP-INPUT-LENGTH
           SET JP-NAME-PTR TO ADDRESS OF TEST-NAME
           MOVE 1 TO JP-NAME-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-OK OR JP-NEXT-CURSOR NOT = 8
               DISPLAY "FAIL JSON FIND TRAILING CURSOR"
               PERFORM FAIL-TEST
           END-IF.

       TEST-UTF8-REJECTIONS.
           MOVE X'22C0AF22' TO TEST-INPUT(1:4)
           MOVE 4 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'22E0808022' TO TEST-INPUT(1:5)
           MOVE 5 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'22EDA08022' TO TEST-INPUT(1:5)
           MOVE 5 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'22F490808022' TO TEST-INPUT(1:6)
           MOVE 6 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'22E282' TO TEST-INPUT(1:3)
           MOVE 3 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED
           MOVE X'EFBBBF30' TO TEST-INPUT(1:4)
           MOVE 4 TO TEST-LENGTH
           PERFORM EXPECT-MALFORMED.

       EXPECT-MALFORMED.
           PERFORM RESET-PARM
           MOVE JSON-SKIP-VALUE TO JP-OPERATION
           MOVE TEST-LENGTH TO JP-INPUT-LENGTH
           CALL "JSONSCAN" USING JSON-PARM
           IF JP-STATUS NOT = STATUS-JSON
             OR JP-OUTPUT-LENGTH NOT = 0 OR JP-NEXT-CURSOR NOT = 0
             OR JP-SPAN-START NOT = 0 OR JP-SPAN-LENGTH NOT = 0
             OR JP-FOUND NOT = FLAG-OFF OR JP-END NOT = FLAG-OFF
               DISPLAY "FAIL JSON MALFORMED RESET"
               PERFORM FAIL-TEST
           END-IF.

       FAIL-TEST.
           ADD 1 TO FAILURE-COUNT.

       END PROGRAM TSTJSON.
