       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTZTXT.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY TXTPARM.
       01 WS-INPUT PIC X(32).
       01 WS-OUTPUT PIC X(32).
       01 WS-SAVED-INPUT-PTR USAGE POINTER.
       01 WS-SAVED-OUTPUT-PTR USAGE POINTER.
       01 WS-SAVED-INPUT-LENGTH PIC S9(9) COMP-5.
       01 WS-SAVED-CAPACITY PIC S9(9) COMP-5.
       01 WS-OP PIC S9(9) COMP-5.
       01 WS-FAILURES PIC S9(9) COMP-5 VALUE ZERO.

       PROCEDURE DIVISION.
           PERFORM TEST-NATIVE-TO-UTF8
           PERFORM TEST-UTF8-TO-NATIVE
           PERFORM TEST-UTF8-UNREPRESENTABLE-STRICT
           PERFORM TEST-UTF8-INVALID
           PERFORM TEST-UTF8-REPLACEMENT
           PERFORM TEST-UTF8-REPLACEMENT-MATRIX
           PERFORM TEST-REPLACEMENT-CAPACITY
           PERFORM TEST-CONTRACT-MATRIX
           PERFORM TEST-VIEW-LIMITS
           IF WS-FAILURES = ZERO
               DISPLAY "PASS ZOS TEXT"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL ZOS TEXT"
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       TEST-NATIVE-TO-UTF8.
           MOVE X"C1ADBDC0D0E05FA14F7C7B5B" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-NATIVE-STRICT TO TP-OPERATION
           MOVE 12 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = 12 OR
              WS-OUTPUT(1:12) NOT = X"415B5D7B7D5C5E7E7C402324"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-UTF8-TO-NATIVE.
           MOVE X"415B5D7B7D5C5E7E7C402324" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-STRICT TO TP-OPERATION
           MOVE 12 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = 12 OR
              WS-OUTPUT(1:12) NOT = X"C1ADBDC0D0E05FA14F7C7B5B"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-UTF8-UNREPRESENTABLE-STRICT.
           MOVE X"41F09F988042" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-STRICT TO TP-OPERATION
           MOVE 6 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-TEXT-INVALID OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              WS-OUTPUT(2:1) NOT = LOW-VALUE
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-UTF8-INVALID.
           MOVE X"418042" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-STRICT TO TP-OPERATION
           MOVE 3 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-TEXT-INVALID OR
              TP-OUTPUT-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-UTF8-REPLACEMENT.
           MOVE X"418042" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-REPLACE TO TP-OPERATION
           MOVE 3 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = 3 OR
              TP-REPLACED NOT = FLAG-ON OR
              WS-OUTPUT(1:3) NOT = X"C16FC2" OR
              WS-OUTPUT(4:29) NOT = LOW-VALUES
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-UTF8-REPLACEMENT-MATRIX.
           MOVE X"41E228A142" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-REPLACE TO TP-OPERATION
           MOVE 5 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = 5 OR
              TP-REPLACED NOT = FLAG-ON OR
              WS-OUTPUT(1:5) NOT = X"C16F4D6FC2"
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE X"C0AF" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-REPLACE TO TP-OPERATION
           MOVE 2 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = 2 OR
              TP-REPLACED NOT = FLAG-ON OR
              WS-OUTPUT(1:2) NOT = X"6F6F"
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE X"41F09F988042" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-REPLACE TO TP-OPERATION
           MOVE 6 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = 3 OR
              TP-REPLACED NOT = FLAG-ON OR
              WS-OUTPUT(1:3) NOT = X"C16FC2"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-REPLACEMENT-CAPACITY.
           MOVE X"41E228A142" TO WS-INPUT
           PERFORM PREPARE-TEXT
           MOVE TEXT-UTF8-REPLACE TO TP-OPERATION
           MOVE 5 TO TP-INPUT-LENGTH
           MOVE 4 TO TP-OUTPUT-CAPACITY
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-CAPACITY OR
              TP-OUTPUT-LENGTH NOT = 4 OR
              TP-REPLACED NOT = FLAG-ON OR
              TP-TRUNCATED NOT = FLAG-ON OR
              WS-OUTPUT(1:4) NOT = X"C16F4D6F"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-CONTRACT-MATRIX.
           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-REPLACE
               PERFORM TEST-CONTRACT-OPERATION
           END-PERFORM.

       TEST-CONTRACT-OPERATION.
      * Both pointers remain required even when their size is zero.
           PERFORM PREPARE-CONTRACT
           MOVE ZERO TO TP-INPUT-LENGTH
           SET TP-INPUT-PTR TO NULL
           PERFORM SAVE-INPUTS
           PERFORM CALL-AND-EXPECT-INTERNAL
           PERFORM ASSERT-INPUTS-PRESERVED
           PERFORM PREPARE-CONTRACT
           MOVE ZERO TO TP-INPUT-LENGTH TP-OUTPUT-CAPACITY
           SET TP-OUTPUT-PTR TO NULL
           PERFORM SAVE-INPUTS
           PERFORM CALL-AND-EXPECT-INTERNAL
           PERFORM ASSERT-INPUTS-PRESERVED

      * Invalid sizes reset results without touching input parameters.
           PERFORM PREPARE-CONTRACT
           MOVE -1 TO TP-INPUT-LENGTH
           PERFORM SAVE-INPUTS
           PERFORM CALL-AND-EXPECT-INTERNAL
           PERFORM ASSERT-INPUTS-PRESERVED
           PERFORM PREPARE-CONTRACT
           MOVE -1 TO TP-OUTPUT-CAPACITY
           PERFORM SAVE-INPUTS
           PERFORM CALL-AND-EXPECT-INTERNAL
           PERFORM ASSERT-INPUTS-PRESERVED

      * A one-byte result fits exactly for every operation.
           PERFORM PREPARE-CONTRACT
           MOVE 1 TO TP-INPUT-LENGTH TP-OUTPUT-CAPACITY
           PERFORM SAVE-INPUTS
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = 1 OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-OFF
               ADD 1 TO WS-FAILURES
           ELSE
               IF WS-OP = TEXT-NATIVE-STRICT OR
                  WS-OP = TEXT-NATIVE-REPLACE
                   IF WS-OUTPUT(1:1) NOT = X"41"
                       ADD 1 TO WS-FAILURES
                   END-IF
               ELSE
                   IF WS-OUTPUT(1:1) NOT = X"C1"
                       ADD 1 TO WS-FAILURES
                   END-IF
               END-IF
           END-IF
           PERFORM ASSERT-INPUTS-PRESERVED

      * One byte short reports capacity and writes nothing.
           PERFORM PREPARE-CONTRACT
           MOVE 1 TO TP-INPUT-LENGTH
           MOVE ZERO TO TP-OUTPUT-CAPACITY
           PERFORM SAVE-INPUTS
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-CAPACITY OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-ON OR
              WS-OUTPUT NOT = LOW-VALUES
               ADD 1 TO WS-FAILURES
           END-IF
           PERFORM ASSERT-INPUTS-PRESERVED.

       PREPARE-CONTRACT.
           MOVE LOW-VALUES TO WS-OUTPUT
           IF WS-OP = TEXT-NATIVE-STRICT OR
              WS-OP = TEXT-NATIVE-REPLACE
               MOVE X"C1" TO WS-INPUT(1:1)
           ELSE
               MOVE X"41" TO WS-INPUT(1:1)
           END-IF
           INITIALIZE TEXT-PARM
           MOVE WS-OP TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-INPUT
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           MOVE 1 TO TP-INPUT-LENGTH TP-OUTPUT-CAPACITY
           MOVE 999 TO TP-STATUS TP-OUTPUT-LENGTH
           MOVE X"FF" TO TP-REPLACED TP-TRUNCATED.

       CALL-AND-EXPECT-INTERNAL.
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-INTERNAL OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-OFF OR
              WS-OUTPUT NOT = LOW-VALUES
               ADD 1 TO WS-FAILURES
           END-IF.

       SAVE-INPUTS.
           SET WS-SAVED-INPUT-PTR TO TP-INPUT-PTR
           SET WS-SAVED-OUTPUT-PTR TO TP-OUTPUT-PTR
           MOVE TP-INPUT-LENGTH TO WS-SAVED-INPUT-LENGTH
           MOVE TP-OUTPUT-CAPACITY TO WS-SAVED-CAPACITY.

       ASSERT-INPUTS-PRESERVED.
           IF TP-INPUT-PTR NOT = WS-SAVED-INPUT-PTR OR
              TP-OUTPUT-PTR NOT = WS-SAVED-OUTPUT-PTR OR
              TP-INPUT-LENGTH NOT = WS-SAVED-INPUT-LENGTH OR
              TP-OUTPUT-CAPACITY NOT = WS-SAVED-CAPACITY OR
              TP-OPERATION NOT = WS-OP
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-VIEW-LIMITS.
           PERFORM PREPARE-TEXT
           MOVE TEXT-NATIVE-STRICT TO TP-OPERATION
           MOVE 16777217 TO TP-INPUT-LENGTH
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-CAPACITY OR
              TP-OUTPUT-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           PERFORM PREPARE-TEXT
           MOVE TEXT-NATIVE-STRICT TO TP-OPERATION
           MOVE 1 TO TP-INPUT-LENGTH
           MOVE 16777217 TO TP-OUTPUT-CAPACITY
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-CAPACITY OR
              TP-OUTPUT-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       PREPARE-TEXT.
           MOVE LOW-VALUES TO WS-OUTPUT
           INITIALIZE TEXT-PARM
           SET TP-INPUT-PTR TO ADDRESS OF WS-INPUT
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           MOVE 32 TO TP-OUTPUT-CAPACITY.

       END PROGRAM TSTZTXT.
