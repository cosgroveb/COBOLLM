       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTZLCH.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY ZLCHCTRL.
       01 WS-FAILURES PIC S9(9) COMP-5 VALUE ZERO.

       PROCEDURE DIVISION.
           PERFORM TEST-EXACT-BYTES
           PERFORM TEST-CHUNKED
           PERFORM TEST-EMPTY
           PERFORM TEST-MINIMUM
           PERFORM TEST-BOUNDARY-MINUS
           PERFORM TEST-BOUNDARY
           PERFORM TEST-OVERFLOW
           PERFORM TEST-OPEN-FAILURE
           PERFORM TEST-READ-FAILURE
           PERFORM TEST-ZERO-PROGRESS
           PERFORM TEST-CLOSE-FAILURE
           IF WS-FAILURES = ZERO
               DISPLAY "PASS ZOS LAUNCH"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL ZOS LAUNCH"
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       TEST-EXACT-BYTES.
           PERFORM RESET-FIXTURE
           MOVE 6 TO ZF-INPUT-LENGTH
           MOVE X"40C10025C240" TO ZF-INPUT(1:6)
           PERFORM CALL-LAUNCHER
           IF ZF-CALL-COUNT NOT = 1 OR
              ZF-STATUS NOT = STATUS-OK OR
              ZF-PLATFORM NOT = PLATFORM-ZOS OR
              ZF-ARG-COUNT NOT = 1 OR
              ZF-TASK-LENGTH NOT = 6 OR
              ZF-TASK(1:6) NOT = X"40C10025C240" OR
              ZF-OPEN-ARGS-VALID NOT = FLAG-ON OR
              ZF-OPEN-COUNT NOT = 1 OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-CHUNKED.
           PERFORM RESET-FIXTURE
           MOVE 5 TO ZF-INPUT-LENGTH
           MOVE 2 TO ZF-CHUNK-SIZE
           MOVE X"C1C2C3C4C5" TO ZF-INPUT(1:5)
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = 5 OR
              ZF-TASK(1:5) NOT = X"C1C2C3C4C5" OR
              ZF-READ-COUNT NOT = 4 OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-EMPTY.
           PERFORM RESET-FIXTURE
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = ZERO OR
              ZF-READ-COUNT NOT = 1 OR
              ZF-FERROR-COUNT NOT = 1 OR
              ZF-FEOF-COUNT NOT = 1 OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-BOUNDARY-MINUS.
           PERFORM RESET-FIXTURE
           MOVE 65534 TO ZF-INPUT-LENGTH
           MOVE ALL X"C1" TO ZF-INPUT(1:65534)
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = 65534 OR
              ZF-TASK(1:1) NOT = X"C1" OR
              ZF-TASK(65534:1) NOT = X"C1" OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-MINIMUM.
           PERFORM RESET-FIXTURE
           MOVE 1 TO ZF-INPUT-LENGTH
           MOVE X"40" TO ZF-INPUT(1:1)
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = 1 OR
              ZF-TASK(1:1) NOT = X"40"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-BOUNDARY.
           PERFORM RESET-FIXTURE
           MOVE 65535 TO ZF-INPUT-LENGTH
           MOVE ALL X"C1" TO ZF-INPUT(1:65535)
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = 65535 OR
              ZF-TASK(1:1) NOT = X"C1" OR
              ZF-TASK(65535:1) NOT = X"C1" OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-OVERFLOW.
           PERFORM RESET-FIXTURE
           MOVE 65536 TO ZF-INPUT-LENGTH
           MOVE ALL X"C1" TO ZF-INPUT
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-CAPACITY OR
              ZF-TASK-LENGTH NOT = ZERO OR
              ZF-READ-CURSOR NOT = 65536 OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-OPEN-FAILURE.
           PERFORM RESET-FIXTURE
           MOVE FLAG-ON TO ZF-OPEN-FAIL
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-INTERNAL OR
              ZF-OPEN-COUNT NOT = 1 OR
              ZF-READ-COUNT NOT = ZERO OR
              ZF-CLOSE-COUNT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-READ-FAILURE.
           PERFORM RESET-FIXTURE
           MOVE FLAG-ON TO ZF-READ-ERROR
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-INTERNAL OR
              ZF-FERROR-COUNT NOT = 1 OR
              ZF-FEOF-COUNT NOT = ZERO OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-ZERO-PROGRESS.
           PERFORM RESET-FIXTURE
           MOVE 1 TO ZF-INPUT-LENGTH
           MOVE FLAG-ON TO ZF-ZERO-PROGRESS
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-INTERNAL OR
              ZF-FERROR-COUNT NOT = 1 OR
              ZF-FEOF-COUNT NOT = 1 OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-CLOSE-FAILURE.
           PERFORM RESET-FIXTURE
           MOVE 1 TO ZF-INPUT-LENGTH
           MOVE X"C1" TO ZF-INPUT(1:1)
           MOVE 1 TO ZF-CLOSE-RESULT
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-INTERNAL OR
              ZF-CLOSE-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       RESET-FIXTURE.
           MOVE LOW-VALUES TO ZLAUNCH-FAKE-CONTROL
           MOVE SPACES TO ZF-TASK ZF-INPUT.

       CALL-LAUNCHER.
           CALL "ZOSLNCHR".

       END PROGRAM TSTZLCH.
