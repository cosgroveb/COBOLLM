       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTZLCH.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY ZLCHCTRL.
       01 WS-ARGC PIC S9(9) COMP-5.
       01 WS-LENGTH-ARRAY.
           05 WS-LENGTH-PTR USAGE POINTER OCCURS 3 TIMES.
       01 WS-VALUE-ARRAY.
           05 WS-VALUE-PTR USAGE POINTER OCCURS 3 TIMES.
       01 WS-ARG0-LENGTH PIC S9(9) COMP-5 VALUE 8.
       01 WS-ARG-LENGTH PIC S9(9) COMP-5.
       01 WS-ARG0 PIC X(8) VALUE X"8396829693939400".
       01 WS-ARG PIC X(65536).
       01 WS-FAILURES PIC S9(9) COMP-5 VALUE ZERO.

       PROCEDURE DIVISION.
           PERFORM TEST-MISSING
           PERFORM TEST-EMPTY
           PERFORM TEST-ONE
           PERFORM TEST-EXTRA
           PERFORM TEST-BAD-TERMINATOR
           PERFORM TEST-NULL-POINTERS
           PERFORM TEST-NATIVE-LENGTHS
           PERFORM TEST-BOUNDARY-MINUS
           PERFORM TEST-BOUNDARY
           PERFORM TEST-OVERFLOW
           IF WS-FAILURES = ZERO
               DISPLAY "PASS ZOS LAUNCH"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL ZOS LAUNCH"
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       TEST-MISSING.
           PERFORM RESET-FIXTURE
           MOVE 1 TO WS-ARGC
           PERFORM CALL-LAUNCHER
           IF ZF-CALL-COUNT NOT = 1 OR ZF-STATUS NOT = STATUS-OK OR
              ZF-ARG-COUNT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-EMPTY.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE 1 TO WS-ARG-LENGTH
           MOVE X"00" TO WS-ARG(1:1)
           PERFORM SET-ARG-POINTERS
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-ARG-COUNT NOT = 1 OR ZF-TASK-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-ONE.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE 7 TO WS-ARG-LENGTH
           MOVE X"40C140C2404000" TO WS-ARG(1:7)
           PERFORM SET-ARG-POINTERS
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = 4 OR
              ZF-TASK(1:4) NOT = X"40C140C2"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-EXTRA.
           PERFORM RESET-FIXTURE
           MOVE 3 TO WS-ARGC
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR ZF-ARG-COUNT NOT = 2
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-BAD-TERMINATOR.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE 2 TO WS-ARG-LENGTH
           MOVE X"C1C2" TO WS-ARG(1:2)
           PERFORM SET-ARG-POINTERS
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-INTERNAL
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-NULL-POINTERS.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           SET WS-LENGTH-PTR(2) TO NULL
           SET WS-VALUE-PTR(2) TO ADDRESS OF WS-ARG
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-INTERNAL
               ADD 1 TO WS-FAILURES
           END-IF
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE 2 TO WS-ARG-LENGTH
           SET WS-LENGTH-PTR(2) TO ADDRESS OF WS-ARG-LENGTH
           SET WS-VALUE-PTR(2) TO NULL
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-INTERNAL
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-NATIVE-LENGTHS.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE ZERO TO WS-ARG-LENGTH
           MOVE ALL X"FF" TO WS-ARG
           SET WS-LENGTH-PTR(2) TO ADDRESS OF WS-ARG-LENGTH
           SET WS-VALUE-PTR(2) TO ADDRESS OF WS-ARG
           PERFORM CALL-LAUNCHER
           IF ZF-CALL-COUNT NOT = 1 OR
              ZF-STATUS NOT = STATUS-INTERNAL OR
              ZF-TASK-LENGTH NOT = ZERO OR
              ZF-TASK NOT = SPACES
               ADD 1 TO WS-FAILURES
           END-IF
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE -1 TO WS-ARG-LENGTH
           MOVE ALL X"FF" TO WS-ARG
           SET WS-LENGTH-PTR(2) TO ADDRESS OF WS-ARG-LENGTH
           SET WS-VALUE-PTR(2) TO ADDRESS OF WS-ARG
           PERFORM CALL-LAUNCHER
           IF ZF-CALL-COUNT NOT = 1 OR
              ZF-STATUS NOT = STATUS-INTERNAL OR
              ZF-TASK-LENGTH NOT = ZERO OR
              ZF-TASK NOT = SPACES
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-BOUNDARY.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE ALL X"C1" TO WS-ARG
           MOVE X"00" TO WS-ARG(65536:1)
           MOVE 65536 TO WS-ARG-LENGTH
           PERFORM SET-ARG-POINTERS
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = 65535 OR
              ZF-TASK(1:1) NOT = X"C1" OR
              ZF-TASK(65535:1) NOT = X"C1"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-BOUNDARY-MINUS.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE ALL X"C1" TO WS-ARG
           MOVE X"00" TO WS-ARG(65535:1)
           MOVE 65535 TO WS-ARG-LENGTH
           PERFORM SET-ARG-POINTERS
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-OK OR
              ZF-TASK-LENGTH NOT = 65534 OR
              ZF-TASK(1:1) NOT = X"C1" OR
              ZF-TASK(65534:1) NOT = X"C1"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-OVERFLOW.
           PERFORM RESET-FIXTURE
           MOVE 2 TO WS-ARGC
           MOVE 65537 TO WS-ARG-LENGTH
           PERFORM SET-ARG-POINTERS
           PERFORM CALL-LAUNCHER
           IF ZF-STATUS NOT = STATUS-CAPACITY
               ADD 1 TO WS-FAILURES
           END-IF.

       RESET-FIXTURE.
           MOVE LOW-VALUES TO ZLAUNCH-FAKE-CONTROL
           MOVE SPACES TO ZF-TASK WS-ARG
           SET WS-LENGTH-PTR(1) TO ADDRESS OF WS-ARG0-LENGTH
           SET WS-VALUE-PTR(1) TO ADDRESS OF WS-ARG0
           SET WS-LENGTH-PTR(2) WS-LENGTH-PTR(3) TO NULL
           SET WS-VALUE-PTR(2) WS-VALUE-PTR(3) TO NULL.

       SET-ARG-POINTERS.
           SET WS-LENGTH-PTR(2) TO ADDRESS OF WS-ARG-LENGTH
           SET WS-VALUE-PTR(2) TO ADDRESS OF WS-ARG.

       CALL-LAUNCHER.
           CALL "ZOSLNCHR" USING WS-ARGC WS-LENGTH-ARRAY
               WS-VALUE-ARRAY.

       END PROGRAM TSTZLCH.
