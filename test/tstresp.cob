       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTRESP.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY RESPPARM.
       COPY FHCTRL.
       01  TEST-MODEL              PIC X(8) VALUE "gpt-test".
       01  TEST-URL                PIC X(15) VALUE "https://example".
       01  TEST-KEY                PIC X(8) VALUE "test-key".
       01  TEST-TASK               PIC X(17) VALUE "say hello".
       01  TEST-SHELL              PIC X(1048576).
       01  TEST-ACTION             PIC X(1048576).
       01  EXPECTED-STATUS         PIC S9(9) COMP-5.
       01  EXPECTED-CATEGORY       PIC S9(9) COMP-5.
       01  EXPECTED-HTTP           PIC S9(9) COMP-5.
       01  TEST-OPERATION          PIC S9(9) COMP-5.
       01  TEST-INDEX              PIC 9(3) VALUE ZERO.
       01  SCHEMA-INDEX            PIC 9(3) VALUE ZERO.
       01  FAILURE-COUNT           PIC 9(4) VALUE ZERO.
       01  BOUNDARY-MODE           PIC S9(9) COMP-5.

       PROCEDURE DIVISION.
       MAIN.
           PERFORM SET-COMMON
           MOVE RESP-START TO RP-OPERATION
           SET RP-TASK-PTR TO ADDRESS OF TEST-TASK
           MOVE 9 TO RP-TASK-LENGTH
           CALL "RESPAPI" USING RESP-PARM
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-SHELL
             OR RP-ACTION-LENGTH NOT = 9
             OR TEST-ACTION(1:9) NOT = "printf hi"
               DISPLAY "FAIL RESPAPI SHELL"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM SET-COMMON
           MOVE RESP-CONTINUE TO RP-OPERATION
           MOVE SHELL-EXIT TO RP-SHELL-STATUS
           MOVE 0 TO RP-SHELL-EXIT
           MOVE FLAG-OFF TO RP-SHELL-TRUNCATED
               RP-SHELL-ENCODING-LOSS
           MOVE ALL "x" TO TEST-SHELL
           SET RP-SHELL-OUTPUT-PTR TO ADDRESS OF TEST-SHELL
           MOVE 1048576 TO RP-SHELL-OUTPUT-LENGTH
           CALL "RESPAPI" USING RESP-PARM
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 4
             OR TEST-ACTION(1:4) NOT = "done"
               DISPLAY "FAIL RESPAPI FINAL"
               ADD 1 TO FAILURE-COUNT
           END-IF

           INITIALIZE RESP-PARM
           MOVE RESP-DESTROY TO RP-OPERATION
           CALL "RESPAPI" USING RESP-PARM
           IF RP-STATUS NOT = STATUS-OK
               DISPLAY "FAIL RESPAPI DESTROY"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 2
             OR TEST-ACTION(1:2) NOT = "ok"
               DISPLAY "FAIL RESPAPI FULL SCHEMA"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM 6 TIMES
               PERFORM START-CALL
               IF RP-STATUS NOT = STATUS-RESPONSES
                 OR RP-ACTION NOT = ACTION-NONE
                 OR RP-ACTION-LENGTH NOT = 0
                   DISPLAY "FAIL RESPAPI SCHEMA REJECTION"
                   ADD 1 TO FAILURE-COUNT
               END-IF
           END-PERFORM

           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 0
               DISPLAY "FAIL RESPAPI EMPTY FINAL"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 1
             OR TEST-ACTION(1:1) NOT = "F"
               DISPLAY "FAIL RESPAPI PHASE SELECTION"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM 6 TIMES
               PERFORM START-CALL
               IF RP-STATUS NOT = STATUS-RESPONSES
                 OR RP-ACTION NOT = ACTION-NONE
                 OR RP-ACTION-LENGTH NOT = 0
                   DISPLAY "FAIL RESPAPI RESPONSE REJECTION"
                   ADD 1 TO FAILURE-COUNT
               END-IF
           END-PERFORM

           MOVE STATUS-HTTP-CODE TO EXPECTED-STATUS
           MOVE CATEGORY-PROTOCOL TO EXPECTED-CATEGORY
           MOVE 429 TO EXPECTED-HTTP
           PERFORM EXPECT-HTTP-MAPPING
           MOVE STATUS-HTTP TO EXPECTED-STATUS
           MOVE CATEGORY-PROTOCOL TO EXPECTED-CATEGORY
           MOVE 0 TO EXPECTED-HTTP
           PERFORM EXPECT-HTTP-MAPPING
           MOVE STATUS-RESPONSES TO EXPECTED-STATUS
           PERFORM EXPECT-HTTP-MAPPING
           MOVE STATUS-JSON TO EXPECTED-STATUS
           PERFORM EXPECT-HTTP-MAPPING
           MOVE STATUS-NETWORK TO EXPECTED-STATUS
           MOVE CATEGORY-NETWORK TO EXPECTED-CATEGORY
           PERFORM EXPECT-HTTP-MAPPING
           MOVE STATUS-CAPACITY TO EXPECTED-STATUS
           MOVE CATEGORY-CAPACITY TO EXPECTED-CATEGORY
           PERFORM EXPECT-HTTP-MAPPING
           MOVE STATUS-INTERNAL TO EXPECTED-STATUS
           MOVE CATEGORY-INTERNAL TO EXPECTED-CATEGORY
           PERFORM EXPECT-HTTP-MAPPING

           PERFORM SET-COMMON
           MOVE RESP-CONTINUE TO RP-OPERATION
           CALL "RESPAPI" USING RESP-PARM
           IF RP-STATUS NOT = STATUS-INTERNAL
             OR RP-ERROR-CATEGORY NOT = CATEGORY-INTERNAL
             OR RP-ACTION NOT = ACTION-NONE
             OR RP-ACTION-LENGTH NOT = 0
               DISPLAY "FAIL RESPAPI FAILURE STATE RESET"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 2
             OR TEST-ACTION(1:2) NOT = "ok"
               DISPLAY "FAIL RESPAPI LARGE REPLAY STRING"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-SHELL
             OR TEST-ACTION(1:9) NOT = "printf hi"
               DISPLAY "FAIL RESPAPI RETAINED SETUP"
               ADD 1 TO FAILURE-COUNT
           END-IF
           PERFORM SET-COMMON
           MOVE RESP-CONTINUE TO RP-OPERATION
           MOVE SHELL-EXIT TO RP-SHELL-STATUS
           MOVE FLAG-OFF TO RP-SHELL-TRUNCATED
               RP-SHELL-ENCODING-LOSS
           CALL "RESPAPI" USING RESP-PARM
           IF RP-STATUS NOT = STATUS-NETWORK
             OR RP-ERROR-CATEGORY NOT = CATEGORY-NETWORK
             OR RP-ACTION NOT = ACTION-NONE
             OR RP-ACTION-LENGTH NOT = 0
               DISPLAY "FAIL RESPAPI RETAINED HISTORY SEND"
               ADD 1 TO FAILURE-COUNT
           END-IF
           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 4
             OR TEST-ACTION(1:4) NOT = "done"
               DISPLAY "FAIL RESPAPI POST-FAILURE STATE"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-JSON
             OR RP-ERROR-CATEGORY NOT = CATEGORY-PROTOCOL
             OR RP-ACTION NOT = ACTION-NONE
             OR RP-ACTION-LENGTH NOT = 0
               DISPLAY "FAIL RESPAPI MALFORMED JSON STATUS"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-SHELL
             OR RP-ACTION-LENGTH NOT = 65535
             OR TEST-ACTION(1:1) NOT = X'61'
             OR TEST-ACTION(65535:1) NOT = X'61'
               DISPLAY "FAIL RESPAPI COMMAND EXACT LIMIT"
               ADD 1 TO FAILURE-COUNT
           END-IF
           INITIALIZE RESP-PARM
           MOVE RESP-DESTROY TO RP-OPERATION
           CALL "RESPAPI" USING RESP-PARM
           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-CAPACITY
             OR RP-ERROR-CATEGORY NOT = CATEGORY-CAPACITY
               DISPLAY "FAIL RESPAPI COMMAND OVERFLOW"
               ADD 1 TO FAILURE-COUNT
           END-IF
           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 1048576
             OR TEST-ACTION(1:1) NOT = X'61'
             OR TEST-ACTION(1048576:1) NOT = X'61'
               DISPLAY "FAIL RESPAPI FINAL EXACT LIMIT"
               DISPLAY "  STATUS=" RP-STATUS " ACTION=" RP-ACTION
                   " LENGTH=" RP-ACTION-LENGTH
               ADD 1 TO FAILURE-COUNT
           END-IF
           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-CAPACITY
             OR RP-ERROR-CATEGORY NOT = CATEGORY-CAPACITY
               DISPLAY "FAIL RESPAPI FINAL OVERFLOW"
               ADD 1 TO FAILURE-COUNT
           END-IF
           PERFORM START-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 2
             OR TEST-ACTION(1:2) NOT = "ok"
               DISPLAY "FAIL RESPAPI LARGE COMMENTARY REPLAY"
               ADD 1 TO FAILURE-COUNT
           END-IF

           PERFORM TEST-QUOTED-REQUEST
           PERFORM TEST-PWD-REQUESTS
           MOVE "say hello" TO TEST-TASK
           PERFORM TEST-SCHEMA-MATRIX
           PERFORM TEST-TOP-LEVEL-SCHEMA
           PERFORM TEST-REPLAY-SCHEMA
           PERFORM TEST-PHASE-REFUSAL
           PERFORM TEST-REASONING-STATUS
           PERFORM TEST-REASONING-TEXT
           PERFORM TEST-FINAL-CONTENT
           PERFORM TEST-DEFERRED-LEGACY-OVERFLOW
           PERFORM TEST-OVERSIZED-FINAL-WITH-TOOL
           PERFORM TEST-REFUSAL-REPLAY
           PERFORM TEST-CALL-ID-MATRIX
           PERFORM TEST-CALL-ID-CAPACITY
           PERFORM TEST-BOUNDARIES

           PERFORM TEST-CALL-CONTRACTS

           IF FAILURE-COUNT = ZERO
               DISPLAY "PASS RESPAPI"
               MOVE ZERO TO RETURN-CODE
           ELSE
               MOVE 1 TO RETURN-CODE
           END-IF
           STOP RUN.

       SET-COMMON.
           INITIALIZE RESP-PARM
           SET RP-MODEL-PTR TO ADDRESS OF TEST-MODEL
           MOVE 8 TO RP-MODEL-LENGTH
           SET RP-URL-PTR TO ADDRESS OF TEST-URL
           MOVE 15 TO RP-URL-LENGTH
           SET RP-KEY-PTR TO ADDRESS OF TEST-KEY
           MOVE 8 TO RP-KEY-LENGTH
           SET RP-ACTION-PTR TO ADDRESS OF TEST-ACTION
           MOVE LIMIT-FINAL TO RP-ACTION-CAPACITY.

