             OR RP-ERROR-CATEGORY NOT = EXPECTED-CATEGORY
             OR RP-HTTP-STATUS NOT = EXPECTED-HTTP
             OR RP-ACTION NOT = ACTION-NONE
             OR RP-ACTION-LENGTH NOT = 0
               DISPLAY "FAIL RESPAPI HTTP STATUS MAPPING"
               ADD 1 TO FAILURE-COUNT
           END-IF.

       TEST-PWD-REQUESTS.
           MOVE SPACES TO TEST-TASK
           MOVE "Run pwd" TO TEST-TASK(1:7)
           PERFORM START-PWD-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-SHELL
             OR RP-ACTION-LENGTH NOT = 3
             OR TEST-ACTION(1:3) NOT = "pwd"
               DISPLAY "FAIL RESPAPI PWD FIRST REQUEST"
               ADD 1 TO FAILURE-COUNT
               EXIT PARAGRAPH
           END-IF
           PERFORM CONTINUE-PWD-CALL
           IF RP-STATUS NOT = STATUS-RESPONSES
             OR RP-ERROR-CATEGORY NOT = CATEGORY-PROTOCOL
             OR RP-ACTION NOT = ACTION-NONE
             OR RP-ACTION-LENGTH NOT = ZERO
               DISPLAY "FAIL RESPAPI PWD REJECT ROLLBACK"
               ADD 1 TO FAILURE-COUNT
           END-IF
           PERFORM START-PWD-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-SHELL
             OR RP-ACTION-LENGTH NOT = 3
             OR TEST-ACTION(1:3) NOT = "pwd"
               DISPLAY "FAIL RESPAPI PWD RETRY REQUEST"
               ADD 1 TO FAILURE-COUNT
               EXIT PARAGRAPH
           END-IF
           PERFORM CONTINUE-PWD-CALL
           IF RP-STATUS NOT = STATUS-OK
             OR RP-ACTION NOT = ACTION-FINAL
             OR RP-ACTION-LENGTH NOT = 4
             OR TEST-ACTION(1:4) NOT = "done"
               DISPLAY "FAIL RESPAPI PWD CONTINUATION REQUEST"
               ADD 1 TO FAILURE-COUNT
           END-IF
           PERFORM DESTROY-CALL.

       TEST-QUOTED-REQUEST.
           MOVE X'466978202271756F746564220A70617468' TO TEST-TASK
           PERFORM SET-COMMON
           MOVE RESP-START TO RP-OPERATION
           SET RP-TASK-PTR TO ADDRESS OF TEST-TASK
           MOVE 17 TO RP-TASK-LENGTH
