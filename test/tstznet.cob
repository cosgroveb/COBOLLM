       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTZNET.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY NETPARM.
       COPY TXTPARM.
       COPY EZAFCTRL.
       COPY SIGFCTRL.
       01 WS-HOST PIC X(254).
       01 WS-VERIFY PIC X(254).
       01 WS-BUFFER PIC X(16).
       01 WS-FAILURES PIC S9(9) COMP-5 VALUE ZERO.
       01 WS-EXPECTED-TRACE PIC X(16).
       01 WS-EXPECTED-LENGTH PIC S9(9) COMP-5.
       01 WS-TEST-PORT PIC S9(9) COMP-5.
       01 WS-VALIDATION-CASE PIC S9(9) COMP-5.
       01 WS-BEFORE-CALLS PIC S9(9) COMP-5.
       01 WS-TLS-CASE PIC S9(9) COMP-5.

       PROCEDURE DIVISION.
           PERFORM TEST-CLOSED-OPERATIONS
           PERFORM TEST-TLS13
           PERFORM TEST-TLS12
           PERFORM TEST-TLS-REJECTION
           PERFORM TEST-GETADDRINFO-FAILURE
           PERFORM TEST-INITAPI-FAILURE
           PERFORM TEST-CONNECT-EINTR
           PERFORM TEST-CONNECT-CLOSE-FAILURE
           PERFORM TEST-CLOSE-FAILURE
           PERFORM TEST-FREE-FAILURE
           PERFORM TEST-TERM-FAILURE
           PERFORM TEST-HOST-MISMATCH
           PERFORM TEST-PARAMETERS
           PERFORM TEST-TEXT-BOUNDS
           PERFORM TEST-NODE-BOUNDS
           PERFORM TEST-PORT-BOUNDS
           PERFORM TEST-SIGNAL-RESTORE-SUCCESS
           PERFORM TEST-SIGNAL-RESTORE-FAILURE
           IF WS-FAILURES = ZERO
               DISPLAY "PASS ZOS NET"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL ZOS NET"
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       TEST-TLS13.
           PERFORM RESET-FAKE
           MOVE ZERO TO EF-MODE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-OK OR
              EF-NODE-LENGTH NOT = 14 OR
              EF-NODE(1:14) NOT = X"8197894B9697859581894B839694" OR
              EF-SERVICE-LENGTH NOT = 3 OR
              EF-SERVICE(1:3) NOT = X"F4F4F3" OR
              EF-QUERY-VALID NOT = FLAG-ON OR
              EF-IOCTL-VALID NOT = FLAG-ON
               ADD 1 TO WS-FAILURES
           END-IF
           IF NP-STATUS = STATUS-OK
               PERFORM TEST-SECOND-OPEN
               MOVE X"414243" TO WS-BUFFER
               INITIALIZE NET-PARM
               MOVE NET-WRITE TO NP-OPERATION
               SET NP-BUFFER-PTR TO ADDRESS OF WS-BUFFER
               MOVE 16 TO NP-BUFFER-CAPACITY
               MOVE 3 TO NP-REQUEST-LENGTH
               CALL "NETIO" USING NET-PARM
               IF NP-STATUS NOT = STATUS-OK OR
                  NP-TRANSFERRED NOT = 3
                   ADD 1 TO WS-FAILURES
               END-IF
               IF EF-WRITE-BYTES(1:3) NOT = X"414243"
                   ADD 1 TO WS-FAILURES
               END-IF
               MOVE LOW-VALUES TO WS-BUFFER
               INITIALIZE NET-PARM
               MOVE NET-READ TO NP-OPERATION
               SET NP-BUFFER-PTR TO ADDRESS OF WS-BUFFER
               MOVE 16 TO NP-BUFFER-CAPACITY
               CALL "NETIO" USING NET-PARM
               IF NP-STATUS NOT = STATUS-OK OR
                  NP-TRANSFERRED NOT = 3 OR
                  WS-BUFFER(1:3) NOT = X"58595A"
                   ADD 1 TO WS-FAILURES
               END-IF
               PERFORM CLOSE-TLS
           END-IF
           MOVE "IGSCFQWRXT" TO WS-EXPECTED-TRACE
           MOVE 10 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE
           IF EF-WRITE-COUNT NOT = 1 OR EF-WRITTEN NOT = 3 OR
              EF-READ-COUNT NOT = 1 OR EF-TERM-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-TEXT-BOUNDS.
           INITIALIZE TEXT-PARM
           MOVE TEXT-NATIVE-STRICT TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-HOST
           MOVE 16777217 TO TP-INPUT-LENGTH
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-BUFFER
           MOVE 16 TO TP-OUTPUT-CAPACITY
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-CAPACITY OR
              TP-OUTPUT-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           INITIALIZE TEXT-PARM
           MOVE TEXT-NATIVE-STRICT TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-HOST
           MOVE 1 TO TP-INPUT-LENGTH
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-BUFFER
           MOVE 16777217 TO TP-OUTPUT-CAPACITY
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-CAPACITY OR
              TP-OUTPUT-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-TLS12.
           PERFORM RESET-FAKE
           MOVE 5 TO EF-MODE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-OK ADD 1 TO WS-FAILURES END-IF
           IF NP-STATUS = STATUS-OK PERFORM CLOSE-TLS END-IF
           MOVE "IGSCFQXT" TO WS-EXPECTED-TRACE
           MOVE 8 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE.

       TEST-TLS-REJECTION.
           PERFORM VARYING WS-TLS-CASE FROM 1 BY 1
               UNTIL WS-TLS-CASE > 12
               PERFORM RESET-FAKE
               EVALUATE WS-TLS-CASE
                   WHEN 1 MOVE 3 TO EF-MODE
                   WHEN 2 MOVE 6 TO EF-MODE
                   WHEN 10 MOVE 16 TO EF-MODE
                   WHEN 11 MOVE 17 TO EF-MODE
                   WHEN 12 MOVE 15 TO EF-MODE
                   WHEN OTHER COMPUTE EF-MODE = WS-TLS-CASE + 5
               END-EVALUATE
               PERFORM SET-DEFAULT-HOST
               MOVE 443 TO WS-TEST-PORT
               PERFORM OPEN-TLS
               IF NP-STATUS NOT = STATUS-NETWORK OR
                  EF-WRITE-COUNT NOT = ZERO OR
                  EF-TERM-COUNT NOT = 1 OR
                  EF-QUERY-VALID NOT = FLAG-ON OR
                  EF-IOCTL-VALID NOT = FLAG-ON
                   ADD 1 TO WS-FAILURES
               END-IF
               MOVE "IGSCFQXT" TO WS-EXPECTED-TRACE
               MOVE 8 TO WS-EXPECTED-LENGTH
               PERFORM CHECK-TRACE
           END-PERFORM.

       TEST-GETADDRINFO-FAILURE.
           PERFORM RESET-FAKE
           MOVE 2 TO EF-MODE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-TERM-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "IGT" TO WS-EXPECTED-TRACE
           MOVE 3 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE.

       TEST-INITAPI-FAILURE.
           PERFORM RESET-FAKE
           MOVE 1 TO EF-MODE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-TERM-COUNT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "I" TO WS-EXPECTED-TRACE
           MOVE 1 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE.

       TEST-CONNECT-EINTR.
           PERFORM RESET-FAKE
           MOVE 7 TO EF-MODE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-OK OR EF-CONNECT-COUNT NOT = 2
               ADD 1 TO WS-FAILURES
           END-IF
           IF NP-STATUS = STATUS-OK PERFORM CLOSE-TLS END-IF
           MOVE "IGSCXSCFQXT" TO WS-EXPECTED-TRACE
           MOVE 11 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE.

       TEST-CONNECT-CLOSE-FAILURE.
           PERFORM RESET-FAKE
           MOVE 4 TO EF-MODE
           MOVE 1 TO EF-CLOSE-FAILURES
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-CONNECT-COUNT NOT = 1 OR
              EF-CLOSE-COUNT NOT = 2 OR
              EF-FREE-COUNT NOT = 1 OR
              EF-TERM-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "IGSCXFXT" TO WS-EXPECTED-TRACE
           MOVE 8 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE.

       TEST-CLOSE-FAILURE.
           PERFORM RESET-FAKE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           MOVE 1 TO EF-CLOSE-FAILURES
           INITIALIZE NET-PARM
           MOVE NET-CLOSE TO NP-OPERATION
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-CLOSE-COUNT NOT = 1 OR
              EF-FREE-COUNT NOT = 1 OR
              EF-TERM-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "IGSCFQXT" TO WS-EXPECTED-TRACE
           MOVE 8 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE
           INITIALIZE NET-PARM
           MOVE NET-CLOSE TO NP-OPERATION
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-OK OR
              EF-TRACE-LENGTH NOT = 8
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-FREE-FAILURE.
           PERFORM RESET-FAKE
           MOVE 1 TO EF-FREE-FAILURES
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-CLOSE-COUNT NOT = 1 OR
              EF-FREE-COUNT NOT = 2 OR
              EF-TERM-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "IGSCFXFT" TO WS-EXPECTED-TRACE
           MOVE 9 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE
           INITIALIZE NET-PARM
           MOVE NET-CLOSE TO NP-OPERATION
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-OK OR
              EF-TRACE-LENGTH NOT = 9
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-TERM-FAILURE.
           PERFORM RESET-FAKE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           MOVE 1 TO EF-TERM-FAILURES
           INITIALIZE NET-PARM
           MOVE NET-CLOSE TO NP-OPERATION
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-CLOSE-COUNT NOT = 1 OR
              EF-FREE-COUNT NOT = 1 OR
              EF-TERM-COUNT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "IGSCFQXT" TO WS-EXPECTED-TRACE
           MOVE 8 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE
           INITIALIZE NET-PARM
           MOVE NET-CLOSE TO NP-OPERATION
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-OK OR
              EF-CLOSE-COUNT NOT = 1 OR
              EF-FREE-COUNT NOT = 1 OR
              EF-TERM-COUNT NOT = 2
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE "IGSCFQXTT" TO WS-EXPECTED-TRACE
           MOVE 9 TO WS-EXPECTED-LENGTH
           PERFORM CHECK-TRACE.

       TEST-HOST-MISMATCH.
           PERFORM RESET-FAKE
           PERFORM SET-DEFAULT-HOST
           MOVE X"62" TO WS-VERIFY(1:1)
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-INTERNAL OR
              EF-CALL-COUNT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-PARAMETERS.
           PERFORM VARYING WS-VALIDATION-CASE FROM 1 BY 1
               UNTIL WS-VALIDATION-CASE > 10
               PERFORM RESET-FAKE
               PERFORM PREPARE-OPEN
               EVALUATE WS-VALIDATION-CASE
                   WHEN 1 SET NP-CONNECT-HOST-PTR TO NULL
                   WHEN 2 SET NP-VERIFY-HOST-PTR TO NULL
                   WHEN 3 MOVE ZERO TO NP-CONNECT-HOST-LENGTH
                   WHEN 4 MOVE ZERO TO NP-VERIFY-HOST-LENGTH
                   WHEN 5 SET NP-BUFFER-PTR TO ADDRESS OF WS-BUFFER
                   WHEN 6 MOVE 1 TO NP-BUFFER-CAPACITY
                   WHEN 7 MOVE 1 TO NP-REQUEST-LENGTH
                   WHEN 8 MOVE ZERO TO NP-PORT
                   WHEN 9 MOVE NET-PLAINTEXT TO NP-SCHEME
                   WHEN 10 MOVE 99 TO NP-OPERATION
               END-EVALUATE
               CALL "NETIO" USING NET-PARM
               IF NP-STATUS NOT = STATUS-INTERNAL OR
                  EF-CALL-COUNT NOT = ZERO
                   ADD 1 TO WS-FAILURES
               END-IF
           END-PERFORM
           PERFORM RESET-FAKE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-OK
               ADD 1 TO WS-FAILURES
               EXIT PARAGRAPH
           END-IF
           MOVE EF-CALL-COUNT TO WS-BEFORE-CALLS
           PERFORM VARYING WS-VALIDATION-CASE FROM 11 BY 1
               UNTIL WS-VALIDATION-CASE > 35
               EVALUATE TRUE
                   WHEN WS-VALIDATION-CASE < 20
                       PERFORM PREPARE-WRITE
                   WHEN WS-VALIDATION-CASE < 28
                       PERFORM PREPARE-READ
                   WHEN OTHER
                       INITIALIZE NET-PARM
                       MOVE NET-CLOSE TO NP-OPERATION
               END-EVALUATE
               EVALUATE WS-VALIDATION-CASE
                   WHEN 11 SET NP-CONNECT-HOST-PTR TO
                       ADDRESS OF WS-HOST
                   WHEN 12 MOVE 1 TO NP-CONNECT-HOST-LENGTH
                   WHEN 13 SET NP-VERIFY-HOST-PTR TO
                       ADDRESS OF WS-VERIFY
                   WHEN 14 MOVE 1 TO NP-VERIFY-HOST-LENGTH
                   WHEN 15 SET NP-BUFFER-PTR TO NULL
                   WHEN 16 MOVE -1 TO NP-BUFFER-CAPACITY
                   WHEN 17 MOVE 65537 TO NP-BUFFER-CAPACITY
                   WHEN 18 MOVE -1 TO NP-REQUEST-LENGTH
                   WHEN 19 MOVE 17 TO NP-REQUEST-LENGTH
                   WHEN 20 SET NP-CONNECT-HOST-PTR TO
                       ADDRESS OF WS-HOST
                   WHEN 21 MOVE 1 TO NP-CONNECT-HOST-LENGTH
                   WHEN 22 SET NP-VERIFY-HOST-PTR TO
                       ADDRESS OF WS-VERIFY
                   WHEN 23 MOVE 1 TO NP-VERIFY-HOST-LENGTH
                   WHEN 24 SET NP-BUFFER-PTR TO NULL
                   WHEN 25 MOVE ZERO TO NP-BUFFER-CAPACITY
                   WHEN 26 MOVE 65537 TO NP-BUFFER-CAPACITY
                   WHEN 27 MOVE 1 TO NP-REQUEST-LENGTH
                   WHEN 28 SET NP-CONNECT-HOST-PTR TO
                       ADDRESS OF WS-HOST
                   WHEN 29 MOVE 1 TO NP-CONNECT-HOST-LENGTH
                   WHEN 30 SET NP-VERIFY-HOST-PTR TO
                       ADDRESS OF WS-VERIFY
                   WHEN 31 MOVE 1 TO NP-VERIFY-HOST-LENGTH
                   WHEN 32 SET NP-BUFFER-PTR TO
                       ADDRESS OF WS-BUFFER
                   WHEN 33 MOVE 1 TO NP-BUFFER-CAPACITY
                   WHEN 34 MOVE 1 TO NP-REQUEST-LENGTH
                   WHEN 35 MOVE 99 TO NP-OPERATION
               END-EVALUATE
               CALL "NETIO" USING NET-PARM
               IF NP-STATUS NOT = STATUS-INTERNAL OR
                  EF-CALL-COUNT NOT = WS-BEFORE-CALLS
                   ADD 1 TO WS-FAILURES
               END-IF
           END-PERFORM
           PERFORM CLOSE-TLS.

       TEST-CLOSED-OPERATIONS.
           PERFORM RESET-FAKE
           PERFORM PREPARE-WRITE
           MOVE 777 TO NP-STATUS NP-TRANSFERRED
           MOVE X"FF" TO NP-EOF
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-INTERNAL OR
              NP-TRANSFERRED NOT = ZERO OR NP-EOF NOT = FLAG-OFF OR
              EF-CALL-COUNT NOT = ZERO OR
              NP-BUFFER-PTR NOT = ADDRESS OF WS-BUFFER OR
              NP-BUFFER-CAPACITY NOT = 16 OR NP-REQUEST-LENGTH NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           PERFORM PREPARE-READ
           MOVE 777 TO NP-STATUS NP-TRANSFERRED
           MOVE X"FF" TO NP-EOF
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-INTERNAL OR
              NP-TRANSFERRED NOT = ZERO OR NP-EOF NOT = FLAG-OFF OR
              EF-CALL-COUNT NOT = ZERO OR
              NP-BUFFER-PTR NOT = ADDRESS OF WS-BUFFER OR
              NP-BUFFER-CAPACITY NOT = 16 OR
              NP-REQUEST-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-SECOND-OPEN.
           MOVE EF-CALL-COUNT TO WS-BEFORE-CALLS
           PERFORM PREPARE-OPEN
           MOVE 777 TO NP-STATUS NP-TRANSFERRED
           MOVE X"FF" TO NP-EOF
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-INTERNAL OR
              NP-TRANSFERRED NOT = ZERO OR NP-EOF NOT = FLAG-OFF OR
              EF-CALL-COUNT NOT = WS-BEFORE-CALLS OR
              NP-SCHEME NOT = NET-TLS OR NP-PORT NOT = 443 OR
              NP-CONNECT-HOST-PTR NOT = ADDRESS OF WS-HOST OR
              NP-CONNECT-HOST-LENGTH NOT = 14 OR
              NP-VERIFY-HOST-PTR NOT = ADDRESS OF WS-VERIFY OR
              NP-VERIFY-HOST-LENGTH NOT = 14
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-NODE-BOUNDS.
           PERFORM RESET-FAKE
           MOVE ALL X"61" TO WS-HOST WS-VERIFY
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-252
           IF NP-STATUS NOT = STATUS-OK OR
              EF-NODE-LENGTH NOT = 252 OR
              EF-NODE(1:252) NOT = ALL X"81"
               ADD 1 TO WS-FAILURES
           END-IF
           IF NP-STATUS = STATUS-OK PERFORM CLOSE-TLS END-IF
           PERFORM RESET-FAKE
           MOVE ALL X"61" TO WS-HOST WS-VERIFY
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-253
           IF NP-STATUS NOT = STATUS-OK OR
              EF-NODE-LENGTH NOT = 253 OR
              EF-NODE NOT = ALL X"81"
               ADD 1 TO WS-FAILURES
           END-IF
           IF NP-STATUS = STATUS-OK PERFORM CLOSE-TLS END-IF
           PERFORM RESET-FAKE
           MOVE ALL X"61" TO WS-HOST WS-VERIFY
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-254
           IF NP-STATUS NOT = STATUS-CAPACITY OR
              EF-CALL-COUNT NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-PORT-BOUNDS.
           PERFORM RESET-FAKE
           PERFORM SET-DEFAULT-HOST
           MOVE 1 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-OK OR
              EF-SERVICE-LENGTH NOT = 1 OR
              EF-SERVICE(1:1) NOT = X"F1"
               ADD 1 TO WS-FAILURES
           END-IF
           IF NP-STATUS = STATUS-OK PERFORM CLOSE-TLS END-IF
           PERFORM RESET-FAKE
           PERFORM SET-DEFAULT-HOST
           MOVE 65535 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-OK OR
              EF-SERVICE-LENGTH NOT = 5 OR
              EF-SERVICE(1:5) NOT = X"F6F5F5F3F5"
               ADD 1 TO WS-FAILURES
           END-IF
           IF NP-STATUS = STATUS-OK PERFORM CLOSE-TLS END-IF.

       TEST-SIGNAL-RESTORE-SUCCESS.
           PERFORM RESET-FAKE
           MOVE 1 TO SF-MODE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-CALL-COUNT NOT = ZERO OR
              SF-ACTION-COUNT NOT = 2 OR
              SF-EMPTY-COUNT NOT = 1 OR
              SF-TRACE(1:3) NOT = "QER"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-SIGNAL-RESTORE-FAILURE.
           PERFORM RESET-FAKE
           MOVE 2 TO SF-MODE
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           PERFORM OPEN-TLS
           IF NP-STATUS NOT = STATUS-NETWORK OR
              EF-CALL-COUNT NOT = ZERO OR
              SF-ACTION-COUNT NOT = 2 OR
              SF-EMPTY-COUNT NOT = 1 OR
              SF-TRACE(1:3) NOT = "QER"
               ADD 1 TO WS-FAILURES
           END-IF.

       RESET-FAKE.
           MOVE LOW-VALUES TO EZA-FAKE-CONTROL
           MOVE LOW-VALUES TO SIGNAL-FAKE-CONTROL
           MOVE SPACES TO EF-TRACE EF-NODE EF-SERVICE
           MOVE SPACES TO SF-TRACE
           MOVE SPACES TO WS-EXPECTED-TRACE.

       SET-DEFAULT-HOST.
           MOVE SPACES TO WS-HOST WS-VERIFY
           MOVE X"6170692E6F70656E61692E636F6D" TO WS-HOST(1:14)
           MOVE WS-HOST TO WS-VERIFY.

       OPEN-TLS.
           PERFORM OPEN-WITH-LENGTH-14.

       PREPARE-OPEN.
           PERFORM SET-DEFAULT-HOST
           MOVE 443 TO WS-TEST-PORT
           INITIALIZE NET-PARM
           MOVE NET-OPEN TO NP-OPERATION
           MOVE NET-TLS TO NP-SCHEME
           SET NP-CONNECT-HOST-PTR TO ADDRESS OF WS-HOST
           MOVE 14 TO NP-CONNECT-HOST-LENGTH
           SET NP-VERIFY-HOST-PTR TO ADDRESS OF WS-VERIFY
           MOVE 14 TO NP-VERIFY-HOST-LENGTH
           MOVE WS-TEST-PORT TO NP-PORT.

       PREPARE-WRITE.
           INITIALIZE NET-PARM
           MOVE NET-WRITE TO NP-OPERATION
           SET NP-BUFFER-PTR TO ADDRESS OF WS-BUFFER
           MOVE 16 TO NP-BUFFER-CAPACITY
           MOVE 1 TO NP-REQUEST-LENGTH.

       PREPARE-READ.
           INITIALIZE NET-PARM
           MOVE NET-READ TO NP-OPERATION
           SET NP-BUFFER-PTR TO ADDRESS OF WS-BUFFER
           MOVE 16 TO NP-BUFFER-CAPACITY.

       OPEN-WITH-LENGTH-14.
           INITIALIZE NET-PARM
           MOVE NET-OPEN TO NP-OPERATION
           MOVE NET-TLS TO NP-SCHEME
           SET NP-CONNECT-HOST-PTR TO ADDRESS OF WS-HOST
           MOVE 14 TO NP-CONNECT-HOST-LENGTH
           SET NP-VERIFY-HOST-PTR TO ADDRESS OF WS-VERIFY
           MOVE 14 TO NP-VERIFY-HOST-LENGTH
           MOVE WS-TEST-PORT TO NP-PORT
           CALL "NETIO" USING NET-PARM.

       OPEN-253.
           INITIALIZE NET-PARM
           MOVE NET-OPEN TO NP-OPERATION
           MOVE NET-TLS TO NP-SCHEME
           SET NP-CONNECT-HOST-PTR TO ADDRESS OF WS-HOST
           MOVE 253 TO NP-CONNECT-HOST-LENGTH
           SET NP-VERIFY-HOST-PTR TO ADDRESS OF WS-VERIFY
           MOVE 253 TO NP-VERIFY-HOST-LENGTH
           MOVE WS-TEST-PORT TO NP-PORT
           CALL "NETIO" USING NET-PARM.

       OPEN-252.
           INITIALIZE NET-PARM
           MOVE NET-OPEN TO NP-OPERATION
           MOVE NET-TLS TO NP-SCHEME
           SET NP-CONNECT-HOST-PTR TO ADDRESS OF WS-HOST
           MOVE 252 TO NP-CONNECT-HOST-LENGTH
           SET NP-VERIFY-HOST-PTR TO ADDRESS OF WS-VERIFY
           MOVE 252 TO NP-VERIFY-HOST-LENGTH
           MOVE WS-TEST-PORT TO NP-PORT
           CALL "NETIO" USING NET-PARM.

       OPEN-254.
           INITIALIZE NET-PARM
           MOVE NET-OPEN TO NP-OPERATION
           MOVE NET-TLS TO NP-SCHEME
           SET NP-CONNECT-HOST-PTR TO ADDRESS OF WS-HOST
           MOVE 254 TO NP-CONNECT-HOST-LENGTH
           SET NP-VERIFY-HOST-PTR TO ADDRESS OF WS-VERIFY
           MOVE 254 TO NP-VERIFY-HOST-LENGTH
           SET NP-BUFFER-PTR TO ADDRESS OF WS-BUFFER
           MOVE 1 TO NP-BUFFER-CAPACITY NP-REQUEST-LENGTH
           MOVE WS-TEST-PORT TO NP-PORT
           CALL "NETIO" USING NET-PARM.

       CLOSE-TLS.
           INITIALIZE NET-PARM
           MOVE NET-CLOSE TO NP-OPERATION
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-OK
               ADD 1 TO WS-FAILURES
           END-IF.

       CHECK-TRACE.
           IF EF-TRACE-LENGTH NOT = WS-EXPECTED-LENGTH OR
              EF-TRACE(1:WS-EXPECTED-LENGTH) NOT =
                  WS-EXPECTED-TRACE(1:WS-EXPECTED-LENGTH)
               ADD 1 TO WS-FAILURES
           END-IF.

       END PROGRAM TSTZNET.
