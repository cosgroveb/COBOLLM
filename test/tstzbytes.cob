       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTZBYTE.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY POSIXNAT.
       01 ZB-SHELL-PREFIX PIC X(10) VALUE X"85A7858340F26E50F125".
       01 ZB-KEY-NAME.
           05 FILLER PIC X(14) VALUE "OPENAI_API_KEY".
           05 FILLER PIC X VALUE LOW-VALUE.
       01 ZB-MODEL-NAME.
           05 FILLER PIC X(12) VALUE "OPENAI_MODEL".
           05 FILLER PIC X VALUE LOW-VALUE.
       01 ZB-URL-NAME.
           05 FILLER PIC X(15) VALUE "OPENAI_BASE_URL".
           05 FILLER PIC X VALUE LOW-VALUE.
       01 ZB-FAILURES PIC S9(9) COMP-5 VALUE ZERO.

       PROCEDURE DIVISION.
           IF ZOS-POPEN-MODE NOT = X"9900"
               ADD 1 TO ZB-FAILURES
           END-IF
           IF ZOS-UTF8-NAME NOT = X"E4E3C660F800"
               ADD 1 TO ZB-FAILURES
           END-IF
           IF ZOS-1047-NAME NOT = X"C9C2D460F1F0F4F700"
               ADD 1 TO ZB-FAILURES
           END-IF
           IF ZB-SHELL-PREFIX NOT = X"85A7858340F26E50F125"
               ADD 1 TO ZB-FAILURES
           END-IF
           IF ZB-KEY-NAME NOT =
              X"D6D7C5D5C1C96DC1D7C96DD2C5E800"
               ADD 1 TO ZB-FAILURES
           END-IF
           IF ZB-MODEL-NAME NOT = X"D6D7C5D5C1C96DD4D6C4C5D300"
               ADD 1 TO ZB-FAILURES
           END-IF
           IF ZB-URL-NAME NOT =
              X"D6D7C5D5C1C96DC2C1E2C56DE4D9D300"
               ADD 1 TO ZB-FAILURES
           END-IF
           IF ZB-FAILURES = ZERO
               DISPLAY "PASS ZOS BYTES"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL ZOS BYTES"
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       END PROGRAM TSTZBYTE.
