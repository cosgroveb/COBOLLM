           MOVE WS-URL-LENGTH TO HP-URL-LENGTH
           SET HP-KEY-PTR TO ADDRESS OF WS-KEY
           MOVE 6 TO HP-KEY-LENGTH
           SET HP-BODY-PTR TO ADDRESS OF WS-BODY
           MOVE 2 TO HP-BODY-LENGTH
           SET HP-RESPONSE-PTR TO ADDRESS OF WS-RESULT
           MOVE LIMIT-RESPONSE TO HP-RESPONSE-CAPACITY
           CALL "HTTP11" USING HTTP-PARM.

       CONFIGURE-FAKE.
           INITIALIZE NET-PARM
           MOVE FAKE-CONFIGURE TO NP-OPERATION
           SET NP-BUFFER-PTR TO ADDRESS OF WS-FIXTURE
           MOVE WS-FIXTURE-LENGTH TO NP-REQUEST-LENGTH
           MOVE WS-READ-CHUNK TO NP-BUFFER-CAPACITY
           MOVE WS-WRITE-CHUNK TO NP-TRANSFERRED
           MOVE WS-FAIL-OP TO NP-SCHEME
           MOVE WS-FAIL-CALL TO NP-PORT
           MOVE WS-ZERO-WRITE TO NP-CONNECT-HOST-LENGTH
           CALL "NETIO" USING NET-PARM
           IF NP-STATUS NOT = STATUS-OK
               MOVE "fake configure" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF.

       QUERY-FAKE.
           MOVE LOW-VALUES TO WS-CAPTURE
           MOVE SPACES TO WS-OPEN-HOST WS-VERIFY-HOST
           INITIALIZE NET-PARM
           MOVE FAKE-QUERY TO NP-OPERATION
           SET NP-BUFFER-PTR TO ADDRESS OF WS-CAPTURE
           MOVE 16789504 TO NP-BUFFER-CAPACITY
           SET NP-CONNECT-HOST-PTR TO ADDRESS OF WS-OPEN-HOST
           MOVE 253 TO NP-CONNECT-HOST-LENGTH
           SET NP-VERIFY-HOST-PTR TO ADDRESS OF WS-VERIFY-HOST
           MOVE 253 TO NP-VERIFY-HOST-LENGTH
           CALL "NETIO" USING NET-PARM
           MOVE NP-REQUEST-LENGTH TO WS-CAPTURE-LENGTH.

       FAIL-CASE.
           ADD 1 TO FAILURE-COUNT
           DISPLAY "FAIL HTTP11 " WS-CASE
           DISPLAY "  HTTP=" HP-STATUS " CODE=" HP-HTTP-STATUS
               " LENGTH=" HP-RESPONSE-LENGTH
           DISPLAY "  NET=" NP-STATUS " PORT=" NP-PORT
               " SCHEME=" NP-SCHEME " CAPTURE=" WS-CAPTURE-LENGTH.

       END PROGRAM TSTHTTP.
