       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTHTTP.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY HTTPPARM.
       COPY NETPARM.
       01  FAKE-RESET              PIC S9(9) COMP-5 VALUE 90.
       01  FAKE-CONFIGURE          PIC S9(9) COMP-5 VALUE 91.
       01  FAKE-QUERY              PIC S9(9) COMP-5 VALUE 92.
       01  FAILURE-COUNT           PIC S9(9) COMP-5 VALUE 0.
       01  WS-URL                  PIC X(2048).
       01  WS-URL-LENGTH           PIC S9(9) COMP-5.
       01  WS-KEY                  PIC X(8192).
       01  WS-BODY                 PIC X(16777216).
       01  WS-RESULT               PIC X(8388608).
       01  WS-FIXTURE              PIC X(8388608).
       01  WS-FIXTURE-LENGTH       PIC S9(9) COMP-5.
       01  WS-CAPTURE              PIC X(16789504).
       01  WS-CAPTURE-LENGTH       PIC S9(9) COMP-5.
       01  WS-OPEN-HOST            PIC X(253).
       01  WS-VERIFY-HOST          PIC X(253).
       01  WS-READ-CHUNK           PIC S9(9) COMP-5 VALUE 65536.
       01  WS-WRITE-CHUNK          PIC S9(9) COMP-5 VALUE 65536.
       01  WS-FAIL-OP              PIC S9(9) COMP-5 VALUE 0.
       01  WS-FAIL-CALL            PIC S9(9) COMP-5 VALUE 1.
       01  WS-ZERO-WRITE           PIC S9(9) COMP-5 VALUE 0.
       01  WS-EXPECTED-STATUS      PIC S9(9) COMP-5.
       01  WS-EXPECTED-PORT        PIC S9(9) COMP-5.
       01  WS-EXPECTED-SCHEME      PIC S9(9) COMP-5.
       01  WS-EXPECTED-HOST        PIC X(32).
       01  WS-EXPECTED-HOST-LENGTH PIC S9(9) COMP-5.
       01  WS-EXPECTED-TARGET      PIC X(32).
       01  WS-EXPECTED-TARGET-LEN  PIC S9(9) COMP-5.
       01  WS-CASE                 PIC X(32).
       01  WS-SAVED-PTR            USAGE POINTER.
       01  WS-SAVED-URL-PTR        USAGE POINTER.
       01  WS-SAVED-KEY-PTR        USAGE POINTER.
       01  WS-SAVED-BODY-PTR       USAGE POINTER.
       01  WS-SAVED-RESPONSE-PTR   USAGE POINTER.
       01  WS-SAVED-OPERATION      PIC S9(9) COMP-5.
       01  WS-SAVED-URL-LENGTH     PIC S9(9) COMP-5.
       01  WS-SAVED-KEY-LENGTH     PIC S9(9) COMP-5.
       01  WS-SAVED-BODY-LENGTH    PIC S9(9) COMP-5.
       01  WS-SAVED-CAPACITY       PIC S9(9) COMP-5.
       01  WS-TEST-OPERATION       PIC S9(9) COMP-5.
       01  WS-BOUNDARY             PIC S9(9) COMP-5.
       01  WS-INDEX                PIC S9(9) COMP-5.
       01  WS-FIND                 PIC X.
       01  WS-PATTERN              PIC X(64).
       01  WS-PATTERN-LENGTH       PIC S9(9) COMP-5.

       01  C-RESPONSE-LENGTH.
           05 FILLER PIC X(25) VALUE
              X"485454502F312E3120323030204F4B0D0A436F6E74656E742D".
           05 FILLER PIC X(15) VALUE
              X"4C656E6774683A20320D0A0D0A7B7D".
       01  C-RESPONSE-CHUNKED.
           05 FILLER PIC X(25) VALUE
              X"485454502F312E3120323030204F4B0D0A5472616E73666572".
           05 FILLER PIC X(25) VALUE
              X"2D456E636F64696E673A206368756E6B65640D0A0D0A310D0A".
           05 FILLER PIC X(14) VALUE
              X"7B0D0A310D0A7D0D0A300D0A0D0A".
       01  C-RESPONSE-CLOSE        PIC X(21) VALUE
           X"485454502F312E3120323030204F4B0D0A0D0A7B7D".
       01  C-RESPONSE-MIXED.
           05 FILLER PIC X(25) VALUE
              X"485454502F312E31203230302046696E650D0A634F6E54654E".
           05 FILLER PIC X(26) VALUE
              X"742D4C654E6754683A09203220090D0A436F6E74656E742D456E".
           05 FILLER PIC X(22) VALUE
              X"636F64696E673A204944454E544954590D0A0D0A7B7D".
       01  C-EXPECTED.
           05 C-EXPECTED-1.
              10 FILLER PIC X(26) VALUE
              X"504F5354202F726573706F6E73657320485454502F312E310D0A".
              10 FILLER PIC X(26) VALUE
              X"486F73743A206578616D706C650D0A417574686F72697A617469".
              10 FILLER PIC X(14) VALUE
              X"6F6E3A2042656172657220736563".
           05 C-EXPECTED-2.
              10 FILLER PIC X(26) VALUE
              X"7265740D0A436F6E74656E742D547970653A206170706C696361".
              10 FILLER PIC X(25) VALUE
              X"74696F6E2F6A736F6E0D0A4163636570743A206170706C6963".
              10 FILLER PIC X(15) VALUE
              X"6174696F6E2F6A736F6E0D0A416363".
           05 C-EXPECTED-3.
              10 FILLER PIC X(26) VALUE
              X"6570742D456E636F64696E673A206964656E746974790D0A436F".
              10 FILLER PIC X(26) VALUE
              X"6E74656E742D4C656E6774683A20320D0A436F6E6E656374696F".
