       PROCEDURE DIVISION.
           PERFORM TEST-PREFLIGHT
           PERFORM TEST-EXACT-REQUEST
           PERFORM TEST-LARGE-REQUEST
           PERFORM TEST-FIXED-BUFFER-LIMITS
           PERFORM TEST-URL-VARIANTS
           PERFORM TEST-URL-BOUNDARIES
           PERFORM TEST-FRAMING
           PERFORM TEST-URL-REJECTIONS
           PERFORM TEST-PROTOCOL-FAILURES
           PERFORM TEST-NETWORK-FAILURES
           PERFORM TEST-CAPACITY-AND-POINTERS
           PERFORM TEST-CALL-CONTRACTS
           IF FAILURE-COUNT = ZERO
               DISPLAY "PASS HTTP11"
               MOVE ZERO TO RETURN-CODE
           ELSE
               MOVE 1 TO RETURN-CODE
           END-IF
           STOP RUN.

       TEST-PREFLIGHT.
           MOVE "preflight" TO WS-CASE
           MOVE LOW-VALUES TO WS-URL
           MOVE X"687474703A2F2F6578616D706C65" TO WS-URL(1:14)
           MOVE 14 TO WS-URL-LENGTH
           INITIALIZE HTTP-PARM
           MOVE HTTP-PREFLIGHT TO HP-OPERATION
           SET HP-URL-PTR TO ADDRESS OF WS-URL
           MOVE WS-URL-LENGTH TO HP-URL-LENGTH
           MOVE 999 TO HP-RESPONSE-LENGTH HP-HTTP-STATUS
           MOVE X"FF" TO HP-PLAINTEXT
           SET WS-SAVED-PTR TO HP-URL-PTR
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-OK OR
              HP-PLAINTEXT NOT = FLAG-ON OR
              HP-RESPONSE-LENGTH NOT = ZERO OR
              HP-HTTP-STATUS NOT = ZERO OR
              HP-URL-PTR NOT = WS-SAVED-PTR
               PERFORM FAIL-CASE
           END-IF
           MOVE X"68747470733A2F2F6578616D706C65" TO WS-URL(1:15)
           MOVE 15 TO WS-URL-LENGTH HP-URL-LENGTH
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-OK OR
              HP-PLAINTEXT NOT = FLAG-OFF
               PERFORM FAIL-CASE
           END-IF
           MOVE X"687474703A2F2F3132332E6578616D706C65" TO
               WS-URL(1:18)
           MOVE 18 TO WS-URL-LENGTH HP-URL-LENGTH
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-OK
               MOVE "numeric dns label" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF.

       TEST-EXACT-REQUEST.
           MOVE "exact request" TO WS-CASE
           MOVE X"687474703A2F2F6578616D706C65" TO WS-URL(1:14)
           MOVE 14 TO WS-URL-LENGTH
           MOVE C-RESPONSE-LENGTH TO WS-FIXTURE(1:40)
           MOVE 40 TO WS-FIXTURE-LENGTH
           MOVE 1 TO WS-READ-CHUNK
           MOVE 3 TO WS-WRITE-CHUNK
           MOVE STATUS-OK TO WS-EXPECTED-STATUS
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK OR
              HP-HTTP-STATUS NOT = 200 OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              WS-RESULT(1:2) NOT = X"7B7D"
               PERFORM FAIL-CASE
           END-IF
           PERFORM QUERY-FAKE
           IF NP-STATUS NOT = STATUS-OK OR NP-EOF NOT = FLAG-ON OR
              NP-TRANSFERRED NOT = 1 OR
              WS-CAPTURE-LENGTH NOT = 198 OR
              WS-CAPTURE(1:198) NOT = C-EXPECTED OR
              NP-PORT NOT = 80 OR NP-SCHEME NOT = NET-PLAINTEXT OR
              WS-OPEN-HOST(1:7) NOT = X"6578616D706C65" OR
              WS-VERIFY-HOST(1:7) NOT = X"6578616D706C65"
               PERFORM FAIL-CASE
           END-IF
           MOVE 65536 TO WS-READ-CHUNK WS-WRITE-CHUNK.

       TEST-LARGE-REQUEST.
           MOVE "large request chunks" TO WS-CASE
           MOVE X"687474703A2F2F6578616D706C65" TO WS-URL(1:14)
           MOVE 14 TO WS-URL-LENGTH
           MOVE C-RESPONSE-LENGTH TO WS-FIXTURE(1:40)
           MOVE 40 TO WS-FIXTURE-LENGTH
           MOVE 65536 TO WS-READ-CHUNK WS-WRITE-CHUNK
           PERFORM CONFIGURE-FAKE
           MOVE ALL X"20" TO WS-BODY(1:70000)
           INITIALIZE HTTP-PARM
           MOVE HTTP-POST TO HP-OPERATION
           SET HP-URL-PTR TO ADDRESS OF WS-URL
           MOVE WS-URL-LENGTH TO HP-URL-LENGTH
           SET HP-KEY-PTR TO ADDRESS OF WS-KEY
           MOVE 6 TO HP-KEY-LENGTH
           SET HP-BODY-PTR TO ADDRESS OF WS-BODY
           MOVE 70000 TO HP-BODY-LENGTH
           SET HP-RESPONSE-PTR TO ADDRESS OF WS-RESULT
           MOVE LIMIT-RESPONSE TO HP-RESPONSE-CAPACITY
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2
               PERFORM FAIL-CASE
           END-IF
           PERFORM QUERY-FAKE
           IF NP-STATUS NOT = STATUS-OK OR
              WS-CAPTURE-LENGTH NOT = 70200 OR
              WS-CAPTURE(201:1) NOT = X"20" OR
              WS-CAPTURE(70200:1) NOT = X"20"
               PERFORM FAIL-CASE
           END-IF.

       TEST-FIXED-BUFFER-LIMITS.
           MOVE X"68747470733A2F2F6578616D706C65" TO WS-URL(1:15)
           MOVE 15 TO WS-URL-LENGTH
           MOVE X"736563726574" TO WS-KEY(1:6)
           MOVE C-RESPONSE-LENGTH TO WS-FIXTURE(1:40)
           MOVE 40 TO WS-FIXTURE-LENGTH
           MOVE 65536 TO WS-READ-CHUNK WS-WRITE-CHUNK
           MOVE ZERO TO WS-FAIL-OP WS-ZERO-WRITE
           MOVE 1 TO WS-FAIL-CALL

      * Request bodies are sent directly from their owned view.
           MOVE X"5153" TO WS-BODY(1:2)
           COMPUTE WS-BOUNDARY = LIMIT-REQUEST - 1
           MOVE X"52" TO WS-BODY(WS-BOUNDARY:1)
           PERFORM TEST-HTTP-REQUEST-BOUNDARY
           MOVE LIMIT-REQUEST TO WS-BOUNDARY
           MOVE X"52" TO WS-BODY(WS-BOUNDARY:1)
           PERFORM TEST-HTTP-REQUEST-BOUNDARY

           PERFORM CONFIGURE-FAKE
           MOVE HTTP-POST TO WS-TEST-OPERATION
           PERFORM SET-VALID-HTTP
           COMPUTE HP-BODY-LENGTH = LIMIT-REQUEST + 1
           MOVE 999 TO HP-STATUS HP-RESPONSE-LENGTH HP-HTTP-STATUS
           MOVE X"FF" TO HP-PLAINTEXT
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-INTERNAL OR
              HP-RESPONSE-LENGTH NOT = ZERO OR
              HP-HTTP-STATUS NOT = ZERO OR
              HP-PLAINTEXT NOT = FLAG-OFF OR
              WS-URL(1:15) NOT =
                  X"68747470733A2F2F6578616D706C65" OR
              WS-KEY(1:6) NOT = X"736563726574" OR
              WS-BODY(1:1) NOT = X"51" OR
              WS-BODY(LIMIT-REQUEST:1) NOT = X"52"
               MOVE "request above limit" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF

      * A small valid response proves response view capacity.
           COMPUTE WS-BOUNDARY = LIMIT-RESPONSE - 1
           PERFORM TEST-HTTP-RESPONSE-BOUNDARY
           MOVE LIMIT-RESPONSE TO WS-BOUNDARY
           PERFORM TEST-HTTP-RESPONSE-BOUNDARY

           PERFORM CONFIGURE-FAKE
           MOVE HTTP-POST TO WS-TEST-OPERATION
           PERFORM SET-VALID-HTTP
           COMPUTE HP-RESPONSE-CAPACITY = LIMIT-RESPONSE + 1
           MOVE 999 TO HP-STATUS HP-RESPONSE-LENGTH HP-HTTP-STATUS
           MOVE X"FF" TO HP-PLAINTEXT
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-INTERNAL OR
              HP-RESPONSE-LENGTH NOT = ZERO OR
              HP-HTTP-STATUS NOT = ZERO OR
              HP-PLAINTEXT NOT = FLAG-OFF OR
              WS-URL(1:15) NOT =
                  X"68747470733A2F2F6578616D706C65" OR
              WS-KEY(1:6) NOT = X"736563726574" OR
              WS-BODY(1:1) NOT = X"51"
               MOVE "response above limit" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF.

       TEST-HTTP-REQUEST-BOUNDARY.
           PERFORM CONFIGURE-FAKE
           MOVE HTTP-POST TO WS-TEST-OPERATION
           PERFORM SET-VALID-HTTP
           MOVE WS-BOUNDARY TO HP-BODY-LENGTH
           MOVE 999 TO HP-STATUS HP-RESPONSE-LENGTH HP-HTTP-STATUS
           MOVE X"FF" TO HP-PLAINTEXT
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              HP-HTTP-STATUS NOT = 200 OR
              HP-PLAINTEXT NOT = FLAG-OFF
               MOVE "request boundary" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF
           PERFORM QUERY-FAKE
           COMPUTE WS-INDEX = WS-BOUNDARY + 203
           IF WS-CAPTURE-LENGTH NOT = WS-INDEX OR
              WS-CAPTURE(204:1) NOT = X"51" OR
              WS-CAPTURE(WS-CAPTURE-LENGTH:1) NOT = X"52" OR
              WS-BODY(1:1) NOT = X"51" OR
              WS-BODY(WS-BOUNDARY:1) NOT = X"52"
               MOVE "request boundary bytes" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF.

       TEST-HTTP-RESPONSE-BOUNDARY.
           PERFORM CONFIGURE-FAKE
           MOVE HTTP-POST TO WS-TEST-OPERATION
           PERFORM SET-VALID-HTTP
           MOVE WS-BOUNDARY TO HP-RESPONSE-CAPACITY
           MOVE 999 TO HP-STATUS HP-RESPONSE-LENGTH HP-HTTP-STATUS
           MOVE X"FF" TO HP-PLAINTEXT
           CALL "HTTP11" USING HTTP-PARM
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              HP-HTTP-STATUS NOT = 200 OR
              HP-PLAINTEXT NOT = FLAG-OFF OR
              WS-URL(1:15) NOT =
                  X"68747470733A2F2F6578616D706C65" OR
              WS-KEY(1:6) NOT = X"736563726574" OR
              WS-BODY(1:2) NOT = X"5153"
               MOVE "response boundary" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF.

       TEST-URL-VARIANTS.
           MOVE C-RESPONSE-LENGTH TO WS-FIXTURE(1:40)
           MOVE 40 TO WS-FIXTURE-LENGTH
           MOVE STATUS-OK TO WS-EXPECTED-STATUS
           MOVE X"68747470733A2F2F6578616D706C65" TO WS-URL(1:15)
           MOVE 15 TO WS-URL-LENGTH
           MOVE "https omitted" TO WS-CASE
           MOVE 443 TO WS-EXPECTED-PORT
           MOVE NET-TLS TO WS-EXPECTED-SCHEME
           MOVE X"6578616D706C65" TO WS-EXPECTED-HOST(1:7)
           MOVE 7 TO WS-EXPECTED-HOST-LENGTH
           MOVE X"2F726573706F6E736573" TO WS-EXPECTED-TARGET(1:10)
           MOVE 10 TO WS-EXPECTED-TARGET-LEN
           PERFORM RUN-AND-CHECK-URL
           MOVE X"687474703A2F2F6578616D706C653A3830" TO
               WS-URL(1:17)
           MOVE 17 TO WS-URL-LENGTH
           MOVE "http explicit" TO WS-CASE
           MOVE 80 TO WS-EXPECTED-PORT
           MOVE NET-PLAINTEXT TO WS-EXPECTED-SCHEME
           MOVE X"6578616D706C653A3830" TO WS-EXPECTED-HOST(1:10)
           MOVE 10 TO WS-EXPECTED-HOST-LENGTH
           PERFORM RUN-AND-CHECK-URL
           MOVE X"68747470733A2F2F6578616D706C653A343433" TO
               WS-URL(1:19)
           MOVE 19 TO WS-URL-LENGTH
           MOVE "https explicit" TO WS-CASE
           MOVE 443 TO WS-EXPECTED-PORT
           MOVE NET-TLS TO WS-EXPECTED-SCHEME
           MOVE X"6578616D706C653A343433" TO WS-EXPECTED-HOST(1:11)
           MOVE 11 TO WS-EXPECTED-HOST-LENGTH
           PERFORM RUN-AND-CHECK-URL
           MOVE X"68747470733A2F2F6578616D706C653A383434332F76312F"
               TO WS-URL(1:24)
           MOVE 24 TO WS-URL-LENGTH
           MOVE "custom path slash" TO WS-CASE
           MOVE 8443 TO WS-EXPECTED-PORT
           MOVE NET-TLS TO WS-EXPECTED-SCHEME
           MOVE X"6578616D706C653A38343433" TO
               WS-EXPECTED-HOST(1:12)
           MOVE 12 TO WS-EXPECTED-HOST-LENGTH
           MOVE X"2F76312F726573706F6E736573" TO
               WS-EXPECTED-TARGET(1:13)
           MOVE 13 TO WS-EXPECTED-TARGET-LEN
           PERFORM RUN-AND-CHECK-URL
           MOVE X"68747470733A2F2F6578616D706C652F7631" TO
               WS-URL(1:18)
           MOVE 18 TO WS-URL-LENGTH
           MOVE "path no slash" TO WS-CASE
           MOVE "path no slash" TO WS-CASE
           MOVE 443 TO WS-EXPECTED-PORT
           MOVE NET-TLS TO WS-EXPECTED-SCHEME
           MOVE X"6578616D706C65" TO WS-EXPECTED-HOST(1:7)
           MOVE 7 TO WS-EXPECTED-HOST-LENGTH
           PERFORM RUN-AND-CHECK-URL.

       RUN-AND-CHECK-URL.
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK
               PERFORM FAIL-CASE
               EXIT PARAGRAPH
           END-IF
           PERFORM QUERY-FAKE
           IF NP-PORT NOT = WS-EXPECTED-PORT
               MOVE "observed port" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF
           IF NP-SCHEME NOT = WS-EXPECTED-SCHEME
               MOVE "observed scheme" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF
           IF WS-OPEN-HOST(1:7) NOT = X"6578616D706C65"
               MOVE "connect host" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF
           IF WS-VERIFY-HOST(1:7) NOT = X"6578616D706C65"
               MOVE "verify host" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF
           COMPUTE WS-INDEX = WS-EXPECTED-TARGET-LEN + 6
           COMPUTE WS-PATTERN-LENGTH =
               WS-EXPECTED-TARGET-LEN + 23
           IF WS-CAPTURE(1:5) NOT = X"504F535420" OR
              WS-CAPTURE(6:WS-EXPECTED-TARGET-LEN) NOT =
              WS-EXPECTED-TARGET(1:WS-EXPECTED-TARGET-LEN)
               MOVE "observed target" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF
           IF WS-CAPTURE(WS-INDEX:17) NOT =
              X"20485454502F312E310D0A486F73743A20"
               MOVE "observed request line" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF
           IF WS-CAPTURE(WS-PATTERN-LENGTH:
              WS-EXPECTED-HOST-LENGTH) NOT =
              WS-EXPECTED-HOST(1:WS-EXPECTED-HOST-LENGTH)
               MOVE "observed authority" TO WS-CASE
               PERFORM FAIL-CASE
           END-IF.

       TEST-FRAMING.
           MOVE X"68747470733A2F2F6578616D706C65" TO WS-URL(1:15)
           MOVE 15 TO WS-URL-LENGTH
           MOVE "chunked" TO WS-CASE
           MOVE C-RESPONSE-CHUNKED TO WS-FIXTURE(1:64)
           MOVE 64 TO WS-FIXTURE-LENGTH
           MOVE 2 TO WS-READ-CHUNK
           MOVE 5 TO WS-WRITE-CHUNK
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              WS-RESULT(1:2) NOT = X"7B7D"
               PERFORM FAIL-CASE
           END-IF
           MOVE "close delimited" TO WS-CASE
           MOVE C-RESPONSE-CLOSE TO WS-FIXTURE(1:21)
           MOVE 21 TO WS-FIXTURE-LENGTH
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              WS-RESULT(1:2) NOT = X"7B7D"
               PERFORM FAIL-CASE
           END-IF
           MOVE "mixed case ows" TO WS-CASE
           MOVE C-RESPONSE-MIXED TO WS-FIXTURE(1:73)
           MOVE 73 TO WS-FIXTURE-LENGTH
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              WS-RESULT(1:2) NOT = X"7B7D"
               PERFORM FAIL-CASE
           END-IF
           MOVE "repeated length" TO WS-CASE
           STRING
               X"485454502F312E3120323030204F4B0D0A436F6E74656E742D"
                   DELIMITED BY SIZE
               X"4C656E6774683A20322C20320D0A0D0A7B7D"
                   DELIMITED BY SIZE
               INTO WS-FIXTURE
           END-STRING
           MOVE 43 TO WS-FIXTURE-LENGTH
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2
               PERFORM FAIL-CASE
           END-IF
           MOVE "chunk extension trailer" TO WS-CASE
           STRING
               X"485454502F312E3120323030204F4B0D0A5472616E73666572"
                   DELIMITED BY SIZE
               X"2D456E636F64696E673A206368756E6B65640D0A0D0A323B66"
                   DELIMITED BY SIZE
               X"6F6F3D6261720D0A7B7D0D0A300D0A582D546573743A206F6B"
                   DELIMITED BY SIZE
               X"0D0A0D0A" DELIMITED BY SIZE
               INTO WS-FIXTURE
           END-STRING
           MOVE 79 TO WS-FIXTURE-LENGTH
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              WS-RESULT(1:2) NOT = X"7B7D"
               PERFORM FAIL-CASE
           END-IF
           MOVE "quoted-pair octets" TO WS-CASE
           STRING
               X"485454502F312E3120323030204F4B0D0A5472616E73666572"
                   DELIMITED BY SIZE
               X"2D456E636F64696E673A206368756E6B65640D0A0D0A323B66"
                   DELIMITED BY SIZE
               X"6F6F3D225C095C205C7E5C80220D0A7B7D0D0A300D0A0D0A"
                   DELIMITED BY SIZE
               INTO WS-FIXTURE
           END-STRING
           MOVE 74 TO WS-FIXTURE-LENGTH
           PERFORM RUN-POST
           IF HP-STATUS NOT = STATUS-OK OR
              HP-RESPONSE-LENGTH NOT = 2 OR
              WS-RESULT(1:2) NOT = X"7B7D"
               PERFORM FAIL-CASE
           END-IF
           MOVE 65536 TO WS-READ-CHUNK WS-WRITE-CHUNK.

       TEST-URL-REJECTIONS.
           MOVE "bad scheme" TO WS-CASE
           MOVE X"6674703A2F2F6578616D706C65" TO WS-URL(1:13)
           MOVE 13 TO WS-URL-LENGTH
           PERFORM EXPECT-BAD-URL
           MOVE "empty host" TO WS-CASE
           MOVE X"687474703A2F2F" TO WS-URL(1:7)
           MOVE 7 TO WS-URL-LENGTH
           PERFORM EXPECT-BAD-URL
           MOVE "userinfo" TO WS-CASE
           MOVE X"687474703A2F2F75406578616D706C65" TO WS-URL(1:16)
           MOVE 16 TO WS-URL-LENGTH
