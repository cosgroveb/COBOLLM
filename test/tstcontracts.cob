       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTCNTR.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY CLIPARM.
       COPY JSONPARM.
       COPY HTTPPARM.
       COPY NETPARM.
       COPY RESPPARM.
       COPY SHLPARM.
       COPY TXTPARM.
       COPY OUTPARM.
       01 CT-MAX PIC X(16777216).
       01 CT-TASK REDEFINES CT-MAX PIC X(65535).
       01 CT-URL REDEFINES CT-MAX PIC X(2048).
       01 CT-MODEL REDEFINES CT-MAX PIC X(256).
       01 CT-KEY REDEFINES CT-MAX PIC X(8192).
       01 CT-HISTORY REDEFINES CT-MAX PIC X(16777216).
       01 CT-REQUEST REDEFINES CT-MAX PIC X(16777216).
       01 CT-RESPONSE REDEFINES CT-MAX PIC X(8388608).
       01 CT-CALL-ID REDEFINES CT-MAX PIC X(8388608).
       01 CT-COMMAND REDEFINES CT-MAX PIC X(65535).
       01 CT-SHELL-OUTPUT REDEFINES CT-MAX PIC X(1048576).
       01 CT-TOOL-RESULT REDEFINES CT-MAX PIC X(1048832).
       01 CT-FINAL REDEFINES CT-MAX PIC X(1048576).
       01 CT-FINAL-NATIVE REDEFINES CT-MAX PIC X(3145728).
       01 CT-NET-CHUNK REDEFINES CT-MAX PIC X(65536).
       01 CT-HTTP-HEADER REDEFINES CT-MAX PIC X(65536).
       01 CT-REQUEST-HEADER REDEFINES CT-MAX PIC X(12288).
       01 CT-DIAGNOSTIC REDEFINES CT-MAX PIC X(320).
       01 CT-SHELL-PREFIX REDEFINES CT-MAX PIC X(10).
       01 CT-SHELL-STAGING REDEFINES CT-MAX PIC X(65546).
       01 CT-GNU-ARG-STAGING REDEFINES CT-MAX PIC X(131072).
       01 CT-ENV-STAGING REDEFINES CT-MAX PIC X(8193).
       01 CT-URL-TARGET REDEFINES CT-MAX PIC X(2059).
       01 CT-NATIVE-HOST-CSTR REDEFINES CT-MAX PIC X(254).
       01 CT-NATIVE-SVC-CSTR REDEFINES CT-MAX PIC X(6).
       01 CT-HOST REDEFINES CT-MAX PIC X(253).
       01 CT-ZOS-SERVICE REDEFINES CT-MAX PIC X(5).
       01 CT-SERIAL-LITERAL REDEFINES CT-MAX PIC X(1024).
       01 WS-FAILURES PIC S9(9) COMP-5 VALUE ZERO.

       PROCEDURE DIVISION.
           IF FLAG-OFF NOT = X"00" ADD 1 TO WS-FAILURES END-IF
           IF FLAG-ON NOT = X"01" ADD 1 TO WS-FAILURES END-IF
           IF LENGTH OF FLAG-OFF NOT = 1 OR
              LENGTH OF PLATFORM-GNU NOT = 4 OR
              LENGTH OF STATUS-OK NOT = 4 OR
              LENGTH OF LIMIT-TASK NOT = 4
               ADD 1 TO WS-FAILURES
           END-IF
           IF PLATFORM-GNU NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF PLATFORM-ZOS NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF JSON-ESCAPE NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF JSON-DECODE NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF JSON-FIND-MEMBER NOT = 3 ADD 1 TO WS-FAILURES END-IF
           IF JSON-NEXT-ELEMENT NOT = 4 ADD 1 TO WS-FAILURES END-IF
           IF JSON-SKIP-VALUE NOT = 5 ADD 1 TO WS-FAILURES END-IF
           IF HTTP-PREFLIGHT NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF HTTP-POST NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF NET-OPEN NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF NET-WRITE NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF NET-READ NOT = 3 ADD 1 TO WS-FAILURES END-IF
           IF NET-CLOSE NOT = 4 ADD 1 TO WS-FAILURES END-IF
           IF NET-PLAINTEXT NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF NET-TLS NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF RESP-START NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF RESP-CONTINUE NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF RESP-DESTROY NOT = 3 ADD 1 TO WS-FAILURES END-IF
           IF ACTION-NONE NOT = 0 ADD 1 TO WS-FAILURES END-IF
           IF ACTION-SHELL NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF ACTION-FINAL NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-NONE NOT = 0 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-INTERNAL NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-USAGE NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-CONFIG NOT = 3 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-PROTOCOL NOT = 4 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-NETWORK NOT = 5 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-SHELL NOT = 6 ADD 1 TO WS-FAILURES END-IF
           IF CATEGORY-CAPACITY NOT = 7 ADD 1 TO WS-FAILURES END-IF
           IF SHELL-EXIT NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF SHELL-SIGNAL NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF SHELL-COMMAND-ENCODING NOT = 3
               ADD 1 TO WS-FAILURES
           END-IF
           IF TEXT-NATIVE-STRICT NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF TEXT-UTF8-STRICT NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF TEXT-NATIVE-REPLACE NOT = 3 ADD 1 TO WS-FAILURES END-IF
           IF TEXT-UTF8-REPLACE NOT = 4 ADD 1 TO WS-FAILURES END-IF
           IF OUTPUT-STDOUT NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF OUTPUT-STDERR NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF LENGTH OF OUTPUT-STDOUT NOT = 4 OR
              LENGTH OF OUTPUT-STDERR NOT = 4
               ADD 1 TO WS-FAILURES
           END-IF
           IF EXIT-OK NOT = 0 ADD 1 TO WS-FAILURES END-IF
           IF EXIT-INTERNAL NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF EXIT-USAGE NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF EXIT-PROTOCOL NOT = 3 ADD 1 TO WS-FAILURES END-IF
           IF EXIT-NETWORK NOT = 4 ADD 1 TO WS-FAILURES END-IF
           IF EXIT-SHELL NOT = 5 ADD 1 TO WS-FAILURES END-IF
           IF EXIT-CAPACITY NOT = 6 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-OK NOT = 0 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-INTERNAL NOT = 1 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-USAGE-COUNT NOT = 2 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-USAGE-TEXT NOT = 3 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-CONFIG-KEY NOT = 4 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-CONFIG-MODEL NOT = 5 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-CONFIG-URL NOT = 6 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-CONFIG-ZOS-HTTPS NOT = 7
               ADD 1 TO WS-FAILURES
           END-IF
           IF STATUS-JSON NOT = 8 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-HTTP NOT = 9 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-RESPONSES NOT = 10 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-HTTP-CODE NOT = 11 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-NETWORK NOT = 12 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-SHELL NOT = 13 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-CAPACITY NOT = 14 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-TEXT-INVALID NOT = 15 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-OUTPUT NOT = 16 ADD 1 TO WS-FAILURES END-IF
           IF STATUS-TEXT-FATAL NOT = 17 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-TASK NOT = 65535 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-PORT NOT = 65535 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-URL NOT = 2048 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-MODEL NOT = 256 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-KEY NOT = 8192 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-HISTORY NOT = 16777216
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-REQUEST NOT = 16777216
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-RESPONSE NOT = 8388608
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-CALL-ID NOT = 8388608
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-COMMAND NOT = 65535 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-SHELL-OUTPUT NOT = 1048576
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-TOOL-RESULT NOT = 1048832
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-FINAL NOT = 1048576 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-FINAL-NATIVE NOT = 3145728
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-NET-CHUNK NOT = 65536
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-HTTP-HEADER NOT = 65536
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-REQUEST-HEADER NOT = 12288
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-DIAGNOSTIC NOT = 320
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-SHELL-PREFIX NOT = 10
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-SHELL-STAGING NOT = 65546
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-GNU-ARG-STAGING NOT = 131072
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-ENV-STAGING NOT = 8193
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-URL-TARGET NOT = 2059
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-NATIVE-HOST-CSTR NOT = 254
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-NATIVE-SERVICE-CSTR NOT = 6
               ADD 1 TO WS-FAILURES
           END-IF
           IF LIMIT-HOST NOT = 253 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-ZOS-SERVICE NOT = 5 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-ZOS-ARGV NOT = 65536 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-JSON-DEPTH NOT = 64 ADD 1 TO WS-FAILURES END-IF
           IF LIMIT-SERIAL-LITERAL NOT = 1024
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF LIMIT-PORT NOT = 4 OR
              LENGTH OF LIMIT-ZOS-ARGV NOT = 4
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF CT-TASK NOT = LIMIT-TASK OR
              LENGTH OF CT-URL NOT = LIMIT-URL OR
              LENGTH OF CT-MODEL NOT = LIMIT-MODEL OR
              LENGTH OF CT-KEY NOT = LIMIT-KEY OR
              LENGTH OF CT-HISTORY NOT = LIMIT-HISTORY OR
              LENGTH OF CT-REQUEST NOT = LIMIT-REQUEST OR
              LENGTH OF CT-RESPONSE NOT = LIMIT-RESPONSE OR
              LENGTH OF CT-CALL-ID NOT = LIMIT-CALL-ID
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF CT-COMMAND NOT = LIMIT-COMMAND OR
              LENGTH OF CT-SHELL-OUTPUT NOT = LIMIT-SHELL-OUTPUT OR
              LENGTH OF CT-TOOL-RESULT NOT = LIMIT-TOOL-RESULT OR
              LENGTH OF CT-FINAL NOT = LIMIT-FINAL OR
              LENGTH OF CT-FINAL-NATIVE NOT = LIMIT-FINAL-NATIVE OR
              LENGTH OF CT-NET-CHUNK NOT = LIMIT-NET-CHUNK OR
              LENGTH OF CT-HTTP-HEADER NOT = LIMIT-HTTP-HEADER
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF CT-REQUEST-HEADER
                  NOT = LIMIT-REQUEST-HEADER OR
              LENGTH OF CT-DIAGNOSTIC NOT = LIMIT-DIAGNOSTIC OR
              LENGTH OF CT-SHELL-PREFIX NOT = LIMIT-SHELL-PREFIX OR
              LENGTH OF CT-SHELL-STAGING NOT = LIMIT-SHELL-STAGING OR
              LENGTH OF CT-GNU-ARG-STAGING
                  NOT = LIMIT-GNU-ARG-STAGING OR
              LENGTH OF CT-ENV-STAGING NOT = LIMIT-ENV-STAGING OR
              LENGTH OF CT-URL-TARGET NOT = LIMIT-URL-TARGET
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF CT-NATIVE-HOST-CSTR
                  NOT = LIMIT-NATIVE-HOST-CSTR OR
              LENGTH OF CT-NATIVE-SVC-CSTR
                  NOT = LIMIT-NATIVE-SERVICE-CSTR OR
              LENGTH OF CT-HOST NOT = LIMIT-HOST OR
              LENGTH OF CT-ZOS-SERVICE NOT = LIMIT-ZOS-SERVICE OR
              LENGTH OF CT-SERIAL-LITERAL
                  NOT = LIMIT-SERIAL-LITERAL
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF CLI-STATUS NOT = 4 OR
              LENGTH OF CLI-PLATFORM NOT = 4 OR
              LENGTH OF CLI-ARG-COUNT NOT = 4 OR
              LENGTH OF CLI-TASK-LENGTH NOT = 4 OR
              LENGTH OF CLI-TASK NOT = LIMIT-TASK OR
              LENGTH OF CLI-EXIT-CODE NOT = 4
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF JP-OPERATION NOT = 4 OR
              LENGTH OF JP-STATUS NOT = 4 OR
              LENGTH OF JP-INPUT-LENGTH NOT = 4 OR
              LENGTH OF JP-CURSOR NOT = 4 OR
              LENGTH OF JP-NAME-LENGTH NOT = 4 OR
              LENGTH OF JP-OUTPUT-CAPACITY NOT = 4 OR
              LENGTH OF JP-OUTPUT-LENGTH NOT = 4 OR
              LENGTH OF JP-NEXT-CURSOR NOT = 4 OR
              LENGTH OF JP-SPAN-START NOT = 4 OR
              LENGTH OF JP-SPAN-LENGTH NOT = 4 OR
              LENGTH OF JP-DEPTH NOT = 4 OR
              LENGTH OF JP-FOUND NOT = 1 OR
              LENGTH OF JP-END NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF HP-OPERATION NOT = 4 OR
              LENGTH OF HP-STATUS NOT = 4 OR
              LENGTH OF HP-URL-LENGTH NOT = 4 OR
              LENGTH OF HP-KEY-LENGTH NOT = 4 OR
              LENGTH OF HP-BODY-LENGTH NOT = 4 OR
              LENGTH OF HP-RESPONSE-CAPACITY NOT = 4 OR
              LENGTH OF HP-RESPONSE-LENGTH NOT = 4 OR
              LENGTH OF HP-HTTP-STATUS NOT = 4 OR
              LENGTH OF HP-PLAINTEXT NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF NP-OPERATION NOT = 4 OR
              LENGTH OF NP-STATUS NOT = 4 OR
              LENGTH OF NP-SCHEME NOT = 4 OR
              LENGTH OF NP-CONNECT-HOST-LENGTH NOT = 4 OR
              LENGTH OF NP-VERIFY-HOST-LENGTH NOT = 4 OR
              LENGTH OF NP-PORT NOT = 4 OR
              LENGTH OF NP-BUFFER-CAPACITY NOT = 4 OR
              LENGTH OF NP-REQUEST-LENGTH NOT = 4 OR
              LENGTH OF NP-TRANSFERRED NOT = 4 OR
              LENGTH OF NP-EOF NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF RP-OPERATION NOT = 4 OR
              LENGTH OF RP-STATUS NOT = 4 OR
              LENGTH OF RP-MODEL-LENGTH NOT = 4 OR
              LENGTH OF RP-URL-LENGTH NOT = 4 OR
              LENGTH OF RP-KEY-LENGTH NOT = 4 OR
              LENGTH OF RP-TASK-LENGTH NOT = 4 OR
              LENGTH OF RP-SHELL-STATUS NOT = 4 OR
              LENGTH OF RP-SHELL-EXIT NOT = 4 OR
              LENGTH OF RP-SHELL-SIGNAL NOT = 4 OR
              LENGTH OF RP-SHELL-TRUNCATED NOT = 1 OR
              LENGTH OF RP-SHELL-ENCODING-LOSS NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF RP-SHELL-OUTPUT-LENGTH NOT = 4 OR
              LENGTH OF RP-ACTION NOT = 4 OR
              LENGTH OF RP-ACTION-CAPACITY NOT = 4 OR
              LENGTH OF RP-ACTION-LENGTH NOT = 4 OR
              LENGTH OF RP-ERROR-CATEGORY NOT = 4 OR
              LENGTH OF RP-HTTP-STATUS NOT = 4
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF SP-STATUS NOT = 4 OR
              LENGTH OF SP-COMMAND-LENGTH NOT = 4 OR
              LENGTH OF SP-OUTPUT-CAPACITY NOT = 4 OR
              LENGTH OF SP-OUTPUT-LENGTH NOT = 4 OR
              LENGTH OF SP-RESULT-KIND NOT = 4 OR
              LENGTH OF SP-EXIT-CODE NOT = 4 OR
              LENGTH OF SP-SIGNAL NOT = 4 OR
              LENGTH OF SP-TRUNCATED NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF TP-OPERATION NOT = 4 OR
              LENGTH OF TP-STATUS NOT = 4 OR
              LENGTH OF TP-INPUT-LENGTH NOT = 4 OR
              LENGTH OF TP-OUTPUT-CAPACITY NOT = 4 OR
              LENGTH OF TP-OUTPUT-LENGTH NOT = 4 OR
              LENGTH OF TP-REPLACED NOT = 1 OR
              LENGTH OF TP-TRUNCATED NOT = 1
               ADD 1 TO WS-FAILURES
           END-IF
           IF LENGTH OF OP-STATUS NOT = 4 OR
              LENGTH OF OP-FILE-DESCRIPTOR NOT = 4 OR
              LENGTH OF OP-BUFFER-LENGTH NOT = 4 OR
              LENGTH OF OP-WRITTEN NOT = 4
               ADD 1 TO WS-FAILURES
           END-IF
           MOVE STATUS-OK TO CLI-STATUS JP-STATUS HP-STATUS
               NP-STATUS RP-STATUS SP-STATUS TP-STATUS OP-STATUS
           IF WS-FAILURES = ZERO
               DISPLAY "PASS CONTRACTS"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL CONTRACTS"
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       END PROGRAM TSTCNTR.
