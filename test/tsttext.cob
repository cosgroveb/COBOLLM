       IDENTIFICATION DIVISION.
       PROGRAM-ID. TSTTEXT.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY LIMITS.
       COPY TXTPARM.
       01 WS-INPUT                PIC X(32).
       01 WS-OUTPUT               PIC X(96).
       01 WS-EXPECTED             PIC X(96).
       01 WS-VIEW                 PIC X(16777216).
       01 WS-INPUT-LENGTH         PIC S9(9) COMP-5.
       01 WS-CAPACITY             PIC S9(9) COMP-5.
       01 WS-EXPECTED-STATUS      PIC S9(9) COMP-5.
       01 WS-EXPECTED-LENGTH      PIC S9(9) COMP-5.
       01 WS-EXPECTED-REPLACED    PIC X.
       01 WS-EXPECTED-TRUNCATED   PIC X.
       01 WS-SAVED-INPUT-PTR      USAGE POINTER.
       01 WS-SAVED-OUTPUT-PTR     USAGE POINTER.
       01 WS-OP                   PIC S9(9) COMP-5.
       01 WS-FAILURES             PIC S9(9) COMP-5 VALUE ZERO.

       PROCEDURE DIVISION.
           PERFORM TEST-VALID-MATRIX
           PERFORM TEST-MALFORMED-MATRIX
           PERFORM TEST-REPLACEMENT-MATRIX
           PERFORM TEST-CAPACITIES
           PERFORM TEST-RESET-AND-POINTERS
           PERFORM TEST-VIEW-LIMITS
           IF WS-FAILURES = ZERO
               DISPLAY "PASS TEXT"
               MOVE ZERO TO RETURN-CODE
           ELSE
               DISPLAY "FAIL TEXT " WS-FAILURES
               MOVE 1 TO RETURN-CODE
           END-IF
           GOBACK.

       TEST-VALID-MATRIX.
           MOVE X"00417FC280E0A080F0908080F48FBFBF" TO WS-INPUT
           MOVE 16 TO WS-INPUT-LENGTH WS-CAPACITY
           MOVE WS-INPUT TO WS-EXPECTED
           MOVE STATUS-OK TO WS-EXPECTED-STATUS
           MOVE 16 TO WS-EXPECTED-LENGTH
           MOVE FLAG-OFF TO WS-EXPECTED-REPLACED
                            WS-EXPECTED-TRUNCATED
           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-REPLACE
               PERFORM RUN-EXPECTED
           END-PERFORM

           MOVE ZERO TO WS-INPUT-LENGTH WS-CAPACITY
                            WS-EXPECTED-LENGTH
           MOVE STATUS-OK TO WS-EXPECTED-STATUS
           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-REPLACE
               PERFORM RUN-EXPECTED
           END-PERFORM.

       TEST-MALFORMED-MATRIX.
           MOVE X"80" TO WS-INPUT
           MOVE 1 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"C0AF" TO WS-INPUT
           MOVE 2 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"C2" TO WS-INPUT
           MOVE 1 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"E282" TO WS-INPUT
           MOVE 2 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"F09080" TO WS-INPUT
           MOVE 3 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"E09F80" TO WS-INPUT
           MOVE 3 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"EDA080" TO WS-INPUT
           MOVE 3 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"F08F8080" TO WS-INPUT
           MOVE 4 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"F4908080" TO WS-INPUT
           MOVE 4 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"F5808080" TO WS-INPUT
           MOVE 4 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT
           MOVE X"E228A1" TO WS-INPUT
           MOVE 3 TO WS-INPUT-LENGTH
           PERFORM TEST-INVALID-STRICT.

       TEST-INVALID-STRICT.
           MOVE 96 TO WS-CAPACITY
           MOVE STATUS-TEXT-INVALID TO WS-EXPECTED-STATUS
           MOVE ZERO TO WS-EXPECTED-LENGTH
           MOVE FLAG-OFF TO WS-EXPECTED-REPLACED
                            WS-EXPECTED-TRUNCATED
           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-STRICT
               PERFORM RUN-EXPECTED
           END-PERFORM.

       TEST-REPLACEMENT-MATRIX.
           MOVE X"41C0AF42" TO WS-INPUT
           MOVE X"41EFBFBDEFBFBD42" TO WS-EXPECTED
           MOVE 4 TO WS-INPUT-LENGTH
           MOVE 96 TO WS-CAPACITY
           MOVE STATUS-OK TO WS-EXPECTED-STATUS
           MOVE 8 TO WS-EXPECTED-LENGTH
           MOVE FLAG-ON TO WS-EXPECTED-REPLACED
           MOVE FLAG-OFF TO WS-EXPECTED-TRUNCATED
           MOVE TEXT-NATIVE-REPLACE TO WS-OP
           PERFORM RUN-EXPECTED
           MOVE TEXT-UTF8-REPLACE TO WS-OP
           PERFORM RUN-EXPECTED

      * Each malformed byte is replaced independently before resuming.
           MOVE X"E228A1" TO WS-INPUT
           MOVE X"EFBFBD28EFBFBD" TO WS-EXPECTED
           MOVE 3 TO WS-INPUT-LENGTH
           MOVE 7 TO WS-EXPECTED-LENGTH
           MOVE TEXT-NATIVE-REPLACE TO WS-OP
           PERFORM RUN-EXPECTED
           MOVE TEXT-UTF8-REPLACE TO WS-OP
           PERFORM RUN-EXPECTED.

       TEST-CAPACITIES.
      * A complete scalar is never split.
           MOVE X"41E282AC" TO WS-INPUT
           MOVE X"41" TO WS-EXPECTED
           MOVE 4 TO WS-INPUT-LENGTH
           MOVE 3 TO WS-CAPACITY
           MOVE STATUS-CAPACITY TO WS-EXPECTED-STATUS
           MOVE 1 TO WS-EXPECTED-LENGTH
           MOVE FLAG-OFF TO WS-EXPECTED-REPLACED
           MOVE FLAG-ON TO WS-EXPECTED-TRUNCATED
           MOVE TEXT-NATIVE-STRICT TO WS-OP
           PERFORM RUN-EXPECTED
           MOVE TEXT-UTF8-STRICT TO WS-OP
           PERFORM RUN-EXPECTED

           MOVE X"E282AC" TO WS-INPUT WS-EXPECTED
           MOVE 3 TO WS-INPUT-LENGTH WS-CAPACITY
                            WS-EXPECTED-LENGTH
           MOVE STATUS-OK TO WS-EXPECTED-STATUS
           MOVE FLAG-OFF TO WS-EXPECTED-TRUNCATED
           MOVE TEXT-NATIVE-STRICT TO WS-OP
           PERFORM RUN-EXPECTED
           MOVE TEXT-UTF8-STRICT TO WS-OP
           PERFORM RUN-EXPECTED

           MOVE X"80" TO WS-INPUT
           MOVE 1 TO WS-INPUT-LENGTH
           MOVE 2 TO WS-CAPACITY
           MOVE ZERO TO WS-EXPECTED-LENGTH
           MOVE STATUS-CAPACITY TO WS-EXPECTED-STATUS
           MOVE FLAG-OFF TO WS-EXPECTED-REPLACED
           MOVE FLAG-ON TO WS-EXPECTED-TRUNCATED
           MOVE TEXT-NATIVE-REPLACE TO WS-OP
           PERFORM RUN-EXPECTED
           MOVE TEXT-UTF8-REPLACE TO WS-OP
           PERFORM RUN-EXPECTED.

       TEST-RESET-AND-POINTERS.
           MOVE X"41" TO WS-INPUT WS-EXPECTED
           MOVE 1 TO WS-INPUT-LENGTH WS-CAPACITY WS-EXPECTED-LENGTH
           MOVE STATUS-OK TO WS-EXPECTED-STATUS
           MOVE FLAG-OFF TO WS-EXPECTED-REPLACED
                            WS-EXPECTED-TRUNCATED
           MOVE TEXT-NATIVE-STRICT TO WS-OP
           PERFORM RUN-EXPECTED

           INITIALIZE TEXT-PARM
           MOVE 999 TO TP-STATUS TP-OUTPUT-LENGTH
           MOVE X"FF" TO TP-REPLACED TP-TRUNCATED
           MOVE 99 TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-INPUT
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-INTERNAL OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-OFF
               ADD 1 TO WS-FAILURES
           END-IF

           INITIALIZE TEXT-PARM
           MOVE TEXT-NATIVE-STRICT TO TP-OPERATION
           MOVE 1 TO TP-INPUT-LENGTH TP-OUTPUT-CAPACITY
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-INTERNAL
               ADD 1 TO WS-FAILURES
           END-IF

           INITIALIZE TEXT-PARM
           MOVE TEXT-NATIVE-STRICT TO TP-OPERATION
           MOVE -1 TO TP-INPUT-LENGTH
           SET TP-INPUT-PTR TO ADDRESS OF WS-INPUT
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-INTERNAL OR
              TP-OUTPUT-LENGTH NOT = ZERO
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-VIEW-LIMITS.
           MOVE X"80" TO WS-VIEW(1:1)
           COMPUTE WS-INPUT-LENGTH = LIMIT-HISTORY - 1
           MOVE X"5A" TO WS-VIEW(WS-INPUT-LENGTH:1)
           MOVE X"5A" TO WS-VIEW(LIMIT-HISTORY:1)
           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-STRICT
               PERFORM TEST-TEXT-INPUT-BOUNDARY
               MOVE LIMIT-HISTORY TO WS-INPUT-LENGTH
               PERFORM TEST-TEXT-INPUT-BOUNDARY
               COMPUTE WS-INPUT-LENGTH = LIMIT-HISTORY - 1
           END-PERFORM

           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-REPLACE
               COMPUTE WS-INPUT-LENGTH = LIMIT-HISTORY + 1
               PERFORM TEST-TEXT-INPUT-OVER-LIMIT
           END-PERFORM

           MOVE X"80" TO WS-INPUT(1:1)
           MOVE ZERO TO WS-INPUT-LENGTH
           COMPUTE WS-CAPACITY = LIMIT-HISTORY - 1
           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-REPLACE
               PERFORM TEST-TEXT-OUTPUT-BOUNDARY
               MOVE LIMIT-HISTORY TO WS-CAPACITY
               PERFORM TEST-TEXT-OUTPUT-BOUNDARY
               COMPUTE WS-CAPACITY = LIMIT-HISTORY - 1
           END-PERFORM

           PERFORM VARYING WS-OP FROM TEXT-NATIVE-STRICT BY 1
               UNTIL WS-OP > TEXT-UTF8-REPLACE
               COMPUTE WS-CAPACITY = LIMIT-HISTORY + 1
               PERFORM TEST-TEXT-OUTPUT-OVER-LIMIT
           END-PERFORM.

       TEST-TEXT-INPUT-BOUNDARY.
           INITIALIZE TEXT-PARM
           MOVE WS-OP TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-VIEW
           MOVE WS-INPUT-LENGTH TO TP-INPUT-LENGTH
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           MOVE 96 TO TP-OUTPUT-CAPACITY
           MOVE 999 TO TP-STATUS TP-OUTPUT-LENGTH
           MOVE X"FF" TO TP-REPLACED TP-TRUNCATED
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-TEXT-INVALID OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-OFF OR
              TP-INPUT-LENGTH NOT = WS-INPUT-LENGTH OR
              TP-OUTPUT-CAPACITY NOT = 96 OR
              WS-VIEW(1:1) NOT = X"80" OR
              WS-VIEW(WS-INPUT-LENGTH:1) NOT = X"5A"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-TEXT-INPUT-OVER-LIMIT.
           INITIALIZE TEXT-PARM
           MOVE WS-OP TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-VIEW
           MOVE WS-INPUT-LENGTH TO TP-INPUT-LENGTH
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           MOVE 96 TO TP-OUTPUT-CAPACITY
           MOVE 999 TO TP-STATUS TP-OUTPUT-LENGTH
           MOVE X"FF" TO TP-REPLACED TP-TRUNCATED
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-INTERNAL OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-OFF OR
              TP-INPUT-LENGTH NOT = WS-INPUT-LENGTH OR
              WS-VIEW(1:1) NOT = X"80" OR
              WS-VIEW(LIMIT-HISTORY:1) NOT = X"5A"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-TEXT-OUTPUT-BOUNDARY.
           INITIALIZE TEXT-PARM
           MOVE WS-OP TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-INPUT
           MOVE ZERO TO TP-INPUT-LENGTH
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-VIEW
           MOVE WS-CAPACITY TO TP-OUTPUT-CAPACITY
           MOVE 999 TO TP-STATUS TP-OUTPUT-LENGTH
           MOVE X"FF" TO TP-REPLACED TP-TRUNCATED
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-OK OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-OFF OR
              TP-OUTPUT-CAPACITY NOT = WS-CAPACITY OR
              WS-INPUT(1:1) NOT = X"80" OR
              WS-VIEW(1:1) NOT = X"80" OR
              WS-VIEW(LIMIT-HISTORY:1) NOT = X"5A"
               ADD 1 TO WS-FAILURES
           END-IF.

       TEST-TEXT-OUTPUT-OVER-LIMIT.
           INITIALIZE TEXT-PARM
           MOVE WS-OP TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-INPUT
           MOVE ZERO TO TP-INPUT-LENGTH
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-VIEW
           MOVE WS-CAPACITY TO TP-OUTPUT-CAPACITY
           MOVE 999 TO TP-STATUS TP-OUTPUT-LENGTH
           MOVE X"FF" TO TP-REPLACED TP-TRUNCATED
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = STATUS-INTERNAL OR
              TP-OUTPUT-LENGTH NOT = ZERO OR
              TP-REPLACED NOT = FLAG-OFF OR
              TP-TRUNCATED NOT = FLAG-OFF OR
              TP-OUTPUT-CAPACITY NOT = WS-CAPACITY OR
              WS-INPUT(1:1) NOT = X"80" OR
              WS-VIEW(1:1) NOT = X"80" OR
              WS-VIEW(LIMIT-HISTORY:1) NOT = X"5A"
               ADD 1 TO WS-FAILURES
           END-IF.

       RUN-EXPECTED.
           MOVE LOW-VALUES TO WS-OUTPUT
           INITIALIZE TEXT-PARM
           MOVE WS-OP TO TP-OPERATION
           SET TP-INPUT-PTR TO ADDRESS OF WS-INPUT
           SET WS-SAVED-INPUT-PTR TO TP-INPUT-PTR
           MOVE WS-INPUT-LENGTH TO TP-INPUT-LENGTH
           SET TP-OUTPUT-PTR TO ADDRESS OF WS-OUTPUT
           SET WS-SAVED-OUTPUT-PTR TO TP-OUTPUT-PTR
           MOVE WS-CAPACITY TO TP-OUTPUT-CAPACITY
           CALL "NATUTF8" USING TEXT-PARM
           IF TP-STATUS NOT = WS-EXPECTED-STATUS OR
              TP-OUTPUT-LENGTH NOT = WS-EXPECTED-LENGTH OR
              TP-REPLACED NOT = WS-EXPECTED-REPLACED OR
              TP-TRUNCATED NOT = WS-EXPECTED-TRUNCATED OR
              TP-INPUT-PTR NOT = WS-SAVED-INPUT-PTR OR
              TP-OUTPUT-PTR NOT = WS-SAVED-OUTPUT-PTR OR
              TP-INPUT-LENGTH NOT = WS-INPUT-LENGTH OR
              TP-OUTPUT-CAPACITY NOT = WS-CAPACITY
               ADD 1 TO WS-FAILURES
           ELSE
               IF WS-EXPECTED-LENGTH > ZERO AND
                  WS-OUTPUT(1:WS-EXPECTED-LENGTH) NOT =
                      WS-EXPECTED(1:WS-EXPECTED-LENGTH)
                   ADD 1 TO WS-FAILURES
               END-IF
           END-IF.

       END PROGRAM TSTTEXT.
